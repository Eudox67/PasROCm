{
  "schema": 1,
  "notes": [
    "Single source of truth for GPU targets: hardware wavefront width and the",
    "earliest SDK line that ships the target. Consumed by ci/manifest.sh and CMake,",
    "src/rocprim/build.sh, src/rocprim/CMakeLists.txt and the CI workflow.",
    "There must never be a second copy of this mapping (DESIGN.md section 12.4).",
    "'wavefront' is what the build injects as PASROCM_WAVEFRONT_SIZE;",
    "'widths' lists the widths the hardware can actually run, which is how",
    "RDNA4 differs from everything else (gfx1250 rejects wave64 outright).",
    "gfx950 needs 7.2: rocPRIM 3.4.1 (6.4) has no 128-bit atomics for CDNA4,",
    "measured 2026-11-14 in the full matrix (7.2 and 10.1 build it fine)."
  ],

  "targets": {
    "gfx908":  { "family": "cdna1",   "wavefront": 64, "widths": [64],     "min_rocm": "6.4" },
    "gfx90a":  { "family": "cdna2",   "wavefront": 64, "widths": [64],     "min_rocm": "6.4" },
    "gfx942":  { "family": "cdna3",   "wavefront": 64, "widths": [64],     "min_rocm": "6.4" },
    "gfx950":  { "family": "cdna4",   "wavefront": 64, "widths": [64],     "min_rocm": "7.2" },

    "gfx1030": { "family": "rdna2",   "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1100": { "family": "rdna3",   "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1101": { "family": "rdna3",   "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1102": { "family": "rdna3",   "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1103": { "family": "rdna3",   "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1150": { "family": "rdna35",  "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1151": { "family": "rdna35",  "wavefront": 32, "widths": [32],     "min_rocm": "6.4" },
    "gfx1200": { "family": "rdna4",   "wavefront": 32, "widths": [32, 64], "min_rocm": "6.4" },
    "gfx1201": { "family": "rdna4",   "wavefront": 32, "widths": [32, 64], "min_rocm": "6.4" },

    "gfx1010": { "family": "rdna1",   "wavefront": 32, "widths": [32],     "min_rocm": "10.1" },
    "gfx1011": { "family": "rdna1",   "wavefront": 32, "widths": [32],     "min_rocm": "10.1" },
    "gfx1012": { "family": "rdna1",   "wavefront": 32, "widths": [32],     "min_rocm": "10.1" },
    "gfx1152": { "family": "rdna35x", "wavefront": 32, "widths": [32],     "min_rocm": "10.1" },
    "gfx1153": { "family": "rdna35x", "wavefront": 32, "widths": [32],     "min_rocm": "10.1" },
    "gfx1250": { "family": "rdna4x",  "wavefront": 32, "widths": [32],     "min_rocm": "10.1" }
  }
}

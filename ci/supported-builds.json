{
  "schema": 2,
  "notes": [
    "Single source of truth for the shim build matrix. Workflows read this file;",
    "no configuration is hard-coded in YAML. See DESIGN.md sections 5, 7 and 12.",
    "'sdk' selects the pinned SDK a job installs; 'covers' is the patch range the",
    "artifact may claim; 'covers_evidence' records why that claim holds.",
    "One build produces exactly one gfx target: libpasrocm_shim_<gfx>.so.",
    "Target lists are derived from ci/gfx-targets.json ('auto') and filtered by",
    "each target's min_rocm, so a target can never be requested below the SDK",
    "line that ships it.",
    "A new SDK release is a reviewed change to this file, never an automatic bump."
  ],

  "shim": {
    "name": "pasrocm_shim",
    "library": "libpasrocm_shim_{gfx}.so",
    "version": "0.1.0",
    "abi_version": 1
  },

  "sdks": {
    "6.4.4": {
      "line": "6.4",
      "version": "6.4.4",
      "compiler": "hipcc",
      "pin": {
        "kind": "radeon-apt",
        "repo": "https://repo.radeon.com/rocm/apt/6.4.4",
        "key": "https://repo.radeon.com/rocm/rocm.gpg.key",
        "packages": ["rocm-core", "hipcc", "hip-dev", "rocprim-dev", "rocm-device-libs"]
      }
    },
    "6.4.0": {
      "line": "6.4",
      "version": "6.4.0",
      "compiler": "hipcc",
      "pin": {
        "kind": "radeon-apt",
        "repo": "https://repo.radeon.com/rocm/apt/6.4",
        "key": "https://repo.radeon.com/rocm/rocm.gpg.key",
        "packages": ["rocm-core", "hipcc", "hip-dev", "rocprim-dev", "rocm-device-libs"]
      }
    },
    "7.2.4": {
      "line": "7.2",
      "version": "7.2.4",
      "compiler": "hipcc",
      "pin": {
        "kind": "radeon-apt",
        "repo": "https://repo.radeon.com/rocm/apt/7.2.4",
        "key": "https://repo.radeon.com/rocm/rocm.gpg.key",
        "packages": ["rocm-core", "hipcc", "hip-dev", "rocprim-dev", "rocm-device-libs"]
      }
    },
    "10.1.0": {
      "line": "10.1",
      "version": "10.1.0",
      "compiler": "clang",
      "pin": {
        "kind": "amdrocm-stable",
        "repo": "https://stable.repo.amd.com/rocm/core/packages/{ubuntu}",
        "key": "https://stable.repo.amd.com/rocm/gpg/packages.gpg",
        "packages": [
          "amdrocm-base10.1",
          "amdrocm-runtime10.1",
          "amdrocm-runtime-dev10.1",
          "amdrocm-llvm10.1",
          "amdrocm-ccl-dev10.1"
        ],
        "exact_versions": {
          "amdrocm-base10.1": "10.1.0-3",
          "amdrocm-runtime10.1": "10.1.0-3",
          "amdrocm-runtime-dev10.1": "10.1.0-3",
          "amdrocm-llvm10.1": "10.1.0-3",
          "amdrocm-ccl-dev10.1": "10.1.0-3"
        }
      }
    }
  },

  "profiles": {
    "pr": {
      "configs": ["ubuntu-24.04-rocm10.1"],
      "targets": ["gfx1100", "gfx942"]
    },
    "smoke": {
      "all_configs": true,
      "targets": ["gfx1100", "gfx942"]
    },
    "full": {
      "all_configs": true,
      "all_targets": true
    },
    "release": {
      "all_configs": true,
      "all_targets": true
    }
  },

  "configurations": [

    {
      "id": "ubuntu-22.04-rocm6.4",
      "mode": "build",
      "os": "ubuntu-22.04",
      "ubuntu": "ubuntu2204",
      "codename": "jammy",
      "sdk": "6.4.4",
      "targets": "auto",
      "full_targets": "all",
      "covers": "6.4.0-6.4.4",
      "covers_evidence": "compiled at 6.4.4 (rocprim-dev 3.4.1) and at 6.4.0 via the *-probe configs (rocprim-dev 3.4.0); intermediate patches are not compiled"

procedure TTestRocSolver_OrthogonalApp.Test_rocsolver_sormtr;
const
  m = 5; // rows of C, and dimension of square matrix A
  n = 4; // cols of C
  lda = m;
  ldc = m;
var
  h_A: PSingle;
  h_C: PSingle;
  h_tau, h_D, h_E: PSingle;
  d_A, d_C, d_tau, d_D, d_E: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j: Integer;
begin
  // Allocate host memory
  h_A := AllocMem(lda * m * SizeOf(Single));
  h_C := AllocMem(ldc * n * SizeOf(Single));
  h_tau := AllocMem((m - 1) * SizeOf(Single));
  h_D := AllocMem(m * SizeOf(Single));
  h_E := AllocMem((m - 1) * SizeOf(Single));

  // Initialize host data. A must be symmetric.
  for i := 0 to m - 1 do
  begin
    for j := i to m - 1 do
    begin
      h_A[i + j * lda] := i + j + 2;
      h_A[j + i * lda] := i + j + 2; // Enforce symmetry
    end;
  end;
  for i := 0 to (ldc * n) - 1 do
    h_C[i] := i + 1.0;

  // Allocate device memory
  hipStatus := hipMalloc(d_A, lda * m * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_A failed');
  hipStatus := hipMalloc(d_C, ldc * n * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_C failed');
  hipStatus := hipMalloc(d_tau, (m - 1) * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_tau failed');
  hipStatus := hipMalloc(d_D, m * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_D failed');
  hipStatus := hipMalloc(d_E, (m - 1) * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_E failed');

  // Copy data to device
  hipStatus := hipMemcpy(d_A, h_A, lda * m * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy to d_A failed');
  hipStatus := hipMemcpy(d_C, h_C, ldc * n * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy to d_C failed');

  // Prerequisite: Reduce symmetric matrix A to tridiagonal form
  AStatus := rocsolver_ssytrd(FHandle, rocblas_fill_upper, m, d_A, lda, d_D, d_E, d_tau);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_ssytrd failed as prerequisite');

  // Apply the orthogonal matrix Q
  AStatus := rocsolver_sormtr(FHandle, rocblas_side_left, rocblas_fill_upper, rocblas_operation_none,
                              m, n, d_A, lda, d_tau, d_C, ldc);

  N = RO_EIG_N;
begin
  case AKind of
    rkSingle:
      if AOp = rsxSyevx then
        Result := rocsolver_ssyevx(FHandle, AEvect, AErange, AUplo, N, A, N,
          Single(AVl), Single(AVu), AIl, AIu, 0.0, ANev, AW, AZ, ALdz, AIfail, AInfo)

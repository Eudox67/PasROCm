      normX := normX + Sqr(h_X[b * b_size + i].x) + Sqr(h_X[b * b_size + i].y);
    normX := Sqrt(normX);

    residual := 0;
    for i := 0 to N - 1 do
    begin
      for j := 0 to NRHS - 1 do
      begin
        temp.x := 0; temp.y := 0;
        for k := 0 to N - 1 do
        begin
          temp.x := temp.x + (h_A_orig[b*matrix_size + i + k*LDA].x * h_X[b*b_size + k + j*LDB].x - h_A_orig[b*matrix_size + i + k*LDA].y * h_X[b*b_size + k + j*LDB].y);
          temp.y := temp.y + (h_A_orig[b*matrix_size + i + k*LDA].x * h_X[b*b_size + k + j*LDB].y + h_A_orig[b*matrix_size + i + k*LDA].y * h_X[b*b_size + k + j*LDB].x);
        end;
        residual := residual + Sqr(temp.x - h_B[b*b_size + i + j*LDB].x) + Sqr(temp.y - h_B[b*b_size + i + j*LDB].y);
      end;
    end;
    residual := Sqrt(residual);

    if ((normA > 0) and (normX > 0)) then
      error := residual / (normA * normX)
    else
      error := residual;
    CheckEquals(0.0, error, 1e-12, 'Solution residual is too high for batch item ' + IntToStr(b));
  end;

  // 8. Clean up
  for b := 0 to BATCH_COUNT - 1 do
  begin
    hipFree(h_d_A_array[b]);
    hipFree(h_d_B_array[b]);
  end;
  hipFree(d_A_array);
  hipFree(d_B_array);
  hipFree(d_info);
end;

procedure TTestRocSolver_Solvers.Test_rocsolver_spotrs_strided_batched;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
  BATCH_COUNT = 2;
var
  h_A_orig, h_A, h_B, h_X: array of Single;
  h_info: array of rocblas_int;
  d_A, d_B, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  uplo: rocblas_fill;
  i, j, k, b: Integer;
  strideA, strideB: rocblas_stride;
  matrix_size, b_size: Integer;
  residual, normA, normX, error: Double;
  temp: Single;
begin
  uplo := rocblas_fill_upper;
  matrix_size := LDA * N;
  b_size := LDB * NRHS;
  strideA := matrix_size;
  strideB := b_size;

  // 1. Initialize host matrices
  SetLength(h_A, BATCH_COUNT * strideA);
  SetLength(h_A_orig, BATCH_COUNT * strideA);
  SetLength(h_B, BATCH_COUNT * strideB);
  SetLength(h_X, BATCH_COUNT * strideB);
  SetLength(h_info, BATCH_COUNT);

  // 2. Populate host data
  for b := 0 to BATCH_COUNT - 1 do
  begin
    // Symmetric Positive Definite Matrix A
    h_A[b*strideA + 0] := 4;  h_A[b*strideA + 1] := 2;  h_A[b*strideA + 2] := 2;
    h_A[b*strideA + 3] := 2;  h_A[b*strideA + 4] := 10; h_A[b*strideA + 5] := 7;
    h_A[b*strideA + 6] := 2;  h_A[b*strideA + 7] := 7;  h_A[b*strideA + 8] := 21;

    // B = [18], [45], [97] (adjusted for batch index)
    h_B[b*strideB + 0] := 18 + b;
    h_B[b*strideB + 1] := 45 + b;
    h_B[b*strideB + 2] := 97 + b;
  end;
  Move(h_A[0], h_A_orig[0], BATCH_COUNT * strideA * SizeOf(Single));

  // 3. Allocate device memory
  hipStatus := hipMalloc(d_A, BATCH_COUNT * strideA * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_B, BATCH_COUNT * strideB * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_B failed');
  hipStatus := hipMalloc(d_info, BATCH_COUNT * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 4. Copy inputs to device
  hipStatus := hipMemcpy(d_A, Pointer(h_A), BATCH_COUNT * strideA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');
  hipStatus := hipMemcpy(d_B, Pointer(h_B), BATCH_COUNT * strideB * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_B to d_B failed');

  // 5. Perform Cholesky factorization
  AStatus := rocsolver_spotrf_strided_batched(FHandle, uplo, N, d_A, LDA, strideA, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrf_strided_batched failed');
  hipStatus := hipMemcpy(Pointer(h_info), d_info, BATCH_COUNT * SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus);
  for b := 0 to BATCH_COUNT - 1 do
    CheckEquals(0, h_info[b], 'spotrf_strided_batched factorization failed for batch item ' + IntToStr(b));

  // 6. Call the solver
  AStatus := rocsolver_spotrs_strided_batched(FHandle, uplo, N, NRHS, d_A, LDA, strideA, d_B, LDB, strideB, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrs_strided_batched failed');

  // 7. Copy result back and verify
  hipStatus := hipMemcpy(Pointer(h_X), d_B, BATCH_COUNT * strideB * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_B to h_X failed');

  for b := 0 to BATCH_COUNT - 1 do
  begin
    normA := 0;
    for i := 0 to matrix_size - 1 do
      normA := normA + Sqr(h_A_orig[b * strideA + i]);
    normA := Sqrt(normA);

    normX := 0;
    for i := 0 to b_size - 1 do
      normX := normX + Sqr(h_X[b * strideB + i]);
    normX := Sqrt(normX);

    residual := 0;
    for i := 0 to N - 1 do
    begin
      for j := 0 to NRHS - 1 do
      begin
        temp := 0;
        for k := 0 to N - 1 do
          temp := temp + h_A_orig[b * strideA + i + k * LDA] * h_X[b * strideB + k + j * LDB];
        residual := residual + Sqr(temp - h_B[b * strideB + i + j * LDB]);
      end;
    end;
    residual := Sqrt(residual);

    if ((normA > 0) and (normX > 0)) then
      error := residual / (normA * normX)
    else
      error := residual;
    CheckEquals(0.0, error, 1e-6, 'Solution residual is too high for batch item ' + IntToStr(b));
  end;

  // 8. Clean up
  hipStatus := hipFree(d_A); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_B); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);
end;


procedure TTestRocSolver_Factorizations.Test_rocsolver_spotrf;
const
  n = 10;
  lda = n;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A, h_A_res, h_B: array of Single;
  h_info: rocblas_int;
  d_A, d_info: hipDeviceptr_t;
  sizeA, sizeInfo: size_t;
  i, j, l: Integer;
begin
  // 1. Setup
  sizeA := n * n * SizeOf(Single);
  sizeInfo := SizeOf(rocblas_int);

  SetLength(h_A, n * n);
  SetLength(h_A_res, n * n);
  SetLength(h_B, n * n);
  h_info := -1;

  // Create a well-conditioned matrix B
  for j := 0 to n - 1 do
    for i := 0 to n - 1 do
      if i = j then h_B[i + j * lda] := 2.0 else h_B[i + j * lda] := 0.5;

  // Compute A = B' * B to create a symmetric positive-definite matrix
  for j := 0 to n - 1 do
    for i := 0 to n - 1 do
    begin
      h_A[i + j * lda] := 0;
      for l := 0 to n - 1 do
        h_A[i + j * lda] := h_A[i + j * lda] + h_B[l + i * lda] * h_B[l + j * lda];
    end;

  d_A := nil;
  d_info := nil;
  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_info, sizeInfo);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_info');

  try
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A');

    AStatus := rocsolver_spotrf(FHandle, rocblas_fill_upper, n, d_A, lda, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrf');

    AhipStatus := hipMemcpy(@h_info, d_info, sizeInfo, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H info');
    AhipStatus := hipMemcpy(@h_A_res[0], d_A, sizeA, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H A_res');

    CheckEquals(0, h_info, 'info should be 0 for a successful factorization');
    // Check that the diagonal is positive, a property of the Cholesky factor
    Check(h_A_res[0] > 0, 'The first element of the Cholesky factor should be positive');

  finally
    if d_A <> nil then hipFree(d_A);
    if d_info <> nil then hipFree(d_info);
  end;
end;


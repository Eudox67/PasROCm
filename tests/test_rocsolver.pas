  { TTestRocSolver_EigenSVD }
  { Tests for eigenvalue, singular value, and generalized eigenvalue problems. }
  TTestRocSolver_EigenSVD = class(TRocSolverTest)
  private
    { Shared implementations for the eigensolver tests. They skip the call
      entirely when the library reports the routine is unavailable. }
    procedure RunTriEigen(AKind: TRoCElemKind; AOp: TRoCTriOp);
    procedure RunStebz(AKind: TRoCElemKind);
    procedure RunStein(AKind: TRoCElemKind);
    procedure RunSyev(AKind: TRoCElemKind; AOp: TRoCSyevOp);
    procedure RunSyevBatched(AKind: TRoCElemKind; AOp: TRoCSyevOp;
      AStridedBatch: Boolean);
    function CallSyev(AKind: TRoCElemKind; AOp: TRoCSyevOp;
      AEvect: rocblas_evect; AUplo: rocblas_fill;
      A, D, E, AInfo: Pointer): rocsolver_status;

procedure TTestRocSolver_Auxiliary.Test_rocsolver_slarfb;
const
  M = 5; N = 4; K = 3; LDV = M; LDT = K; LDA = M;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_V, h_C, h_C_result: array of Single;
  h_T: array of Single; h_tau: array of Single;
  d_V, d_T, d_C, d_tau: Pointer;
  ASizeV, ASizeT, ASizeC, ASizeTau: size_t;
  i, j: Integer;
begin
  // (Sections 1 & 2 are unchanged)
  ASizeV := LDV * K * SizeOf(Single); ASizeT := LDT * K * SizeOf(Single);
  ASizeC := LDA * N * SizeOf(Single); ASizeTau := K * SizeOf(Single);
  SetLength(h_V, LDV * K); SetLength(h_C, LDA * N); SetLength(h_C_result, LDA * N);
  SetLength(h_T, LDT * K); SetLength(h_tau, K);
  for j := 0 to K-1 do for i := 0 to M-1 do h_V[i+j*LDV] := 1.0 + i + j*M;
  for j := 0 to N-1 do for i := 0 to M-1 do h_C[i+j*LDA] := 10.0 + i + j*M;
  d_V := nil; d_T := nil; d_C := nil; d_tau := nil;
  hipMalloc(d_V, ASizeV); hipMalloc(d_T, ASizeT); hipMalloc(d_C, ASizeC); hipMalloc(d_tau, ASizeTau);

  // 3. Generate valid V, tau, and T - with RETRY LOGIC
  hipMemcpy(d_V, @h_V[0], ASizeV, hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_sgeqrf(FHandle, M, K, d_V, LDV, d_tau);
  if AStatusSolver = rocblas_status_size_increased then
    AStatusSolver := rocsolver_sgeqrf(FHandle, M, K, d_V, LDV, d_tau); // Call again
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite sgeqrf failed');

  AStatusSolver := rocsolver_slarft(FHandle, rocblas_forward_direction, rocblas_storev_column_wise, M, K, d_V, LDV, d_tau, d_T, LDT);
  if AStatusSolver = rocblas_status_size_increased then
    AStatusSolver := rocsolver_slarft(FHandle, rocblas_forward_direction, rocblas_storev_column_wise, M, K, d_V, LDV, d_tau, d_T, LDT);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite slarft failed');

  // (The rest of the test is unchanged)
  hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_slarfb(FHandle, rocblas_side_left, rocblas_operation_none, rocblas_forward_direction, rocblas_storev_column_wise, M, N, K, d_V, LDV, d_T, LDT, d_C, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_slarfb failed');
  hipMemcpy(@h_C_result[0], d_C, ASizeC, hipMemcpyDeviceToHost);
  if AStatusSolver = rocblas_status_success then
  begin
    for i := 0 to LDA * N - 1 do
      CheckFalse(IsNan(h_C_result[i]), 'Result should not be NaN at index ' + IntToStr(i));
  end;
  if Assigned(d_V) then hipFree(d_V); if Assigned(d_T) then hipFree(d_T);
  if Assigned(d_C) then hipFree(d_C); if Assigned(d_tau) then hipFree(d_tau);
end;


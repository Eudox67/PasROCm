  h_B[0].x := 1; h_B[0].y := 1;
  h_B[1].x := 2; h_B[1].y := 2;
  h_B[2].x := 3; h_B[2].y := 3;

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, LDA * N * SizeOf(rocblas_float_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');

  CheckEquals(HIP_SUCCESS, hipStatus, 'hipDeviceSynchronize failed after zunmbr');

  // Cleanup
  hipFree(d_A);
  hipFree(d_C);
  hipFree(d_tauq);
  hipFree(d_taup);
  hipFree(d_D);
  hipFree(d_E);
  FreeMem(h_A);
  FreeMem(h_C);
  FreeMem(h_tauq);
  FreeMem(h_taup);
  FreeMem(h_D);
  FreeMem(h_E);
end;


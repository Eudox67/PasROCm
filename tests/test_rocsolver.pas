procedure TTestRocSolver_SparseRefactor.Test_rocsolver_create_rfinfo;
var
  AStatus: rocsolver_status;
  ARfInfo: rocsolver_rfinfo;
begin
  ARfInfo := nil;
  AStatus := rocsolver_create_rfinfo(ARfInfo, FHandle);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_create_rfinfo failed');
  CheckTrue(Assigned(ARfInfo), 'rfinfo handle should not be nil after creation'); // Corrected check

  // Cleanup is essential even in a simple creation test
  if Assigned(ARfInfo) then
  begin
    AStatus := rocsolver_destroy_rfinfo(ARfInfo);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_destroy_rfinfo failed during cleanup');
  end;
end;

procedure TTestRocSolver_SparseRefactor.Test_rocsolver_destroy_rfinfo;
var
  AStatus: rocsolver_status;
  ARfInfo: rocsolver_rfinfo;
begin
  // First, create a handle to destroy
  ARfInfo := nil;
  AStatus := rocsolver_create_rfinfo(ARfInfo, FHandle);
  if AStatus <> rocblas_status_success then
    Fail('Prerequisite rocsolver_create_rfinfo failed, cannot test destroy');

  // Now, test the destruction
  AStatus := rocsolver_destroy_rfinfo(ARfInfo);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_destroy_rfinfo failed');
end;

procedure TTestRocSolver_SparseRefactor.Test_rocsolver_set_rfinfo_mode;
var
  AStatus: rocsolver_status;
  ARfInfo: rocsolver_rfinfo;
begin
  ARfInfo := nil;
  AStatus := rocsolver_create_rfinfo(ARfInfo, FHandle);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_create_rfinfo failed');

  try
    // Values outside rocsolver_rfinfo_mode_* must be rejected. The old Pascal
    // constants (0 and 1) were exactly such alien values.
    AStatus := rocsolver_set_rfinfo_mode(ARfInfo, 0);
    CheckEquals(rocblas_status_invalid_value, AStatus,
      'rocsolver_set_rfinfo_mode must reject a value outside rocsolver_rfinfo_mode_*');

    AStatus := rocsolver_set_rfinfo_mode(ARfInfo, rocsolver_rfinfo_mode_chol);
    CheckEquals(rocblas_status_success, AStatus,
      'rocsolver_set_rfinfo_mode(rfinfo_mode_chol) failed');

    AStatus := rocsolver_set_rfinfo_mode(ARfInfo, rocsolver_rfinfo_mode_lu);
    CheckEquals(rocblas_status_success, AStatus,
      'rocsolver_set_rfinfo_mode(rfinfo_mode_lu) failed');
  finally
    rocsolver_destroy_rfinfo(ARfInfo);
  end;
end;

procedure TTestRocSolver_SparseRefactor.Test_rocsolver_get_rfinfo_mode;
var
  AStatus: rocsolver_status;
  ARfInfo: rocsolver_rfinfo;
  AMode: rocsolver_rfinfo_mode;
begin
  ARfInfo := nil;
  AMode := -1;
  AStatus := rocsolver_create_rfinfo(ARfInfo, FHandle);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_create_rfinfo failed');

  try
    // A freshly created rfinfo defaults to LU mode.
    AStatus := rocsolver_get_rfinfo_mode(ARfInfo, AMode);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_get_rfinfo_mode failed');
    CheckEquals(rocsolver_rfinfo_mode_lu, AMode,
      'a new rfinfo should default to rocsolver_rfinfo_mode_lu');

    AStatus := rocsolver_set_rfinfo_mode(ARfInfo, rocsolver_rfinfo_mode_chol);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_set_rfinfo_mode failed');

    AMode := -1;
    AStatus := rocsolver_get_rfinfo_mode(ARfInfo, AMode);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_get_rfinfo_mode failed');
    CheckEquals(rocsolver_rfinfo_mode_chol, AMode,
      'rocsolver_get_rfinfo_mode did not report the mode set by set_rfinfo_mode');
  finally
    rocsolver_destroy_rfinfo(ARfInfo);
  end;
end;

procedure TTestRocSolver_SparseRefactor.Test_rocsolver_scsrrf_sumlu;
const
  N = 3;
  NNZ_L = 4; // L matrix has 4 non-zero elements
  NNZ_U = 5; // U matrix has 5 non-zero elements
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  // Host CSR arrays for L
  h_ptrL: array[0..N] of rocblas_int = (0, 1, 2, 4);
  h_indL: array[0..NNZ_L-1] of rocblas_int = (0, 1, 0, 2);
  h_valL: array[0..NNZ_L-1] of Single = (1.0, 2.0, 3.0, 4.0);
  // Host CSR arrays for U
  h_ptrU: array[0..N] of rocblas_int = (0, 3, 4, 5);
  h_indU: array[0..NNZ_U-1] of rocblas_int = (0, 1, 2, 1, 2);
  h_valU: array[0..NNZ_U-1] of Single = (5.0, 6.0, 7.0, 8.0, 9.0);
  // Device pointers
  d_ptrL, d_indL, d_valL, d_ptrU, d_indU, d_valU, d_ptrT, d_indT, d_valT: Pointer;
  ASizePtrL, ASizeIndL, ASizeValL, ASizePtrU, ASizeIndU, ASizeValU, ASizePtrT, ASizeIndT, ASizeValT: size_t;
begin
  // 1. Initialize sizes
  d_ptrL := nil; d_indL := nil; d_valL := nil; d_ptrU := nil; d_indU := nil; d_valU := nil;
  d_ptrT := nil; d_indT := nil; d_valT := nil;

  ASizePtrL := (N + 1) * SizeOf(rocblas_int);
  ASizeIndL := NNZ_L * SizeOf(rocblas_int);
  ASizeValL := NNZ_L * SizeOf(Single);
  ASizePtrU := (N + 1) * SizeOf(rocblas_int);
  ASizeIndU := NNZ_U * SizeOf(rocblas_int);
  ASizeValU := NNZ_U * SizeOf(Single);
  // Output T will have NNZ_L + NNZ_U non-zero elements
  ASizePtrT := (N + 1) * SizeOf(rocblas_int);
  ASizeIndT := (NNZ_L + NNZ_U) * SizeOf(rocblas_int);
  ASizeValT := (NNZ_L + NNZ_U) * SizeOf(Single);

  try
    // 2. Allocate device memory
    AStatusHip := hipMalloc(d_ptrL, ASizePtrL); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_indL, ASizeIndL); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_valL, ASizeValL); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_ptrU, ASizePtrU); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_indU, ASizeIndU); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_valU, ASizeValU); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_ptrT, ASizePtrT); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_indT, ASizeIndT); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_valT, ASizeValT); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 3. Copy inputs to device
    AStatusHip := hipMemcpy(d_ptrL, @h_ptrL[0], ASizePtrL, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_indL, @h_indL[0], ASizeIndL, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_valL, @h_valL[0], ASizeValL, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_ptrU, @h_ptrU[0], ASizePtrU, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_indU, @h_indU[0], ASizeIndU, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_valU, @h_valU[0], ASizeValU, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 4. Call function
    AStatusSolver := rocsolver_scsrrf_sumlu(FHandle, N, NNZ_L, d_ptrL, d_indL, d_valL, NNZ_U, d_ptrU, d_indU, d_valU, d_ptrT, d_indT, d_valT);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_scsrrf_sumlu failed');

  finally
    // 5. Cleanup
    if Assigned(d_ptrL) then hipFree(d_ptrL); if Assigned(d_indL) then hipFree(d_indL); if Assigned(d_valL) then hipFree(d_valL);
    if Assigned(d_ptrU) then hipFree(d_ptrU); if Assigned(d_indU) then hipFree(d_indU); if Assigned(d_valU) then hipFree(d_valU);
    if Assigned(d_ptrT) then hipFree(d_ptrT); if Assigned(d_indT) then hipFree(d_indT); if Assigned(d_valT) then hipFree(d_valT);
  end;
end;


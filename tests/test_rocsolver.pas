  ASizeA := LDA * N * SizeOf(rocblas_float_complex);
  ASizeIpiv := N * SizeOf(rocblas_int);
  SetLength(h_A, LDA * N);
  for j := 0 to N - 1 do for i := 0 to N - 1 do
  begin
     h_A[i + j * LDA].x := 1.0 + Max(i, j);
     if i = j then h_A[i + j * LDA].y := 0
     else h_A[i + j * LDA].y := 1.0 + Min(i, j);
  end;

  // 2. Malloc device and pinned host memory
  d_A := nil; d_ipiv := nil; p_kb := nil; p_info := nil;
  hipMalloc(d_A, ASizeA);
  hipMalloc(d_ipiv, ASizeIpiv);
  hipHostMalloc(Pointer(p_kb), SizeOf(rocblas_int), 0);
  hipHostMalloc(Pointer(p_info), SizeOf(rocblas_int), 0);
  if (p_kb = nil) or (p_info = nil) then Fail('Pinned memory allocation failed');
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);

  // 3. Call
  AStatusSolver := rocsolver_clasyf(FHandle, rocblas_fill_upper, N, NB, p_kb^, d_A, LDA, d_ipiv, p_info^);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_clasyf failed');

  // 4. Verify
  if AStatusSolver = rocblas_status_success then
  begin
    CheckEquals(0, p_info^, 'Info should be 0');
    // REMOVED: CheckTrue(p_kb^ > 0, 'kb should be > 0');
    CheckTrue(p_kb^ <= NB, 'kb should be <= nb');
  end;

  // 5. Cleanup
  if Assigned(d_A) then hipFree(d_A);
  if Assigned(d_ipiv) then hipFree(d_ipiv);
  if Assigned(p_kb) then hipHostFree(p_kb);
  if Assigned(p_info) then hipHostFree(p_info);
end;


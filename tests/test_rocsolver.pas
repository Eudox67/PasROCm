procedure TTestRocSolver_Factorizations.Test_rocsolver_ssytf2_batched;
const
  n = 10;
  lda = 10;
  batch_count = 3;
var
  AStatus: rocblas_status;
  AhipStatus: hipError_t;
  h_A, h_A_result, h_A_golden: array of Single;
  h_ipiv, h_ipiv_result, h_ipiv_golden: array of rocblas_int;
  h_info, h_info_result, h_info_golden: array of rocblas_int;
  d_A_array, d_A_array_golden: array of hipDeviceptr_t;
  d_ipiv, d_ipiv_golden, d_info, d_info_golden: hipDeviceptr_t;
  d_A_ptrs, d_A_ptrs_golden: hipDeviceptr_t;
  i, j, k: Integer;
  strideP: rocblas_stride;
  size_A, size_ipiv_per, size_info_per, total_size_ipiv, total_size_info: size_t;
  uplo_values: array[0..1] of rocblas_fill;
  uplo: rocblas_fill;
begin
  // Setup
  strideP := n;
  size_A := lda * n * sizeof(Single);
  size_ipiv_per := strideP * sizeof(rocblas_int);
  size_info_per := sizeof(rocblas_int);
  total_size_ipiv := size_ipiv_per * batch_count;
  total_size_info := size_info_per * batch_count;

  SetLength(h_A, lda * n * batch_count);
  SetLength(h_A_result, lda * n * batch_count);
  SetLength(h_A_golden, lda * n * batch_count);
  SetLength(h_ipiv, strideP * batch_count);
  SetLength(h_ipiv_result, strideP * batch_count);
  SetLength(h_ipiv_golden, strideP * batch_count);
  SetLength(h_info, batch_count);
  SetLength(h_info_result, batch_count);
  SetLength(h_info_golden, batch_count);

  SetLength(d_A_array, batch_count);
  SetLength(d_A_array_golden, batch_count);

  for k := 0 to batch_count - 1 do
  begin
    AhipStatus := hipMalloc(d_A_array[k], size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, Format('hipMalloc for d_A_array[%d] failed', [k]));
    AhipStatus := hipMalloc(d_A_array_golden[k], size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, Format('hipMalloc for d_A_array_golden[%d] failed', [k]));
  end;

  AhipStatus := hipMalloc(d_A_ptrs, batch_count * sizeof(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A_ptrs failed');
  AhipStatus := hipMalloc(d_A_ptrs_golden, batch_count * sizeof(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A_ptrs_golden failed');
  AhipStatus := hipMalloc(d_ipiv, total_size_ipiv);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_ipiv failed');
  AhipStatus := hipMalloc(d_ipiv_golden, total_size_ipiv);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_ipiv_golden failed');
  AhipStatus := hipMalloc(d_info, total_size_info);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_info failed');
  AhipStatus := hipMalloc(d_info_golden, total_size_info);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_info_golden failed');

  uplo_values[0] := rocblas_fill_upper;
  uplo_values[1] := rocblas_fill_lower;

  for uplo in uplo_values do
  begin
    // Initialize input matrices
    for k := 0 to batch_count - 1 do
    begin
      for j := 0 to n - 1 do
        for i := 0 to n - 1 do
        begin
          if i >= j then
            h_A[k * lda * n + j * lda + i] := i + j + 2 + (k*10)
          else
            h_A[k * lda * n + j * lda + i] := j + i + 2 + (k*10);
        end;
      for i := 0 to n - 1 do
        h_A[k * lda * n + i * lda + i] := h_A[k * lda * n + i * lda + i] + n * 2;
    end;

    // --- Characterization Run: Generate Golden Values ---
    for k := 0 to batch_count - 1 do
    begin
      AhipStatus := hipMemcpy(d_A_array_golden[k], @h_A[k * lda * n], size_A, hipMemcpyHostToDevice);
      CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_array_golden failed');
    end;
    AhipStatus := hipMemcpy(d_A_ptrs_golden, @d_A_array_golden[0], batch_count * sizeof(hipDeviceptr_t), hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_ptrs_golden failed');

    AStatus := rocsolver_ssytf2_batched(FHandle, uplo, n, d_A_ptrs_golden, lda, d_ipiv_golden, strideP, d_info_golden, batch_count);
    CheckEquals(rocblas_status_success, AStatus, 'Golden value generation failed');

    for k := 0 to batch_count - 1 do
    begin
      AhipStatus := hipMemcpy(@h_A_golden[k * lda * n], d_A_array_golden[k], size_A, hipMemcpyDeviceToHost);
      CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_A_array_golden failed');
    end;
    AhipStatus := hipMemcpy(@h_ipiv_golden[0], d_ipiv_golden, total_size_ipiv, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_ipiv_golden failed');
    AhipStatus := hipMemcpy(@h_info_golden[0], d_info_golden, total_size_info, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_info_golden failed');
    // --- End of Golden Value Generation ---

    // --- Actual Test Run ---
    for k := 0 to batch_count - 1 do
    begin
      AhipStatus := hipMemcpy(d_A_array[k], @h_A[k * lda * n], size_A, hipMemcpyHostToDevice);
      CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_array failed');
    end;
    AhipStatus := hipMemcpy(d_A_ptrs, @d_A_array[0], batch_count * sizeof(hipDeviceptr_t), hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_ptrs failed');

    // Execute
    AStatus := rocsolver_ssytf2_batched(FHandle, uplo, n, d_A_ptrs, lda, d_ipiv, strideP, d_info, batch_count);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_ssytf2_batched failed');

    // Retrieve
    for k := 0 to batch_count - 1 do
    begin
      AhipStatus := hipMemcpy(@h_A_result[k * lda * n], d_A_array[k], size_A, hipMemcpyDeviceToHost);
      CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_A_array failed');
    end;

procedure TTestRocSolver_OrthogonalApp.Test_rocsolver_sormbr;
const
  a_rows = 6; // Rows of the original matrix A
  a_cols = 5; // Cols of the original matrix A
  m = a_rows; // Rows of matrix C
  n = 4;      // Cols of matrix C
  k = a_cols; // Number of elementary reflectors
  lda = a_rows;
  ldc = m;

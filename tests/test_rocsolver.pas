procedure TTestRocSolver_Factorizations.Test_rocsolver_zhetrd;
const
  n = 5;
  lda = n;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A: array of rocblas_double_complex;
  h_D, h_E: array of Double;
  h_tau: array of rocblas_double_complex;
  d_A, d_D, d_E, d_tau: hipDeviceptr_t;
  sizeA, sizeD, sizeE, sizeTau: size_t;
  i, j: Integer;
begin
  // 1. Setup
  sizeA := n * n * SizeOf(rocblas_double_complex);
  sizeD := n * SizeOf(Double);
  sizeE := (n - 1) * SizeOf(Double);
  sizeTau := (n - 1) * SizeOf(rocblas_double_complex);

  SetLength(h_A, n * n);
  SetLength(h_D, n);
  SetLength(h_E, n - 1);
  SetLength(h_tau, n - 1);

  // Initialize a Hilbert matrix (real-symmetric is a valid Hermitian matrix).
  // We fill the LOWER triangle (i >= j).
  for j := 0 to n - 1 do
  begin
    for i := j to n - 1 do
    begin
        h_A[j * lda + i].x := 1.0 / (i + j + 1);
        h_A[j * lda + i].y := 0.0;
    end;
  end;

  d_A := nil;
  d_D := nil;
  d_E := nil;
  d_tau := nil;

  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_D, sizeD);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_D');
  AhipStatus := hipMalloc(d_E, sizeE);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_E');
  AhipStatus := hipMalloc(d_tau, sizeTau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_tau');

  try
    // 2. Transfer data to device
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);

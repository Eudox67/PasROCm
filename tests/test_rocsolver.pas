  d_A_ptrs, d_B_ptrs, d_C_ptrs, d_info, d_workspace: Pointer;
  h_info_batch: array of rocblas_int;
  ASizeA, ASizeB, ASizeC, ASizeInfo, ASizePtrs, AWorkspaceSize: size_t;
  tempPtr: Pointer;
  b, k, i, j: Integer;
begin
  // 1. Initialize
  d_A_ptrs := nil; d_B_ptrs := nil; d_C_ptrs := nil; d_info := nil; d_workspace := nil;
  ASizeA := (NBLOCKS - 1) * LDA * NB * SizeOf(rocblas_double_complex);
  ASizeB := NBLOCKS * LDB * NB * SizeOf(rocblas_double_complex);
  ASizeC := (NBLOCKS - 1) * LDC * NB * SizeOf(rocblas_double_complex);
  ASizeInfo := BATCH_COUNT * SizeOf(rocblas_int);
  ASizePtrs := BATCH_COUNT * SizeOf(Pointer);

  SetLength(h_A_batch, BATCH_COUNT);
  SetLength(h_B_batch, BATCH_COUNT);
  SetLength(h_C_batch, BATCH_COUNT);
  SetLength(h_A_ptrs, BATCH_COUNT);
  SetLength(h_B_ptrs, BATCH_COUNT);
  SetLength(h_C_ptrs, BATCH_COUNT);
  SetLength(h_info_batch, BATCH_COUNT);

  for b := 0 to BATCH_COUNT - 1 do
  begin
    GetMem(tempPtr, ASizeA); h_A_batch[b] := Procdouble_complex(tempPtr);
    GetMem(tempPtr, ASizeB); h_B_batch[b] := Procdouble_complex(tempPtr);
    GetMem(tempPtr, ASizeC); h_C_batch[b] := Procdouble_complex(tempPtr);

    for k := 0 to (NBLOCKS - 2) * LDA * NB - 1 do begin (h_A_batch[b]+k)^.x := 1.0; (h_A_batch[b]+k)^.y := 0.0; end;
    for k := 0 to (NBLOCKS - 2) * LDC * NB - 1 do begin (h_C_batch[b]+k)^.x := 1.0; (h_C_batch[b]+k)^.y := 0.0; end;

    for k := 0 to NBLOCKS - 1 do
      for j := 0 to NB - 1 do
        for i := 0 to NB - 1 do
        begin
          if i = j then
          begin
            (h_B_batch[b] + k*LDB*NB + i + j*LDB)^.x := 4.0 * NB;
            (h_B_batch[b] + k*LDB*NB + i + j*LDB)^.y := 0.0;
          end
          else
          begin
            (h_B_batch[b] + k*LDB*NB + i + j*LDB)^.x := 1.0;
            (h_B_batch[b] + k*LDB*NB + i + j*LDB)^.y := 0.0;
          end;
        end;
  end;

  try
    // 2. Allocate device memory for pointers and data
    AStatusHip := hipMalloc(d_A_ptrs, ASizePtrs); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_B_ptrs, ASizePtrs); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_C_ptrs, ASizePtrs); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_info, ASizeInfo); CheckEquals(HIP_SUCCESS, AStatusHip);
    for b := 0 to BATCH_COUNT - 1 do
    begin
      AStatusHip := hipMalloc(h_A_ptrs[b], ASizeA); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusHip := hipMalloc(h_B_ptrs[b], ASizeB); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusHip := hipMalloc(h_C_ptrs[b], ASizeC); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusHip := hipMemcpy(h_A_ptrs[b], h_A_batch[b], ASizeA, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusHip := hipMemcpy(h_B_ptrs[b], h_B_batch[b], ASizeB, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusHip := hipMemcpy(h_C_ptrs[b], h_C_batch[b], ASizeC, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    end;
    AStatusHip := hipMemcpy(d_A_ptrs, @h_A_ptrs[0], ASizePtrs, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_B_ptrs, @h_B_ptrs[0], ASizePtrs, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_C_ptrs, @h_C_ptrs[0], ASizePtrs, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 3. Query for workspace size
    AStatusBlas := rocblas_start_device_memory_size_query(FHandle); CheckEquals(rocblas_status_success, AStatusBlas);
    AStatusSolver := rocsolver_zgeblttrf_npvt_batched(FHandle, NB, NBLOCKS, nil, LDA, nil, LDB, nil, LDC, nil, BATCH_COUNT);
    Check((AStatusSolver = rocblas_status_success) or (AStatusSolver = rocblas_status_size_increased), 'Workspace query failed');
    AStatusBlas := rocblas_stop_device_memory_size_query(FHandle, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas);

    // 4. Allocate and set workspace
    if AWorkspaceSize > 0 then
    begin
      AStatusHip := hipMalloc(d_workspace, AWorkspaceSize); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusBlas := rocblas_set_workspace(FHandle, d_workspace, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas);
    end;

    // 5. Call function for execution
    AStatusSolver := rocsolver_zgeblttrf_npvt_batched(FHandle, NB, NBLOCKS, d_A_ptrs, LDA, d_B_ptrs, LDB, d_C_ptrs, LDC, d_info, BATCH_COUNT);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_zgeblttrf_npvt_batched failed');

    // 6. Verify results
    AStatusHip := hipMemcpy(@h_info_batch[0], d_info, ASizeInfo, hipMemcpyDeviceToHost); CheckEquals(HIP_SUCCESS, AStatusHip);
    if AStatusSolver = rocblas_status_success then
      for b := 0 to BATCH_COUNT - 1 do
        CheckEquals(0, h_info_batch[b], 'Batch ' + IntToStr(b) + ' failed');

  finally
    // 7. Cleanup
    if Assigned(d_workspace) then
    begin
      rocblas_set_workspace(FHandle, nil, 0);
      hipFree(d_workspace);
    end;
    if Assigned(d_A_ptrs) then hipFree(d_A_ptrs);
    if Assigned(d_B_ptrs) then hipFree(d_B_ptrs);
    if Assigned(d_C_ptrs) then hipFree(d_C_ptrs);
    if Assigned(d_info) then hipFree(d_info);
    for b := 0 to BATCH_COUNT - 1 do
    begin
      if Assigned(h_A_ptrs[b]) then hipFree(h_A_ptrs[b]);
      if Assigned(h_B_ptrs[b]) then hipFree(h_B_ptrs[b]);
      if Assigned(h_C_ptrs[b]) then hipFree(h_C_ptrs[b]);
      if Assigned(h_A_batch[b]) then FreeMem(h_A_batch[b]);
      if Assigned(h_B_batch[b]) then FreeMem(h_B_batch[b]);
      if Assigned(h_C_batch[b]) then FreeMem(h_C_batch[b]);
    end;
  end;
end;


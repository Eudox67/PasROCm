procedure TTestRocSolver_Factorizations.Test_rocsolver_sgeqrf;
const
  m = 10;
  n = 8;
  lda = m;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  k: rocblas_int;
  h_A: array of Single;
  h_tau, h_tau_res: array of Single;
  d_A, d_tau: hipDeviceptr_t;
  sizeA, sizeTau: size_t;
  i, j: Integer;
begin
  // 1. Setup
  k := min(m, n);
  sizeA := m * n * SizeOf(Single);
  sizeTau := k * SizeOf(Single);

  SetLength(h_A, m * n);
  SetLength(h_tau, k);
  SetLength(h_tau_res, k);

  // Initialize a general matrix with linearly independent columns
  for j := 0 to n - 1 do
  begin
    for i := 0 to m - 1 do
    begin
      h_A[i + j * lda] := i + j * m + 1;
    end;
  end;

  d_A := nil;
  d_tau := nil;
  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_tau, sizeTau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_tau');

  try
    // 2. Transfer data
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A');

    // 3. Execute
    // Note: 'ipiv' in the FFI corresponds to 'tau' for QR functions.
    AStatus := rocsolver_sgeqrf(FHandle, m, n, d_A, lda, d_tau);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgeqrf');

    // 4. Transfer results
    AhipStatus := hipMemcpy(@h_tau_res[0], d_tau, sizeTau, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H tau');

    // 5. Verification
    Check(h_tau_res[0] <> 0, 'tau[0] should be non-zero after factorization');

  finally
    // 6. Cleanup
    if d_A <> nil then hipFree(d_A);
    if d_tau <> nil then hipFree(d_tau);
  end;
end;


procedure TTestRocSolver_Solvers.Test_rocsolver_sgetrs_strided_batched;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
  BATCH_COUNT = 2;
var
  h_A_orig, h_A, h_B, h_X: array of Single;
  h_info: array of rocblas_int;
  d_A, d_B, d_ipiv, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k, b: Integer;
  strideA, strideP, strideB: rocblas_stride;

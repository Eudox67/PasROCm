    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A failed');

    // Execute
    AStatus := rocsolver_dsytrf_strided_batched(FHandle, uplo, n, d_A, lda, strideA, d_ipiv, strideP, d_info, batch_count);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_dsytrf_strided_batched failed');

    // Retrieve
    AhipStatus := hipMemcpy(@h_A_result[0], d_A, total_size_A, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_A failed');

procedure TTestRocSolver_Factorizations.Test_rocsolver_sgetf2_batched;
const
  m = 5;
  n = 4;
  lda = m;
  batch_count = 3;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  k: rocblas_int;
  h_A_data: array of Single;
  h_ipiv: array of rocblas_int;
  h_info: array of rocblas_int;
  h_A_ptrs: array of hipDeviceptr_t;
  d_A_data, d_A_ptrs, d_ipiv, d_info: hipDeviceptr_t;
  strideP: rocblas_stride;
  size_matrix_bytes, size_piv_bytes, size_A_data_bytes, size_A_ptrs_bytes, size_ipiv_bytes, size_info_bytes: size_t;
  size_matrix_elements, size_piv_elements: Integer;
  i, j, b: Integer;
begin
  // 1. Setup
  k := min(m, n);
  size_matrix_elements := m * n;
  size_piv_elements := k;
  strideP := size_piv_elements;

  size_matrix_bytes := size_matrix_elements * SizeOf(Single);
  size_piv_bytes := size_piv_elements * SizeOf(rocblas_int);
  size_A_data_bytes := batch_count * size_matrix_bytes;
  size_A_ptrs_bytes := batch_count * SizeOf(hipDeviceptr_t);
  size_ipiv_bytes := batch_count * size_piv_bytes;
  size_info_bytes := batch_count * SizeOf(rocblas_int);

  SetLength(h_A_data, batch_count * size_matrix_elements);
  SetLength(h_ipiv, batch_count * size_piv_elements);
  SetLength(h_info, batch_count);
  SetLength(h_A_ptrs, batch_count);

  // Initialize a non-singular matrix that requires pivoting (permuted identity)
  for b := 0 to batch_count - 1 do
  begin
    for j := 0 to n - 1 do
    begin
      for i := 0 to m - 1 do
      begin
        // Start with a zero matrix
        h_A_data[b * size_matrix_elements + i + j * lda] := 0.0;
      end;
    end;
    // Create a permuted identity matrix: put a 1 on the anti-diagonal
    for i := 0 to k - 1 do
    begin
       h_A_data[b * size_matrix_elements + (k-1-i) + i * lda] := 1.0;
    end;
  end;

  d_A_data := nil;
  d_A_ptrs := nil;
  d_ipiv := nil;
  d_info := nil;
  AhipStatus := hipMalloc(d_A_data, size_A_data_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A_data');
  AhipStatus := hipMalloc(d_A_ptrs, size_A_ptrs_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A_ptrs');
  AhipStatus := hipMalloc(d_ipiv, size_ipiv_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_ipiv');
  AhipStatus := hipMalloc(d_info, size_info_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_info');

  try
    AhipStatus := hipMemcpy(d_A_data, @h_A_data[0], size_A_data_bytes, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A_data');

    for b := 0 to batch_count - 1 do
    begin
      h_A_ptrs[b] := hipDeviceptr_t(PtrUInt(d_A_data) + b * size_matrix_bytes);
    end;

    AhipStatus := hipMemcpy(d_A_ptrs, @h_A_ptrs[0], size_A_ptrs_bytes, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A_ptrs');

    AStatus := rocsolver_sgetf2_batched(FHandle, m, n, d_A_ptrs, lda, d_ipiv, strideP, d_info, batch_count);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetf2_batched');

    AhipStatus := hipMemcpy(@h_info[0], d_info, size_info_bytes, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H info');
    AhipStatus := hipMemcpy(@h_ipiv[0], d_ipiv, size_ipiv_bytes, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H ipiv');

    for b := 0 to batch_count - 1 do
    begin
      CheckEquals(0, h_info[b], 'info[' + IntToStr(b) + '] should be 0');
      // LAPACK pivots are 1-based. A value > k for the k-th pivot indicates a swap occurred.
      Check(h_ipiv[b * strideP + 0] <> 1, 'pivots['+IntToStr(b)+',0] should indicate a swap');
    end;

  finally
    if d_A_data <> nil then hipFree(d_A_data);
    if d_A_ptrs <> nil then hipFree(d_A_ptrs);
    if d_ipiv <> nil then hipFree(d_ipiv);
    if d_info <> nil then hipFree(d_info);
  end;
end;


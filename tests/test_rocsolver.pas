  // A = [ 2+2i, -1-1i,  0+0i]
  //     [-1-1i,  2+2i, -1-1i]
  //     [ 0+0i, -1-1i,  2+2i]
  h_A[0].x := 2;  h_A[0].y := 2;  h_A[1].x := -1; h_A[1].y := -1; h_A[2].x := 0;  h_A[2].y := 0;

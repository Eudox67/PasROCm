procedure TTestRocSolver_Factorizations.Test_rocsolver_ssytrd;
const
  n = 5;
  lda = n;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A: array of Single;
  h_D, h_E, h_tau: array of Single;
  d_A, d_D, d_E, d_tau: hipDeviceptr_t;
  sizeA, sizeD, sizeE, sizeTau: size_t;
  i, j: Integer;
begin
  // 1. Setup
  sizeA := n * n * SizeOf(Single);
  sizeD := n * SizeOf(Single);
  sizeE := (n - 1) * SizeOf(Single);
  sizeTau := (n - 1) * SizeOf(Single);

  SetLength(h_A, n * n);
  SetLength(h_D, n);
  SetLength(h_E, n - 1);
  SetLength(h_tau, n - 1);

  // Initialize a Hilbert matrix (symmetric, positive-definite) in column-major order.
  // We fill the LOWER triangle (i >= j).
  for j := 0 to n - 1 do
  begin
    for i := j to n - 1 do
    begin
      h_A[j * lda + i] := 1.0 / (i + j + 1);
    end;
  end;

  d_A := nil;
  d_D := nil;
  d_E := nil;
  d_tau := nil;

  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_D, sizeD);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_D');
  AhipStatus := hipMalloc(d_E, sizeE);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_E');
  AhipStatus := hipMalloc(d_tau, sizeTau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_tau');

  try
    // 2. Transfer data to device
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A');

    // 3. Execute rocSOLVER function using rocblas_fill_lower to match initialization
    AStatus := rocsolver_ssytrd(FHandle, rocblas_fill_lower, n, d_A, lda, d_D, d_E, d_tau);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_ssytrd');

    // 4. Transfer results back to host
    AhipStatus := hipMemcpy(@h_D[0], d_D, sizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H D');
    AhipStatus := hipMemcpy(@h_E[0], d_E, sizeE, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H E');
    AhipStatus := hipMemcpy(@h_tau[0], d_tau, sizeTau, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H tau');

    // 5. Verification (simple checks)
    Check(h_D[0] <> 0.0, 'Diagonal D should contain non-zero elements');
    Check(h_tau[0] <> 0.0, 'tau should contain non-zero elements');

  finally
    // 6. Cleanup
    if d_A <> nil then hipFree(d_A);
    if d_D <> nil then hipFree(d_D);
    if d_E <> nil then hipFree(d_E);
    if d_tau <> nil then hipFree(d_tau);
  end;
end;


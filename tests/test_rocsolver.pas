      normA := normA + Sqr(h_A_orig[b * strideA + i].x) + Sqr(h_A_orig[b * strideA + i].y);
    normA := Sqrt(normA);

    normX := 0;
    for i := 0 to b_size - 1 do
      normX := normX + Sqr(h_X[b * strideB + i].x) + Sqr(h_X[b * strideB + i].y);
    normX := Sqrt(normX);

    residual := 0;
    for i := 0 to N - 1 do
    begin
      for j := 0 to NRHS - 1 do
      begin
        temp.x := 0; temp.y := 0;
        for k := 0 to N - 1 do
        begin
          temp.x := temp.x + (h_A_orig[b*strideA + i + k*LDA].x * h_X[b*strideB + k + j*LDB].x - h_A_orig[b*strideA + i + k*LDA].y * h_X[b*strideB + k + j*LDB].y);
          temp.y := temp.y + (h_A_orig[b*strideA + i + k*LDA].x * h_X[b*strideB + k + j*LDB].y + h_A_orig[b*strideA + i + k*LDA].y * h_X[b*strideB + k + j*LDB].x);
        end;
        residual := residual + Sqr(temp.x - h_B[b*strideB + i + j*LDB].x) + Sqr(temp.y - h_B[b*strideB + i + j*LDB].y);
      end;
    end;
    residual := Sqrt(residual);

    if ((normA > 0) and (normX > 0)) then
      error := residual / (normA * normX)
    else
      error := residual;
    CheckEquals(0.0, error, 1e-12, 'Solution residual is too high for batch item ' + IntToStr(b));
  end;

  // 8. Clean up
  hipStatus := hipFree(d_A); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_B); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);
end;


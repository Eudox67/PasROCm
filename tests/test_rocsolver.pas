  ASizeB := NBLOCKS * ldb_inter * NB * SizeOf(rocblas_double_complex);
  ASizeC := (NBLOCKS - 1) * ldc_inter * NB * SizeOf(rocblas_double_complex);
  ASizeInfo := BATCH_COUNT * SizeOf(rocblas_int);

  if ASizeA > 0 then SetLength(h_A, ASizeA div SizeOf(rocblas_double_complex));
  SetLength(h_B, ASizeB div SizeOf(rocblas_double_complex));
  if ASizeC > 0 then SetLength(h_C, ASizeC div SizeOf(rocblas_double_complex));
  SetLength(h_info, BATCH_COUNT);

  // Initialize host data
  for k := 0 to NBLOCKS - 2 do
    for j := 0 to NB - 1 do
      for i := 0 to NB - 1 do
        for b := 0 to BATCH_COUNT - 1 do
        begin
          h_A[k*NB*lda_inter + j*lda_inter + i*inca + b].x := 1.0;
          h_A[k*NB*lda_inter + j*lda_inter + i*inca + b].y := 0.0;
          h_C[k*NB*ldc_inter + j*ldc_inter + i*incc + b].x := 1.0;
          h_C[k*NB*ldc_inter + j*ldc_inter + i*incc + b].y := 0.0;
        end;
  for k := 0 to NBLOCKS - 1 do
    for j := 0 to NB - 1 do
      for i := 0 to NB - 1 do
        for b := 0 to BATCH_COUNT - 1 do
        begin
          if i = j then
          begin
            h_B[k*NB*ldb_inter + j*ldb_inter + i*incb + b].x := 4.0 * NB;
            h_B[k*NB*ldb_inter + j*ldb_inter + i*incb + b].y := 0.0;
          end
          else
          begin
            h_B[k*NB*ldb_inter + j*ldb_inter + i*incb + b].x := 1.0;
            h_B[k*NB*ldb_inter + j*ldb_inter + i*incb + b].y := 0.0;
          end;
        end;
  try
    // 2. Query for workspace size
    AStatusBlas := rocblas_start_device_memory_size_query(FHandle); CheckEquals(rocblas_status_success, AStatusBlas);
    AStatusSolver := rocsolver_zgeblttrf_npvt_interleaved_batched(FHandle, NB, NBLOCKS, nil, inca, lda_inter, strideA, nil, incb, ldb_inter, strideB, nil, incc, ldc_inter, strideC, nil, BATCH_COUNT);
    Check((AStatusSolver = rocblas_status_success) or (AStatusSolver = rocblas_status_size_increased), 'Workspace query failed');
    AStatusBlas := rocblas_stop_device_memory_size_query(FHandle, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas);

    // 3. Allocate device memory
    if ASizeA > 0 then begin AStatusHip := hipMalloc(d_A, ASizeA); CheckEquals(HIP_SUCCESS, AStatusHip); end else d_A := nil;
    AStatusHip := hipMalloc(d_B, ASizeB); CheckEquals(HIP_SUCCESS, AStatusHip);
    if ASizeC > 0 then begin AStatusHip := hipMalloc(d_C, ASizeC); CheckEquals(HIP_SUCCESS, AStatusHip); end else d_C := nil;
    AStatusHip := hipMalloc(d_info, ASizeInfo); CheckEquals(HIP_SUCCESS, AStatusHip);
    if AWorkspaceSize > 0 then
    begin
      AStatusHip := hipMalloc(d_workspace, AWorkspaceSize); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusBlas := rocblas_set_workspace(FHandle, d_workspace, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas);
    end;

    // 4. Copy inputs to device
    if Assigned(d_A) then AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_B, @h_B[0], ASizeB, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    if Assigned(d_C) then AStatusHip := hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 5. Call function
    AStatusSolver := rocsolver_zgeblttrf_npvt_interleaved_batched(FHandle, NB, NBLOCKS, d_A, inca, lda_inter, strideA, d_B, incb, ldb_inter, strideB, d_C, incc, ldc_inter, strideC, d_info, BATCH_COUNT);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_zgeblttrf_npvt_interleaved_batched failed');

    // 6. Verify results
    AStatusHip := hipMemcpy(@h_info[0], d_info, ASizeInfo, hipMemcpyDeviceToHost); CheckEquals(HIP_SUCCESS, AStatusHip);
    if AStatusSolver = rocblas_status_success then
      for b := 0 to BATCH_COUNT - 1 do
        CheckEquals(0, h_info[b], 'Batch ' + IntToStr(b) + ' failed');

  finally
    // 7. Cleanup
    if Assigned(d_workspace) then begin rocblas_set_workspace(FHandle, nil, 0); hipFree(d_workspace); end;
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_B) then hipFree(d_B);
    if Assigned(d_C) then hipFree(d_C);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


  BATCH_COUNT = 2;
var
  h_A, h_A_orig, h_C: array[0..BATCH_COUNT-1, 0..N-1, 0..N-1] of rocblas_float_complex;
  h_info: array[0..BATCH_COUNT-1] of rocblas_int;
  d_A, d_ipiv, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k, b: Integer;
  sum, temp: rocblas_float_complex;
  strideA, strideP: rocblas_stride;
begin
  // 1. Initialize test data on the host
  strideA := N * LDA;
  strideP := N;

  for b := 0 to BATCH_COUNT - 1 do
  begin
    h_A[b,0,0].x := 2.0 + b; h_A[b,0,0].y := 0.0;
    h_A[b,0,1].x := 1.0;     h_A[b,0,1].y := 1.0;
    h_A[b,1,0].x := 1.0;     h_A[b,1,0].y := -1.0;
    h_A[b,1,1].x := 3.0 + b; h_A[b,1,1].y := 0.0;
    h_A_orig[b] := h_A[b];
  end;

  // 2. Allocate memory on the device
  hipStatus := hipMalloc(d_A, BATCH_COUNT * strideA * SizeOf(rocblas_float_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_ipiv, BATCH_COUNT * strideP * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_ipiv failed');
  hipStatus := hipMalloc(d_info, BATCH_COUNT * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 3. Copy data from host to device
  hipStatus := hipMemcpy(d_A, @h_A, BATCH_COUNT * strideA * SizeOf(rocblas_float_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');

  // 4. Perform LU factorization
  AStatus := rocsolver_cgetrf_strided_batched(FHandle, N, N, d_A, LDA, strideA, d_ipiv, strideP, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_cgetrf_strided_batched failed');

  // 5. Call the target function
  AStatus := rocsolver_cgetri_strided_batched(FHandle, N, d_A, LDA, strideA, d_ipiv, strideP, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_cgetri_strided_batched failed');

  // 6. Verify results
  hipStatus := hipMemcpy(@h_A, d_A, BATCH_COUNT * strideA * SizeOf(rocblas_float_complex), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_A to h_A failed');
  hipStatus := hipMemcpy(@h_info, d_info, BATCH_COUNT * SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_info to h_info failed');

  for b := 0 to BATCH_COUNT - 1 do
  begin
    CheckEquals(0, h_info[b], 'cgetri_strided_batched info[' + IntToStr(b) + '] should be 0');
    for i := 0 to N-1 do
    begin
      for j := 0 to N-1 do
      begin
        sum.x := 0.0; sum.y := 0.0;
        for k := 0 to N-1 do
        begin
          temp.x := h_A_orig[b,i,k].x * h_A[b,k,j].x - h_A_orig[b,i,k].y * h_A[b,k,j].y;
          temp.y := h_A_orig[b,i,k].x * h_A[b,k,j].y + h_A_orig[b,i,k].y * h_A[b,k,j].x;
          sum.x := sum.x + temp.x;
          sum.y := sum.y + temp.y;
        end;
        h_C[b,i,j] := sum;
      end;
    end;

    for i := 0 to N-1 do
    begin
      for j := 0 to N-1 do
      begin
        if i = j then
        begin
          CheckEquals(1.0, h_C[b,i,j].x, 1e-6, 'Batch ' + IntToStr(b) + ', C['+IntToStr(i)+','+IntToStr(j)+'].x');
          CheckEquals(0.0, h_C[b,i,j].y, 1e-6, 'Batch ' + IntToStr(b) + ', C['+IntToStr(i)+','+IntToStr(j)+'].y');
        end else
        begin
          CheckEquals(0.0, h_C[b,i,j].x, 1e-6, 'Batch ' + IntToStr(b) + ', C['+IntToStr(i)+','+IntToStr(j)+'].x');
          CheckEquals(0.0, h_C[b,i,j].y, 1e-6, 'Batch ' + IntToStr(b) + ', C['+IntToStr(i)+','+IntToStr(j)+'].y');
        end;
      end;
    end;
  end;

  // 7. Cleanup
  hipStatus := hipFree(d_A);    CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_ipiv); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);

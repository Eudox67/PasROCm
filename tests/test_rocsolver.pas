    CheckEquals(h_alpha_gold.y, h_alpha_result.y, 1e-6, 'alpha.y mismatch');
    CheckEquals(h_tau_gold.x, h_tau_result.x, 1e-6, 'tau.x mismatch');
    CheckEquals(h_tau_gold.y, h_tau_result.y, 1e-6, 'tau.y mismatch');
    CheckEquals(h_x_gold[0].x, h_x_result[0].x, 1e-6, 'x[0].x mismatch');
    CheckEquals(h_x_gold[0].y, h_x_result[0].y, 1e-6, 'x[0].y mismatch');

procedure TTestRocSolver_Auxiliary.Test_rocsolver_slasyf;
const
  N = 5;
  NB = 2; // Block size
  LDA = N;
type
  PRocblas_int = ^rocblas_int;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_A: array of Single;
  d_A, d_ipiv: Pointer;
  p_kb, p_info: PRocblas_int; // Pointers to PINNED host memory
  ASizeA, ASizeIpiv: size_t;
  i, j: Integer;
begin
  // 1. Initialize sizes and host data
  ASizeA := LDA * N * SizeOf(Single);
  ASizeIpiv := N * SizeOf(rocblas_int);
  SetLength(h_A, LDA * N);
  for j := 0 to N - 1 do for i := 0 to N - 1 do h_A[i + j * LDA] := 1.0 + Max(i, j);

  // 2. Allocate device memory and PINNED host memory for scalar results
  d_A := nil; d_ipiv := nil; p_kb := nil; p_info := nil;
  hipMalloc(d_A, ASizeA);
  hipMalloc(d_ipiv, ASizeIpiv);
  AStatusHip := hipHostMalloc(Pointer(p_kb), SizeOf(rocblas_int), 0);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipHostMalloc for p_kb failed');
  AStatusHip := hipHostMalloc(Pointer(p_info), SizeOf(rocblas_int), 0);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipHostMalloc for p_info failed');
  if (p_kb = nil) or (p_info = nil) then Fail('Pinned memory allocation failed');

  // 3. Copy input matrix A to device
  AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');

  // 4. Call rocsolver_slasyf
  AStatusSolver := rocsolver_slasyf(FHandle, rocblas_fill_upper, N, NB, p_kb^, d_A, LDA, d_ipiv, p_info^);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_slasyf failed');

  // 5. Verify results
  if AStatusSolver = rocblas_status_success then
  begin
    CheckEquals(0, p_info^, 'Info should be 0 for successful factorization');
    // REMOVED: CheckTrue(p_kb^ > 0, 'kb (actual block size) should be greater than 0');
    CheckTrue(p_kb^ <= NB, 'kb should be less than or equal to nb');
    // A kb value of 0 is a valid outcome for this routine.
  end;

  // 6. Cleanup
  if Assigned(d_A) then hipFree(d_A);
  if Assigned(d_ipiv) then hipFree(d_ipiv);
  if Assigned(p_kb) then hipHostFree(p_kb);
  if Assigned(p_info) then hipHostFree(p_info);
end;


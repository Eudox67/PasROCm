procedure TTestRocSolver_EigenSVD.RunGesvd(AKind: TRoCElemKind);
const
  M = RO_SVD_M;
  N = RO_SVD_N;
  K = RO_SVD_N;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_A: array[0..(M * N * 16) - 1] of Byte;
  h_S, h_S2: array[0..(K * 16) - 1] of Byte;
  h_U, h_V: array[0..(M * M * 16) - 1] of Byte;
  h_info: rocblas_int;
  d_A, d_S, d_S2, d_U, d_V, d_E, d_info: Pointer;
  ASizeA, ASizeS, ASizeU, ASizeV: size_t;
  ATolEig, ATolRes, ATolOrth: Double;
  I: Integer;
begin
  d_A := nil;
  d_S := nil;
  d_S2 := nil;
  d_U := nil;
  d_V := nil;
  d_E := nil;
  d_info := nil;
  ASizeA := M * N * RoCElemSize(AKind);
  ASizeS := K * RoCRealSize(AKind);
  ASizeU := M * M * RoCElemSize(AKind);
  ASizeV := N * N * RoCElemSize(AKind);
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  FillChar(h_A, SizeOf(h_A), 0);
  FillChar(h_U, SizeOf(h_U), 0);
  FillChar(h_V, SizeOf(h_V), 0);
  RoCFillSvdMatrix(@h_A[0], AKind, 1.0);

  try
    AStatusHip := hipMalloc(d_A, ASizeA);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_S, ASizeS);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_S failed');
    AStatusHip := hipMalloc(d_S2, ASizeS);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_S2 failed');
    AStatusHip := hipMalloc(d_U, ASizeU);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_U failed');
    AStatusHip := hipMalloc(d_V, ASizeV);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_V failed');
    AStatusHip := hipMalloc(d_E, ASizeS);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_info, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    { 1. Compute the full singular value decomposition. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallGesvd(AKind, rocblas_svect_all, rocblas_svect_all, d_A,
      d_S, d_U, d_V, d_E, d_info);
    if AStatus = rocblas_status_not_implemented then
      Ignore('gesvd is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, 'gesvd failed');

    AStatusHip := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, 'gesvd reported a convergence failure');

    AStatusHip := hipMemcpy(@h_S[0], d_S, ASizeS, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_S failed');
    AStatusHip := hipMemcpy(@h_U[0], d_U, ASizeU, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_U failed');
    AStatusHip := hipMemcpy(@h_V[0], d_V, ASizeV, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_V failed');
    CheckSvd(AKind, PByte(@h_A[0]), PByte(@h_S[0]), PByte(@h_U[0]), PByte(@h_V[0]),
      'gesvd');

    { 2. Without singular vectors the same singular values are returned. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallGesvd(AKind, rocblas_svect_none, rocblas_svect_none, d_A,
      d_S2, d_U, d_V, d_E, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'gesvd with svect=none failed');
    AStatusHip := hipMemcpy(@h_S2[0], d_S2, ASizeS, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_S2 failed');
    for I := 0 to K - 1 do
      CheckEquals(RoCGetReal(@h_S[0], I, AKind), RoCGetReal(@h_S2[0], I, AKind),
        ATolEig * 10.0, 'gesvd: singular value ' + IntToStr(I)
        + ' differs for svect=none');

    { 3. The thin SVD must return the same singular values as well. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallGesvd(AKind, rocblas_svect_singular, rocblas_svect_singular,
      d_A, d_S2, d_U, d_V, d_E, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'gesvd with svect=singular failed');
    AStatusHip := hipMemcpy(@h_S2[0], d_S2, ASizeS, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_S2 failed');
    for I := 0 to K - 1 do
      CheckEquals(RoCGetReal(@h_S[0], I, AKind), RoCGetReal(@h_S2[0], I, AKind),
        ATolEig * 10.0, 'gesvd: singular value ' + IntToStr(I)
        + ' differs for svect=singular');

  finally
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_S) then hipFree(d_S);
    if Assigned(d_S2) then hipFree(d_S2);
    if Assigned(d_U) then hipFree(d_U);
    if Assigned(d_V) then hipFree(d_V);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


procedure TTestRocSolver_EigenSVD.RunGesvdBatched(AKind: TRoCElemKind;
  AStridedBatch: Boolean);
const
  M = RO_SVD_M;
  N = RO_SVD_N;
  K = RO_SVD_N;
  BATCH = 2;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_A: array[0..(BATCH * M * N * 16) - 1] of Byte;
  h_S: array[0..(BATCH * K * 16) - 1] of Byte;
  h_U: array[0..(BATCH * M * M * 16) - 1] of Byte;
  h_V: array[0..(BATCH * N * N * 16) - 1] of Byte;
  h_info: array[0..BATCH - 1] of rocblas_int;
  h_APtrs: array[0..BATCH - 1] of Pointer;
  d_A, d_APtrs, d_S, d_U, d_V, d_E, d_info: Pointer;
  ASizeA, ASizeS, ASizeU, ASizeV, ASizeE, ASizePtrs: size_t;
  AStrideA, AStrideS, AStrideU, AStrideV, AStrideE: rocblas_stride;
  AByteA, AByteS, AByteU, AByteV, AByteE: PtrInt;
  ATolEig, ATolRes, ATolOrth: Double;
  B: Integer;
  AName: string;
begin
  if AStridedBatch then
    AName := 'gesvd_strided_batched'
  else
    AName := 'gesvd_batched';

  d_A := nil;
  d_APtrs := nil;
  d_S := nil;
  d_U := nil;
  d_V := nil;
  d_E := nil;
  d_info := nil;
  AStrideA := M * N;
  AStrideS := K;
  AStrideU := M * M;
  AStrideV := N * N;
  AStrideE := K;
  AByteA := PtrInt(AStrideA) * RoCElemSize(AKind);
  AByteS := PtrInt(AStrideS) * RoCRealSize(AKind);
  AByteU := PtrInt(AStrideU) * RoCElemSize(AKind);
  AByteV := PtrInt(AStrideV) * RoCElemSize(AKind);
  AByteE := PtrInt(AStrideE) * RoCRealSize(AKind);
  ASizeA := BATCH * AByteA;
  ASizeS := BATCH * AByteS;
  ASizeU := BATCH * AByteU;
  ASizeV := BATCH * AByteV;
  ASizeE := BATCH * AByteE;
  ASizePtrs := BATCH * SizeOf(Pointer);
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  { The second matrix of the batch is RO_BATCH_SCALE times the first one, so its
    singular values must be scaled by the same factor. }
  FillChar(h_A, SizeOf(h_A), 0);
  FillChar(h_U, SizeOf(h_U), 0);
  FillChar(h_V, SizeOf(h_V), 0);
  RoCFillSvdMatrix(PByte(@h_A[0]), AKind, 1.0);
  RoCFillSvdMatrix(PByte(@h_A[0]) + AByteA, AKind, RO_BATCH_SCALE);

  try
    AStatusHip := hipMalloc(d_A, ASizeA);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_APtrs, ASizePtrs);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_APtrs failed');
    AStatusHip := hipMalloc(d_S, ASizeS);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_S failed');
    AStatusHip := hipMalloc(d_U, ASizeU);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_U failed');
    AStatusHip := hipMalloc(d_V, ASizeV);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_V failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_info, BATCH * SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    for B := 0 to BATCH - 1 do
      h_APtrs[B] := PByte(d_A) + PtrInt(B) * AByteA;

    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatusHip := hipMemcpy(d_APtrs, @h_APtrs[0], ASizePtrs, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_APtrs failed');

    if AStridedBatch then
      AStatus := CallGesvdStrided(AKind, rocblas_svect_all, rocblas_svect_all,
        d_A, AStrideA, d_S, AStrideS, d_U, AStrideU, d_V, AStrideV, d_E,
        AStrideE, d_info, BATCH)
    else
      AStatus := CallGesvdBatched(AKind, rocblas_svect_all, rocblas_svect_all,
        PhipDeviceptr_t(d_APtrs), d_S, AStrideS, d_U, AStrideU, d_V, AStrideV,
        d_E, AStrideE, d_info, BATCH);

    if AStatus = rocblas_status_not_implemented then
      Ignore(AName + ' is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, AName + ' failed');

    AStatusHip := hipMemcpy(@h_info[0], d_info, BATCH * SizeOf(rocblas_int),
      hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    AStatusHip := hipMemcpy(@h_S[0], d_S, ASizeS, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_S failed');
    AStatusHip := hipMemcpy(@h_U[0], d_U, ASizeU, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_U failed');
    AStatusHip := hipMemcpy(@h_V[0], d_V, ASizeV, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_V failed');

    for B := 0 to BATCH - 1 do
    begin
      CheckEquals(0, h_info[B],
        AName + ': convergence failure in matrix ' + IntToStr(B));
      CheckSvd(AKind,
        PByte(@h_A[0]) + PtrInt(B) * AByteA,
        PByte(@h_S[0]) + PtrInt(B) * AByteS,
        PByte(@h_U[0]) + PtrInt(B) * AByteU,
        PByte(@h_V[0]) + PtrInt(B) * AByteV,
        AName + ' matrix ' + IntToStr(B));
    end;

  finally
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_APtrs) then hipFree(d_APtrs);
    if Assigned(d_S) then hipFree(d_S);
    if Assigned(d_U) then hipFree(d_U);
    if Assigned(d_V) then hipFree(d_V);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;

{ TTestRocSolver_EigenSVD helpers }

procedure TTestRocSolver_EigenSVD.RunTriEigen(AKind: TRoCElemKind; AOp: TRoCTriOp);
const
  N = 4;
  LDC = N;
  ADiag = 2.0;
  AOffDiag = 1.0;
  // Eigenvalues of the tridiagonal matrix with diagonal 2 and off-diagonal 1:
  // 2 + 2*cos(k*pi/(N+1)), k = 1..N, in increasing order.
  AExpected: array[0..N - 1] of Double =
    (0.3819660112501051, 1.3819660112501051,
     2.6180339887498949, 3.6180339887498949);
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_Ds: array[0..N - 1] of Single;
  h_Dd: array[0..N - 1] of Double;
  h_Es: array[0..N - 2] of Single;
  h_Ed: array[0..N - 2] of Double;
  h_C: array[0..(N * LDC * 16) - 1] of Byte;
  h_info: rocblas_int;
  d_D, d_E, d_C, d_info: Pointer;
  ARealHostD, ARealHostE: Pointer;
  ASizeD, ASizeE, ASizeC: size_t;
  i, j: Integer;
  AEigen: Double;
  ANorm, AResRe, AResIm: Double;
  AVRe, AVIm, APrevRe, APrevIm, ANextRe, ANextIm: Double;
  ATolEig, ATolRes: Double;
begin
  d_D := nil;
  d_E := nil;
  d_C := nil;
  d_info := nil;

  if RoCRealSize(AKind) = SizeOf(Double) then
  begin
    ARealHostD := @h_Dd[0];
    ARealHostE := @h_Ed[0];
    ATolEig := 1.0e-10;
    ATolRes := 1.0e-16;
  end
  else
  begin
    ARealHostD := @h_Ds[0];
    ARealHostE := @h_Es[0];
    ATolEig := 1.0e-4;
    ATolRes := 1.0e-6;
  end;

  ASizeD := N * RoCRealSize(AKind);
  ASizeE := (N - 1) * RoCRealSize(AKind);
  ASizeC := N * LDC * RoCElemSize(AKind);

  for i := 0 to N - 1 do
  begin
    h_Ds[i] := ADiag;
    h_Dd[i] := ADiag;
    if i < N - 1 then
    begin
      h_Es[i] := AOffDiag;
      h_Ed[i] := AOffDiag;
    end;
  end;

  // C is an in-out argument: on entry it holds the orthonormal matrix Q of the
  // reduction to tridiagonal form. The input is already tridiagonal, so Q = I.
  FillChar(h_C, SizeOf(h_C), 0);
  for i := 0 to N - 1 do
    RoCSetElem(@h_C[0], i * LDC + i, AKind, 1.0, 0.0);

  try
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_C, ASizeC);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_C failed');
    AStatusHip := hipMalloc(d_info, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    AStatusHip := hipMemcpy(d_D, ARealHostD, ASizeD, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_D failed');
    AStatusHip := hipMemcpy(d_E, ARealHostE, ASizeE, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_E failed');
    AStatusHip := hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_C failed');


    case AOp of
      rtoSteqr:
        case AKind of
          rkSingle:
            AStatus := rocsolver_ssteqr(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
          rkDouble:
            AStatus := rocsolver_dsteqr(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
          rkComplexSingle:
            AStatus := rocsolver_csteqr(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
          rkComplexDouble:
            AStatus := rocsolver_zsteqr(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
        end;
      rtoStedc:
        case AKind of
          rkSingle:
            AStatus := rocsolver_sstedc(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
          rkDouble:
            AStatus := rocsolver_dstedc(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
          rkComplexSingle:
            AStatus := rocsolver_cstedc(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
          rkComplexDouble:
            AStatus := rocsolver_zstedc(FHandle, rocblas_evect_original, N,
              d_D, d_E, d_C, LDC, d_info);
        end;
    end;

    if AStatus = rocblas_status_not_implemented then
      Ignore('The tridiagonal eigensolver is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, 'tridiagonal eigensolver failed');

    AStatusHip := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, 'eigensolver reported a convergence failure');

    AStatusHip := hipMemcpy(ARealHostD, d_D, ASizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_D failed');
    AStatusHip := hipMemcpy(@h_C[0], d_C, ASizeC, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_C failed');

    // 4. Verify the eigenvalues (returned in increasing order).
    for i := 0 to N - 1 do
    begin
      if RoCRealSize(AKind) = SizeOf(Double) then
        AEigen := h_Dd[i]
      else
        AEigen := h_Ds[i];
      CheckEquals(AExpected[i], AEigen, ATolEig,
        'eigenvalue ' + IntToStr(i) + ' is incorrect');
    end;

    // 5. Verify that each column of C is a unit-norm eigenvector.
    for j := 0 to N - 1 do
    begin
      if RoCRealSize(AKind) = SizeOf(Double) then
        AEigen := h_Dd[j]
      else
        AEigen := h_Ds[j];

      ANorm := 0.0;
      for i := 0 to N - 1 do
      begin
        RoCGetElem(@h_C[0], j * LDC + i, AKind, AVRe, AVIm);
        ANorm := ANorm + Sqr(AVRe) + Sqr(AVIm);
      end;
      CheckEquals(1.0, ANorm, ATolEig * 10,
        'eigenvector ' + IntToStr(j) + ' is not normalized');

      for i := 0 to N - 1 do
      begin
        RoCGetElem(@h_C[0], j * LDC + i, AKind, AVRe, AVIm);
        APrevRe := 0.0; APrevIm := 0.0;
        ANextRe := 0.0; ANextIm := 0.0;
        if i > 0 then
          RoCGetElem(@h_C[0], j * LDC + i - 1, AKind, APrevRe, APrevIm);
        if i < N - 1 then
          RoCGetElem(@h_C[0], j * LDC + i + 1, AKind, ANextRe, ANextIm);

        AResRe := (ADiag - AEigen) * AVRe;
        AResIm := (ADiag - AEigen) * AVIm;
        AResRe := AResRe + AOffDiag * APrevRe + AOffDiag * ANextRe;
        AResIm := AResIm + AOffDiag * APrevIm + AOffDiag * ANextIm;
        CheckEquals(0.0, Sqr(AResRe) + Sqr(AResIm), ATolRes,
          'eigenvector ' + IntToStr(j) + ' residual at row ' + IntToStr(i));
      end;
    end;

  finally
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_C) then hipFree(d_C);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


procedure TTestRocSolver_EigenSVD.RunStebz(AKind: TRoCElemKind);
const
  N = 4;
  AExpected: array[0..N - 1] of Double =
    (0.3819660112501051, 1.3819660112501051,
     2.6180339887498949, 3.6180339887498949);
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_Ds: array[0..N - 1] of Single;
  h_Dd: array[0..N - 1] of Double;
  h_Es: array[0..N - 2] of Single;
  h_Ed: array[0..N - 2] of Double;
  h_Ws: array[0..N - 1] of Single;
  h_Wd: array[0..N - 1] of Double;
  h_iblock, h_isplit: array[0..N - 1] of rocblas_int;
  h_nev, h_nsplit, h_info: rocblas_int;
  d_D, d_E, d_W, d_nev, d_nsplit, d_iblock, d_isplit, d_info: Pointer;
  ARealHostD, ARealHostE, ARealHostW: Pointer;
  ASizeD, ASizeE, ASizeW, ASizeInt: size_t;
  i: Integer;
  AValue, ATolEig: Double;
begin
  d_D := nil;
  d_E := nil;
  d_W := nil;
  d_nev := nil;
  d_nsplit := nil;
  d_iblock := nil;
  d_isplit := nil;
  d_info := nil;

  if RoCRealSize(AKind) = SizeOf(Double) then
  begin
    ARealHostD := @h_Dd[0];
    ARealHostE := @h_Ed[0];
    ARealHostW := @h_Wd[0];
    ATolEig := 1.0e-10;
  end
  else
  begin
    ARealHostD := @h_Ds[0];
    ARealHostE := @h_Es[0];
    ARealHostW := @h_Ws[0];
    ATolEig := 1.0e-4;
  end;

  ASizeD := N * RoCRealSize(AKind);
  ASizeE := (N - 1) * RoCRealSize(AKind);
  ASizeW := N * RoCRealSize(AKind);
  ASizeInt := N * SizeOf(rocblas_int);

  for i := 0 to N - 1 do
  begin
    h_Ds[i] := 2.0;
    h_Dd[i] := 2.0;
    if i < N - 1 then
    begin
      h_Es[i] := 1.0;
      h_Ed[i] := 1.0;
    end;
  end;

  try
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_W, ASizeW);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_W failed');
    AStatusHip := hipMalloc(d_nev, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_nev failed');
    AStatusHip := hipMalloc(d_nsplit, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_nsplit failed');
    AStatusHip := hipMalloc(d_iblock, ASizeInt);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_iblock failed');
    AStatusHip := hipMalloc(d_isplit, ASizeInt);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_isplit failed');
    AStatusHip := hipMalloc(d_info, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    AStatusHip := hipMemcpy(d_D, ARealHostD, ASizeD, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_D failed');
    AStatusHip := hipMemcpy(d_E, ARealHostE, ASizeE, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_E failed');

    // A value outside the rocblas_erange_* range must be rejected. This is the
    // failure mode of the old Pascal constants (1071 etc.).
    if AKind = rkDouble then
      AStatus := rocsolver_dstebz(FHandle, 1071, rocblas_eorder_entire,
        N, 0.0, 0.0, 1, N, 0.0, d_D, d_E, d_nev, d_nsplit, d_W,
        d_iblock, d_isplit, d_info)
    else
      AStatus := rocsolver_sstebz(FHandle, 1071, rocblas_eorder_entire,
        N, 0.0, 0.0, 1, N, 0.0, d_D, d_E, d_nev, d_nsplit, d_W,
        d_iblock, d_isplit, d_info);
    CheckEquals(rocblas_status_invalid_value, AStatus,
      'stebz must reject an erange value outside rocblas_erange_*');


    // (a) All eigenvalues, ordered over the entire matrix.
    if AKind = rkDouble then
      AStatus := rocsolver_dstebz(FHandle, rocblas_erange_all,
        rocblas_eorder_entire, N, 0.0, 0.0, 1, N, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info)
    else
      AStatus := rocsolver_sstebz(FHandle, rocblas_erange_all,
        rocblas_eorder_entire, N, 0.0, 0.0, 1, N, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'stebz (erange=all) failed');

    hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(@h_nsplit, d_nsplit, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(ARealHostW, d_W, ASizeW, hipMemcpyDeviceToHost);
    hipMemcpy(@h_iblock[0], d_iblock, ASizeInt, hipMemcpyDeviceToHost);
    CheckEquals(0, h_info, 'stebz (erange=all) returned info <> 0');
    CheckEquals(N, h_nev, 'stebz (erange=all) found the wrong number of eigenvalues');
    CheckEquals(1, h_nsplit, 'the tridiagonal matrix should not split into blocks');
    for i := 0 to N - 1 do
    begin
      if RoCRealSize(AKind) = SizeOf(Double) then
        AValue := h_Wd[i]
      else
        AValue := h_Ws[i];
      CheckEquals(AExpected[i], AValue, ATolEig,
        'stebz (erange=all) eigenvalue ' + IntToStr(i) + ' is incorrect');
      CheckEquals(1, h_iblock[i],
        'stebz (erange=all) eigenvalue ' + IntToStr(i) + ' has the wrong block index');
    end;

    // (b) Eigenvalues il..iu (1-based), ordered over the entire matrix.
    if AKind = rkDouble then
      AStatus := rocsolver_dstebz(FHandle, rocblas_erange_index,
        rocblas_eorder_entire, N, 0.0, 0.0, 2, 3, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info)
    else
      AStatus := rocsolver_sstebz(FHandle, rocblas_erange_index,
        rocblas_eorder_entire, N, 0.0, 0.0, 2, 3, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'stebz (erange=index) failed');

    hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(ARealHostW, d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(0, h_info, 'stebz (erange=index) returned info <> 0');
    CheckEquals(2, h_nev, 'stebz (erange=index) found the wrong number of eigenvalues');
    for i := 0 to 1 do
    begin
      if RoCRealSize(AKind) = SizeOf(Double) then
        AValue := h_Wd[i]
      else
        AValue := h_Ws[i];
      CheckEquals(AExpected[i + 1], AValue, ATolEig,
        'stebz (erange=index) eigenvalue ' + IntToStr(i) + ' is incorrect');
    end;

    // (c) Eigenvalues in the half-open interval (1, 3]. AExpected[1] and
    // AExpected[2] are the only ones strictly greater than 1 and at most 3.
    if AKind = rkDouble then
      AStatus := rocsolver_dstebz(FHandle, rocblas_erange_value,
        rocblas_eorder_entire, N, 1.0, 3.0, 1, N, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info)
    else
      AStatus := rocsolver_sstebz(FHandle, rocblas_erange_value,
        rocblas_eorder_entire, N, 1.0, 3.0, 1, N, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'stebz (erange=value) failed');

    hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(ARealHostW, d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(0, h_info, 'stebz (erange=value) returned info <> 0');
    CheckEquals(2, h_nev, 'stebz (erange=value) found the wrong number of eigenvalues');
    for i := 0 to 1 do
    begin
      if RoCRealSize(AKind) = SizeOf(Double) then
        AValue := h_Wd[i]
      else
        AValue := h_Ws[i];
      CheckEquals(AExpected[i + 1], AValue, ATolEig,
        'stebz (erange=value) eigenvalue ' + IntToStr(i) + ' is incorrect');
    end;

  finally
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_W) then hipFree(d_W);
    if Assigned(d_nev) then hipFree(d_nev);
    if Assigned(d_nsplit) then hipFree(d_nsplit);
    if Assigned(d_iblock) then hipFree(d_iblock);
    if Assigned(d_isplit) then hipFree(d_isplit);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


procedure TTestRocSolver_EigenSVD.RunStein(AKind: TRoCElemKind);
const
  N = 4;
  LDZ = N;
  ADiag = 2.0;
  AOffDiag = 1.0;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_Ds: array[0..N - 1] of Single;
  h_Dd: array[0..N - 1] of Double;
  h_Es: array[0..N - 2] of Single;
  h_Ed: array[0..N - 2] of Double;
  h_Ws: array[0..N - 1] of Single;
  h_Wd: array[0..N - 1] of Double;
  h_iblock, h_isplit, h_ifail: array[0..N - 1] of rocblas_int;
  h_Z: array[0..(N * LDZ * 16) - 1] of Byte;
  h_nev, h_info: rocblas_int;
  d_D, d_E, d_W, d_nev, d_nsplit, d_iblock, d_isplit, d_Z, d_ifail, d_info: Pointer;
  ARealHostD, ARealHostE, ARealHostW: Pointer;
  ASizeD, ASizeE, ASizeW, ASizeZ, ASizeInt: size_t;
  i, j: Integer;
  AEigen, ANorm, AResRe, AResIm: Double;
  AVRe, AVIm, APrevRe, APrevIm, ANextRe, ANextIm: Double;
  ATolEig, ATolRes: Double;
begin
  d_D := nil;
  d_E := nil;
  d_W := nil;
  d_nev := nil;
  d_nsplit := nil;
  d_iblock := nil;
  d_isplit := nil;
  d_Z := nil;
  d_ifail := nil;
  d_info := nil;

  if RoCRealSize(AKind) = SizeOf(Double) then
  begin
    ARealHostD := @h_Dd[0];
    ARealHostE := @h_Ed[0];
    ARealHostW := @h_Wd[0];
    ATolEig := 1.0e-10;
    ATolRes := 1.0e-16;
  end
  else
  begin
    ARealHostD := @h_Ds[0];
    ARealHostE := @h_Es[0];
    ARealHostW := @h_Ws[0];
    ATolEig := 1.0e-4;
    ATolRes := 1.0e-6;
  end;

  ASizeD := N * RoCRealSize(AKind);
  ASizeE := (N - 1) * RoCRealSize(AKind);
  ASizeW := N * RoCRealSize(AKind);
  ASizeZ := N * LDZ * RoCElemSize(AKind);
  ASizeInt := N * SizeOf(rocblas_int);

  for i := 0 to N - 1 do
  begin
    h_Ds[i] := ADiag;
    h_Dd[i] := ADiag;
    if i < N - 1 then
    begin
      h_Es[i] := AOffDiag;
      h_Ed[i] := AOffDiag;
    end;
  end;
  FillChar(h_Z, SizeOf(h_Z), 0);

  try
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_W, ASizeW);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_W failed');
    AStatusHip := hipMalloc(d_nev, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_nev failed');
    AStatusHip := hipMalloc(d_nsplit, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_nsplit failed');
    AStatusHip := hipMalloc(d_iblock, ASizeInt);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_iblock failed');
    AStatusHip := hipMalloc(d_isplit, ASizeInt);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_isplit failed');
    AStatusHip := hipMalloc(d_Z, ASizeZ);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_Z failed');
    AStatusHip := hipMalloc(d_ifail, ASizeInt);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_ifail failed');
    AStatusHip := hipMalloc(d_info, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    AStatusHip := hipMemcpy(d_D, ARealHostD, ASizeD, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_D failed');
    AStatusHip := hipMemcpy(d_E, ARealHostE, ASizeE, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_E failed');

    // STEIN requires the eigenvalues, blocks and splits produced by STEBZ.
    if RoCRealSize(AKind) = SizeOf(Double) then
      AStatus := rocsolver_dstebz(FHandle, rocblas_erange_all,
        rocblas_eorder_entire, N, 0.0, 0.0, 1, N, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info)
    else
      AStatus := rocsolver_sstebz(FHandle, rocblas_erange_all,
        rocblas_eorder_entire, N, 0.0, 0.0, 1, N, 0.0, d_D, d_E, d_nev,
        d_nsplit, d_W, d_iblock, d_isplit, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'stebz prerequisite failed');


    hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(N, h_nev, 'stebz prerequisite found the wrong number of eigenvalues');

    case AKind of
      rkSingle:
        AStatus := rocsolver_sstein(FHandle, N, d_D, d_E, d_nev, d_W,
          d_iblock, d_isplit, d_Z, LDZ, d_ifail, d_info);
      rkDouble:
        AStatus := rocsolver_dstein(FHandle, N, d_D, d_E, d_nev, d_W,
          d_iblock, d_isplit, d_Z, LDZ, d_ifail, d_info);
      rkComplexSingle:
        AStatus := rocsolver_cstein(FHandle, N, d_D, d_E, d_nev, d_W,
          d_iblock, d_isplit, d_Z, LDZ, d_ifail, d_info);
      rkComplexDouble:
        AStatus := rocsolver_zstein(FHandle, N, d_D, d_E, d_nev, d_W,
          d_iblock, d_isplit, d_Z, LDZ, d_ifail, d_info);
    end;

    if AStatus = rocblas_status_not_implemented then
      Ignore('STEIN is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, 'stein failed');

    hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    hipMemcpy(@h_ifail[0], d_ifail, ASizeInt, hipMemcpyDeviceToHost);
    hipMemcpy(ARealHostW, d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(0, h_info, 'stein reported a convergence failure');
    for i := 0 to N - 1 do
      CheckEquals(0, h_ifail[i],
        'stein reported that eigenvector ' + IntToStr(i) + ' did not converge');

    AStatusHip := hipMemcpy(@h_Z[0], d_Z, ASizeZ, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_Z failed');

    // Verify that each column of Z is a unit-norm eigenvector of T.
    for j := 0 to N - 1 do
    begin
      if RoCRealSize(AKind) = SizeOf(Double) then
        AEigen := h_Wd[j]
      else
        AEigen := h_Ws[j];

      ANorm := 0.0;
      for i := 0 to N - 1 do
      begin
        RoCGetElem(@h_Z[0], j * LDZ + i, AKind, AVRe, AVIm);
        ANorm := ANorm + Sqr(AVRe) + Sqr(AVIm);
      end;
      CheckEquals(1.0, ANorm, ATolEig * 100,
        'stein eigenvector ' + IntToStr(j) + ' is not normalized');

      for i := 0 to N - 1 do
      begin
        RoCGetElem(@h_Z[0], j * LDZ + i, AKind, AVRe, AVIm);
        APrevRe := 0.0; APrevIm := 0.0;
        ANextRe := 0.0; ANextIm := 0.0;
        if i > 0 then
          RoCGetElem(@h_Z[0], j * LDZ + i - 1, AKind, APrevRe, APrevIm);
        if i < N - 1 then
          RoCGetElem(@h_Z[0], j * LDZ + i + 1, AKind, ANextRe, ANextIm);

        AResRe := (ADiag - AEigen) * AVRe;
        AResIm := (ADiag - AEigen) * AVIm;
        AResRe := AResRe + AOffDiag * APrevRe + AOffDiag * ANextRe;
        AResIm := AResIm + AOffDiag * APrevIm + AOffDiag * ANextIm;
        CheckEquals(0.0, Sqr(AResRe) + Sqr(AResIm), ATolRes,
          'stein eigenvector ' + IntToStr(j) + ' residual at row ' + IntToStr(i));
      end;
    end;

  finally
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_W) then hipFree(d_W);
    if Assigned(d_nev) then hipFree(d_nev);
    if Assigned(d_nsplit) then hipFree(d_nsplit);
    if Assigned(d_iblock) then hipFree(d_iblock);
    if Assigned(d_isplit) then hipFree(d_isplit);
    if Assigned(d_Z) then hipFree(d_Z);
    if Assigned(d_ifail) then hipFree(d_ifail);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;



procedure TTestRocSolver_EigenSVD.CheckEigDecomposition(AKind: TRoCElemKind;
  const AOriginal, AD, AV: PByte; const AScale: Double; const ACase: string);
const
  N = RO_EIG_N;
  { Trace of the unscaled test matrix produced by RoCFillSymMatrix. }
  ATrace = 18.0;
var
  I, J, K: Integer;
  ATolEig, ATolRes, ATolOrth: Double;
  ASum, ANorm, ADot, AEigen: Double;
  AReI, AImI, AReJ, AImJ, AAik, AResRe, AResIm: Double;
begin
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  { 1. The eigenvalues must be returned in increasing order. }
  for I := 1 to N - 1 do
    CheckTrue(RoCGetReal(AD, I, AKind) >= RoCGetReal(AD, I - 1, AKind) - ATolEig,
      ACase + ': eigenvalues are not returned in increasing order');

  { 2. The eigenvalues must sum to the trace of the matrix. }
  ASum := 0.0;
  for I := 0 to N - 1 do
    ASum := ASum + RoCGetReal(AD, I, AKind);
  CheckEquals(ATrace * AScale, ASum, ATolEig * 100.0 * Max(1.0, AScale),
    ACase + ': the eigenvalues do not sum to the trace of the matrix');

  for J := 0 to N - 1 do
  begin
    AEigen := RoCGetReal(AD, J, AKind);

    { 3. Each eigenvector must have unit norm ... }
    ANorm := 0.0;
    for I := 0 to N - 1 do
    begin
      RoCGetElem(AV, J * N + I, AKind, AReI, AImI);
      ANorm := ANorm + Sqr(AReI) + Sqr(AImI);
    end;
    CheckEquals(1.0, ANorm, ATolOrth,
      ACase + ': eigenvector ' + IntToStr(J) + ' is not normalized');

    { 4. ... and be orthogonal to the eigenvectors before it. }
    for K := 0 to J - 1 do
    begin
      ADot := 0.0;
      for I := 0 to N - 1 do
      begin
        RoCGetElem(AV, J * N + I, AKind, AReI, AImI);
        RoCGetElem(AV, K * N + I, AKind, AReJ, AImJ);
        ADot := ADot + AReI * AReJ + AImI * AImJ;
      end;
      CheckEquals(0.0, ADot, ATolOrth, ACase + ': eigenvectors '
        + IntToStr(J) + ' and ' + IntToStr(K) + ' are not orthogonal');
    end;

    { 5. The defining relation A*v = lambda*v must hold. }
    for I := 0 to N - 1 do
    begin
      AResRe := 0.0;
      AResIm := 0.0;
      for K := 0 to N - 1 do
      begin
        RoCGetElem(AOriginal, K * N + I, AKind, AAik, AImJ);
        RoCGetElem(AV, J * N + K, AKind, AReJ, AImJ);
        AResRe := AResRe + AAik * AReJ;
        AResIm := AResIm + AAik * AImJ;
      end;
      RoCGetElem(AV, J * N + I, AKind, AReI, AImI);
      AResRe := AResRe - AEigen * AReI;
      AResIm := AResIm - AEigen * AImI;
      CheckEquals(0.0, Sqr(AResRe) + Sqr(AResIm), ATolRes,
        ACase + ': residual of eigenvector ' + IntToStr(J)
        + ' at row ' + IntToStr(I));
    end;
  end;
end;


function TTestRocSolver_EigenSVD.CallSyev(AKind: TRoCElemKind;
  AOp: TRoCSyevOp; AEvect: rocblas_evect; AUplo: rocblas_fill;
  A, D, E, AInfo: Pointer): rocsolver_status;
const
  N = RO_EIG_N;
begin
  case AKind of
    rkSingle:
      if AOp = rsoSyev then
        Result := rocsolver_ssyev(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo)
      else
        Result := rocsolver_ssyevd(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo);
    rkDouble:
      if AOp = rsoSyev then
        Result := rocsolver_dsyev(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo)
      else
        Result := rocsolver_dsyevd(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo);
    rkComplexSingle:
      if AOp = rsoSyev then
        Result := rocsolver_cheev(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo)
      else
        Result := rocsolver_cheevd(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo);
    rkComplexDouble:
      if AOp = rsoSyev then
        Result := rocsolver_zheev(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo)
      else
        Result := rocsolver_zheevd(FHandle, AEvect, AUplo, N, A, N, D, E, AInfo);
    else
      Result := rocblas_status_invalid_value;
  end;
end;


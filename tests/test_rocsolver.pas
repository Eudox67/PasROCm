procedure TTestRocSolver_Inversion.Test_rocsolver_sgetri;
const
  N = 3;
  LDA = N;
var
  h_A, h_A_orig, h_C: array[0..N-1, 0..N-1] of Single;
  h_ipiv: array[0..N-1] of rocblas_int;
  h_info: rocblas_int;
  d_A, d_ipiv, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k: Integer;
  sum: Single;
begin
  // 1. Initialize test data on the host
  h_A[0,0] := 4.0; h_A[0,1] := 1.0; h_A[0,2] := 2.0;
  h_A[1,0] := 1.0; h_A[1,1] := 2.0; h_A[1,2] := 1.0;
  h_A[2,0] := 1.0; h_A[2,1] := 3.0; h_A[2,2] := 5.0;
  h_A_orig := h_A; // Keep a copy for verification
  h_info := 0;

  // 2. Allocate memory on the device
  hipStatus := hipMalloc(d_A, N * LDA * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_ipiv, N * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_ipiv failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 3. Copy data from host to device
  hipStatus := hipMemcpy(d_A, @h_A[0,0], N * LDA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');

  // 4. Perform LU factorization (pre-requisite for getri)
  AStatus := rocsolver_sgetrf(FHandle, N, N, d_A, LDA, d_ipiv, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetrf failed');

  // 5. Call the target function to compute the inverse
  AStatus := rocsolver_sgetri(FHandle, N, d_A, LDA, d_ipiv, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetri failed');

  // 6. Verify results
  hipStatus := hipMemcpy(@h_A[0,0], d_A, N * LDA * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_A to h_A failed');
  hipStatus := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_info to h_info failed');

  CheckEquals(0, h_info, 'sgetri info should be 0 on success');

  // Verification: Multiply original matrix by its computed inverse. Result should be identity matrix.
  for i := 0 to N-1 do
  begin
    for j := 0 to N-1 do
    begin
      sum := 0.0;
      for k := 0 to N-1 do
      begin
        sum := sum + h_A_orig[i,k] * h_A[k,j];
      end;
      h_C[i,j] := sum;
    end;
  end;

  for i := 0 to N-1 do
  begin
    for j := 0 to N-1 do
    begin
      if i = j then
        CheckEquals(1.0, h_C[i,j], 1e-6, 'Identity matrix diagonal element C['+IntToStr(i)+','+IntToStr(j)+']')
      else
        CheckEquals(0.0, h_C[i,j], 1e-6, 'Identity matrix off-diagonal element C['+IntToStr(i)+','+IntToStr(j)+']');
    end;
  end;


  // 7. Cleanup
  hipStatus := hipFree(d_A);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_A failed');
  hipStatus := hipFree(d_ipiv);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_ipiv failed');
  hipStatus := hipFree(d_info);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_info failed');
end;


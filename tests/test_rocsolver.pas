  SetLength(h_B, LDB * NRHS);
  SetLength(h_X, LDB * NRHS);

  // Hermitian Positive Definite Matrix A
  // A = [ 4,   2+2i, 2-2i]
  //     [2-2i, 10,   7+3i]
  //     [2+2i, 7-3i, 21  ]
  h_A[0].x := 4;  h_A[0].y := 0;  h_A[1].x := 2;  h_A[1].y := -2; h_A[2].x := 2;  h_A[2].y := 2;
  h_A[3].x := 2;  h_A[3].y := 2;  h_A[4].x := 10; h_A[4].y := 0;  h_A[5].x := 7;  h_A[5].y := -3;
  h_A[6].x := 2;  h_A[6].y := -2; h_A[7].x := 7;  h_A[7].y := 3;  h_A[8].x := 21; h_A[8].y := 0;
  Move(h_A[0], h_A_orig[0], LDA * N * SizeOf(rocblas_float_complex));

  // B = [18+4i]
  //     [49-5i]
  //     [93+13i]
  // Solution X should be [2, 1+i, 3-i]
  h_B[0].x := 18; h_B[0].y := 4;
  h_B[1].x := 49; h_B[1].y := -5;
  h_B[2].x := 93; h_B[2].y := 13;

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, LDA * N * SizeOf(rocblas_float_complex));

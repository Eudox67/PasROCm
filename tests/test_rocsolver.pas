  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy failed');
  AStatus := rocsolver_strtri_batched(FHandle, uplo, diag, N, d_A_ptrs, LDA, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'Test Run: rocsolver_strtri_batched failed');
  hipStatus := hipMemcpy(@h_A_result[0], d_A_batch, batch_size_bytes, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy back to h_A_result failed');
  hipStatus := hipMemcpy(@h_info_result[0], d_info, BATCH_COUNT * SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy back to h_info_result failed');

  // 3. Verification
  Check(CompareMem(@h_info_golden[0], @h_info_result[0], BATCH_COUNT * SizeOf(rocblas_int)), 'Info arrays mismatch');
  Check(CompareMem(@h_A_golden[0], @h_A_result[0], batch_size_bytes), 'Matrix data mismatch');

  // 4. Cleanup
  hipStatus := hipFree(d_A_batch);  CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info);     CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_A_ptrs);   CheckEquals(HIP_SUCCESS, hipStatus);

  AStatusSolver := rocsolver_zlarft(FHandle, rocblas_forward_direction, rocblas_storev_column_wise, N, K, d_A, LDA, d_tau, d_T, LDT);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_zlarft failed');

  // 5. Copy results
  hipMemcpy(@h_tau_result[0], d_tau, ASizeTau, hipMemcpyDeviceToHost);
  hipMemcpy(@h_T_result[0], d_T, ASizeT, hipMemcpyDeviceToHost);

  // 6. Verify diagonal elements
  if AStatusSolver = rocblas_status_success then
  begin
    CheckEquals(h_tau_result[0].x, h_T_result[0].x, 1e-12, 'T(0,0).x should be tau[0].x');
    CheckEquals(h_tau_result[0].y, h_T_result[0].y, 1e-12, 'T(0,0).y should be tau[0].y');
    CheckEquals(h_tau_result[1].x, h_T_result[1+1*LDT].x, 1e-12, 'T(1,1).x should be tau[1].x');
    CheckEquals(h_tau_result[1].y, h_T_result[1+1*LDT].y, 1e-12, 'T(1,1).y should be tau[1].y');
  end;

  // 7. Cleanup
  if Assigned(d_A) then hipFree(d_A);
  if Assigned(d_tau) then hipFree(d_tau);
  if Assigned(d_T) then hipFree(d_T);
end;

procedure TTestRocSolver_Auxiliary.Test_rocsolver_slarf;
const
  M = 4;
  N = 3;
  LDA = M;
  incx = 1;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_C, h_C_gold, h_C_result: array[0..LDA * N - 1] of Single;
  h_x: array[0..M - 1] of Single;
  h_alpha, h_tau: Single;
  d_C, d_x, d_tau: Pointer;
  ASizeC, ASizeX, ASizeTau: size_t;
  i, j: Integer;
  work: array[0..N-1] of Single;
begin
  // 1. Initialize host data
  ASizeC := LDA * N * SizeOf(Single);
  ASizeX := M * SizeOf(Single);
  ASizeTau := SizeOf(Single);

  for j := 0 to N - 1 do
    for i := 0 to M - 1 do
      h_C[i + j * LDA] := 1.0 + i + j * M;
  Move(h_C, h_C_gold, ASizeC);

  for i := 0 to M - 1 do
    h_x[i] := 1.0 + i;

  // 2. Allocate device memory
  d_C := nil; d_x := nil; d_tau := nil;
  hipMalloc(d_C, ASizeC); hipMalloc(d_x, ASizeX); hipMalloc(d_tau, ASizeTau);

  // 3. Generate a valid reflector v and tau using slarfg
  // The first element of x is alpha for slarfg, the rest is the vector part
  h_alpha := h_x[0];
  hipMemcpy(d_x, @h_x[1], (M-1) * SizeOf(Single), hipMemcpyHostToDevice);
  hipMemcpy(d_tau, @h_alpha, SizeOf(Single), hipMemcpyHostToDevice); // Use d_tau as temp for alpha
  AStatusSolver := rocsolver_slarfg(FHandle, M, d_tau, d_x, incx, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite slarfg failed');
  // Copy back the resulting reflector vector v and scalar tau
  hipMemcpy(@h_x[1], d_x, (M-1) * SizeOf(Single), hipMemcpyDeviceToHost);
  hipMemcpy(@h_tau, d_tau, SizeOf(Single), hipMemcpyDeviceToHost);
  h_x[0] := 1.0; // Per LAPACK, v(1) is implicitly 1

  // 4. Calculate golden result on CPU: C = C - tau * v * (v' * C)
  // a) work = v' * C
  for j := 0 to N - 1 do
  begin
    work[j] := 0;
    for i := 0 to M - 1 do
      work[j] := work[j] + h_x[i] * h_C_gold[i + j * LDA];
  end;
  // b) C_gold = C_gold - tau * v * work
  for j := 0 to N - 1 do
    for i := 0 to M - 1 do
      h_C_gold[i + j * LDA] := h_C_gold[i + j * LDA] - h_tau * h_x[i] * work[j];

  // 5. Copy data for slarf to device
  hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice);
  hipMemcpy(d_x, @h_x[0], ASizeX, hipMemcpyHostToDevice); // Full reflector vector v
  hipMemcpy(d_tau, @h_tau, ASizeTau, hipMemcpyHostToDevice);

  // 6. Call rocsolver_slarf
  AStatusSolver := rocsolver_slarf(FHandle, rocblas_side_left, M, N, d_x, incx, d_tau, d_C, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_slarf failed');

  // 7. Copy result back
  hipMemcpy(@h_C_result[0], d_C, ASizeC, hipMemcpyDeviceToHost);

  // 8. Verify
  if AStatusSolver = rocblas_status_success then
  begin
    for i := 0 to LDA * N - 1 do
      CheckEquals(h_C_gold[i], h_C_result[i], 1e-5, 'Mismatch at index ' + IntToStr(i));
  end;

  // 9. Cleanup
  if Assigned(d_C) then hipFree(d_C);
  if Assigned(d_x) then hipFree(d_x);
  if Assigned(d_tau) then hipFree(d_tau);
end;


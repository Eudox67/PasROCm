procedure TTestRocSolver_Auxiliary.Test_rocsolver_slauum;
const
  N = 3; LDA = N;
var
  AStatusSolver: rocsolver_status;
  h_A, h_A_gold, h_result: array of Single;
  d_A: Pointer; ASizeA: size_t; i, j, k: Integer; sum: Double;
begin
  ASizeA := LDA * N * SizeOf(Single);
  SetLength(h_A, LDA * N); SetLength(h_A_gold, LDA * N); SetLength(h_result, LDA * N);
  d_A := nil; hipMalloc(d_A, ASizeA);

  // --- CASE 1: UPLO = 'U' (A = U * U') ---
  for j := 0 to N-1 do for i := 0 to j do h_A[i+j*LDA] := i+j+2; // Init only upper
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);

  // CPU Golden Calculation for U*U'
  for j := 0 to N-1 do for i := 0 to j do begin
    sum := 0;
    for k := j to N-1 do sum := sum + h_A[i+k*LDA] * h_A[j+k*LDA];
    h_A_gold[i+j*LDA] := sum;
  end;

  AStatusSolver := rocsolver_slauum(FHandle, rocblas_fill_upper, N, d_A, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'uplo=U failed');
  hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  if AStatusSolver=rocblas_status_success then for j:=0 to N-1 do for i:=0 to j do
    CheckEquals(h_A_gold[i+j*LDA], h_result[i+j*LDA], 1e-5, Format('U*U'' mismatch at (%d,%d)',[i,j]));

  // --- CASE 2: UPLO = 'L' (A = L' * L) ---
  for j := 0 to N-1 do for i := j to N-1 do h_A[i+j*LDA] := i+j+2; // Init only lower
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);

  // CPU Golden Calculation for L'*L
  for j := 0 to N-1 do for i := j to N-1 do begin
    sum := 0;
    for k := i to N-1 do sum := sum + h_A[k+i*LDA] * h_A[k+j*LDA];
    h_A_gold[i+j*LDA] := sum;
  end;

  AStatusSolver := rocsolver_slauum(FHandle, rocblas_fill_lower, N, d_A, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'uplo=L failed');
  hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  if AStatusSolver=rocblas_status_success then for j:=0 to N-1 do for i:=j to N-1 do
    CheckEquals(h_A_gold[i+j*LDA], h_result[i+j*LDA], 1e-5, Format('L''*L mismatch at (%d,%d)',[i,j]));

  if Assigned(d_A) then hipFree(d_A);
end;


procedure TTestRocSolver_Auxiliary.Test_rocsolver_slabrd;
const
  M = 5;
  N = 4;
  K = 3; // k <= min(m,n)
  LDA = M;
  LDX = M;
  LDY = N;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_A: array of Single;
  h_D_result: array of Single;
  d_A, d_D, d_E, d_tauq, d_taup, d_X, d_Y: Pointer;
  ASizeA, ASizeD, ASizeE, ASizeTau, ASizeX, ASizeY: size_t;
  i, j: Integer;
begin
  // 1. Initialize sizes and host data
  ASizeA := LDA * N * SizeOf(Single);
  ASizeD := K * SizeOf(Single);
  ASizeE := K * SizeOf(Single); // size k is safe
  ASizeTau := K * SizeOf(Single);
  ASizeX := LDX * K * SizeOf(Single);
  ASizeY := LDY * K * SizeOf(Single);
  SetLength(h_A, LDA * N);
  SetLength(h_D_result, K);

  for j := 0 to N - 1 do
    for i := 0 to M - 1 do
      h_A[i + j * LDA] := 1.0 + i + j * M;

  // 2. Allocate all device memory
  d_A := nil; d_D := nil; d_E := nil; d_tauq := nil; d_taup := nil; d_X := nil; d_Y := nil;
  hipMalloc(d_A, ASizeA); hipMalloc(d_D, ASizeD); hipMalloc(d_E, ASizeE);
  hipMalloc(d_tauq, ASizeTau); hipMalloc(d_taup, ASizeTau);
  hipMalloc(d_X, ASizeX); hipMalloc(d_Y, ASizeY);

  // 3. Copy input matrix A to device
  AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');

  // 4. Call rocsolver_slabrd with retry logic
  AStatusSolver := rocsolver_slabrd(FHandle, M, N, K, d_A, LDA, d_D, d_E, d_tauq, d_taup, d_X, LDX, d_Y, LDY);
  if AStatusSolver = rocblas_status_size_increased then
    AStatusSolver := rocsolver_slabrd(FHandle, M, N, K, d_A, LDA, d_D, d_E, d_tauq, d_taup, d_X, LDX, d_Y, LDY);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_slabrd failed');

  // 5. Copy a result back for a basic sanity check
  AStatusHip := hipMemcpy(@h_D_result[0], d_D, ASizeD, hipMemcpyDeviceToHost);

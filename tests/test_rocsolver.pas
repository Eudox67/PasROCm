    // Verify
    for i := 0 to (strideA * batch_count) - 1 do
    begin
      CheckEquals(h_A_golden[i].x, h_A_result[i].x, 1e-12, Format('Mismatch in A.x at index %d for uplo=%d', [i, uplo]));
      CheckEquals(h_A_golden[i].y, h_A_result[i].y, 1e-12, Format('Mismatch in A.y at index %d for uplo=%d', [i, uplo]));
    end;

procedure TTestRocSolver_Factorizations.Test_rocsolver_sgetrf_npvt;
const
  m = 10;
  n = 8;
  lda = m;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A, h_A_res: array of Single;
  h_info: rocblas_int;
  d_A, d_info: hipDeviceptr_t;
  sizeA, sizeInfo: size_t;
  i, j: Integer;
begin
  // 1. Setup
  sizeA := m * n * SizeOf(Single);
  sizeInfo := SizeOf(rocblas_int);

  SetLength(h_A, m * n);
  SetLength(h_A_res, m * n);
  h_info := -1; // Initialize to a sentinel value

  // Initialize a diagonally dominant matrix (non-singular) in column-major order
  for j := 0 to n - 1 do
  begin
    for i := 0 to m - 1 do
    begin
      if i = j then
        h_A[i + j * lda] := 20.0
      else
        h_A[i + j * lda] := 1.0;
    end;
  end;

  d_A := nil;
  d_info := nil;
  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_info, sizeInfo);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_info');

  try
    // 2. Transfer data to device
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A');

    // 3. Execute rocSOLVER function
    AStatus := rocsolver_sgetrf_npvt(FHandle, m, n, d_A, lda, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetrf_npvt');

    // 4. Transfer results back to host
    AhipStatus := hipMemcpy(@h_info, d_info, sizeInfo, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H info');
    AhipStatus := hipMemcpy(@h_A_res[0], d_A, sizeA, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H A_res');

    // 5. Verification
    CheckEquals(0, h_info, 'info should be 0 for a successful factorization');
    Check(h_A_res[1] <> h_A[1], 'Result matrix A should be modified'); // Check A[1,0]

  finally
    // 6. Cleanup
    if d_A <> nil then hipFree(d_A);
    if d_info <> nil then hipFree(d_info);
  end;
end;


procedure TTestRocSolver_EigenSVD.RunSyev(AKind: TRoCElemKind; AOp: TRoCSyevOp);
const
  N = RO_EIG_N;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_A, h_V: array[0..(N * N * 16) - 1] of Byte;
  h_D, h_D2: array[0..(N * 16) - 1] of Byte;
  h_info: rocblas_int;
  d_A, d_D, d_E, d_info: Pointer;
  ASizeA, ASizeD, ASizeE: size_t;
  ATolEig, ATolRes, ATolOrth: Double;
  I: Integer;
  AName: string;
begin
  if AOp = rsoSyev then
    AName := 'syev'
  else
    AName := 'syevd';

  d_A := nil;
  d_D := nil;
  d_E := nil;
  d_info := nil;
  ASizeA := N * N * RoCElemSize(AKind);
  ASizeD := N * RoCRealSize(AKind);
  ASizeE := N * RoCRealSize(AKind);
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  FillChar(h_A, SizeOf(h_A), 0);
  RoCFillSymMatrix(@h_A[0], AKind, 1.0);

  try
    AStatusHip := hipMalloc(d_A, ASizeA);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_info, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    { 1. Compute all eigenvalues and eigenvectors. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');

    AStatus := CallSyev(AKind, AOp, rocblas_evect_original, rocblas_fill_lower,
      d_A, d_D, d_E, d_info);
    if AStatus = rocblas_status_not_implemented then
      Ignore(AName + ' is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, AName + ' failed');

    AStatusHip := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, AName + ' reported a convergence failure');

    AStatusHip := hipMemcpy(@h_D[0], d_D, ASizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_D failed');
    AStatusHip := hipMemcpy(@h_V[0], d_A, ASizeA, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_A failed');

    CheckEigDecomposition(AKind, PByte(@h_A[0]), PByte(@h_D[0]), PByte(@h_V[0]),
      1.0, AName);

    { 2. evect = none must return exactly the same eigenvalues. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallSyev(AKind, AOp, rocblas_evect_none, rocblas_fill_lower,
      d_A, d_D, d_E, d_info);
    CheckEquals(rocblas_status_success, AStatus, AName + ' with evect=none failed');
    AStatusHip := hipMemcpy(@h_D2[0], d_D, ASizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_D failed');
    for I := 0 to N - 1 do
      CheckEquals(RoCGetReal(@h_D[0], I, AKind),
        RoCGetReal(@h_D2[0], I, AKind), ATolEig,
        AName + ': eigenvalue ' + IntToStr(I) + ' differs for evect=none');

    { 3. The upper triangle must produce the same eigenvalues. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallSyev(AKind, AOp, rocblas_evect_original, rocblas_fill_upper,
      d_A, d_D, d_E, d_info);
    CheckEquals(rocblas_status_success, AStatus, AName + ' with uplo=upper failed');
    AStatusHip := hipMemcpy(@h_D2[0], d_D, ASizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_D failed');
    for I := 0 to N - 1 do
      CheckEquals(RoCGetReal(@h_D[0], I, AKind),
        RoCGetReal(@h_D2[0], I, AKind), ATolEig,
        AName + ': eigenvalue ' + IntToStr(I) + ' differs for uplo=upper');

  finally
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


procedure TTestRocSolver_EigenSVD.RunSyevBatched(AKind: TRoCElemKind;
  AOp: TRoCSyevOp; AStridedBatch: Boolean);
const
  N = RO_EIG_N;
  BATCH = 2;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_A, h_V: array[0..(BATCH * N * N * 16) - 1] of Byte;
  h_D: array[0..(BATCH * N * 16) - 1] of Byte;
  h_info: array[0..BATCH - 1] of rocblas_int;
  h_APtrs: array[0..BATCH - 1] of Pointer;
  d_A, d_APtrs, d_D, d_E, d_info: Pointer;
  ASizeA, ASizeD, ASizeE, ASizePtrs: size_t;
  { The library measures strides in elements; the host offsets need bytes. }
  AStrideA, AStrideD, AStrideE: rocblas_stride;
  AByteA, AByteD: PtrInt;
  ATolEig, ATolRes, ATolOrth: Double;
  B: Integer;
  AName: string;
  AScale: Double;
begin
  if AOp = rsoSyev then
    AName := 'syev'
  else
    AName := 'syevd';
  if AStridedBatch then
    AName := AName + '_strided_batched'
  else
    AName := AName + '_batched';

  d_A := nil;
  d_APtrs := nil;
  d_D := nil;
  d_E := nil;
  d_info := nil;
  AStrideA := N * N;
  AStrideD := N;
  AStrideE := N;
  AByteA := PtrInt(AStrideA) * RoCElemSize(AKind);
  AByteD := PtrInt(AStrideD) * RoCRealSize(AKind);
  ASizeA := BATCH * AByteA;
  ASizeD := BATCH * AByteD;
  ASizeE := BATCH * PtrInt(AStrideE) * RoCRealSize(AKind);
  ASizePtrs := BATCH * SizeOf(Pointer);
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  { The second matrix of the batch is RO_BATCH_SCALE times the first one, so its
    eigenvalues must be scaled by the same factor. }
  FillChar(h_A, SizeOf(h_A), 0);
  RoCFillSymMatrix(PByte(@h_A[0]), AKind, 1.0);
  RoCFillSymMatrix(PByte(@h_A[0]) + AByteA, AKind, RO_BATCH_SCALE);

  try
    AStatusHip := hipMalloc(d_A, ASizeA);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_APtrs, ASizePtrs);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_APtrs failed');
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_info, BATCH * SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    for B := 0 to BATCH - 1 do
      h_APtrs[B] := PByte(d_A) + PtrInt(B) * AByteA;

    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatusHip := hipMemcpy(d_APtrs, @h_APtrs[0], ASizePtrs, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_APtrs failed');

    if AStridedBatch then
      AStatus := CallSyevStrided(AKind, AOp, rocblas_evect_original,
        rocblas_fill_lower, d_A, N, AStrideA, d_D, AStrideD, d_E, AStrideE,
        d_info, BATCH)
    else
      AStatus := CallSyevBatched(AKind, AOp, rocblas_evect_original,
        rocblas_fill_lower, PhipDeviceptr_t(d_APtrs), N, d_D, AStrideD, d_E,
        AStrideE, d_info, BATCH);

    if AStatus = rocblas_status_not_implemented then
      Ignore(AName + ' is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, AName + ' failed');

    AStatusHip := hipMemcpy(@h_info[0], d_info, BATCH * SizeOf(rocblas_int),
      hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    for B := 0 to BATCH - 1 do
      CheckEquals(0, h_info[B],
        AName + ': convergence failure in matrix ' + IntToStr(B));

    AStatusHip := hipMemcpy(@h_D[0], d_D, ASizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_D failed');
    AStatusHip := hipMemcpy(@h_V[0], d_A, ASizeA, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_A failed');

    for B := 0 to BATCH - 1 do
    begin
      if B = 0 then
        AScale := 1.0
      else
        AScale := RO_BATCH_SCALE;
      CheckEigDecomposition(AKind,
        PByte(@h_A[0]) + PtrInt(B) * AByteA,
        PByte(@h_D[0]) + PtrInt(B) * AByteD,
        PByte(@h_V[0]) + PtrInt(B) * AByteA,
        AScale, AName + ' matrix ' + IntToStr(B));
    end;

  finally
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_APtrs) then hipFree(d_APtrs);
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;



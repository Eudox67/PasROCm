procedure TTestRocSolver_OrthogonalGen.Test_rocsolver_sorgtr;
const
  N = 5;
  LDA = N;
var
  AStatusSolver: rocsolver_status;
  AStatusBlas: rocblas_status;
  h_A: array of Single;
  h_I_result: array of Single;
  d_A, d_tau, d_I, d_D, d_E: Pointer;
  ASizeA, ASizeTau, ASizeI, ASizeDE: size_t;
  i, j: Integer;
  alpha, beta: Single;
begin
  // 1. Initialize
  ASizeA := LDA * N * SizeOf(Single);
  ASizeTau := (N - 1) * SizeOf(Single);
  ASizeDE := N * SizeOf(Single);
  ASizeI := N * N * SizeOf(Single);
  SetLength(h_A, LDA * N);
  SetLength(h_I_result, N * N);
  // Create a symmetric matrix
  for j := 0 to N - 1 do for i := 0 to N - 1 do h_A[i + j * LDA] := 1.0 + Max(i, j);
  alpha := 1.0; beta := 0.0;
  d_A := nil; d_tau := nil; d_I := nil; d_D := nil; d_E := nil;
  hipMalloc(d_A, ASizeA); hipMalloc(d_tau, ASizeTau); hipMalloc(d_I, ASizeI);
  hipMalloc(d_D, ASizeDE); hipMalloc(d_E, ASizeDE);

  // 2. Generate reflectors using ssytrd (prerequisite)
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_ssytrd(FHandle, rocblas_fill_upper, N, d_A, LDA, d_D, d_E, d_tau);
  if AStatusSolver = rocblas_status_size_increased then
    AStatusSolver := rocsolver_ssytrd(FHandle, rocblas_fill_upper, N, d_A, LDA, d_D, d_E, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite ssytrd failed');
  if AStatusSolver <> rocblas_status_success then Exit;

  // 3. Call the function under test
  AStatusSolver := rocsolver_sorgtr(FHandle, rocblas_fill_upper, N, d_A, LDA, d_tau);
  if AStatusSolver = rocblas_status_size_increased then
      AStatusSolver := rocsolver_sorgtr(FHandle, rocblas_fill_upper, N, d_A, LDA, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_sorgtr failed');

  // 4. Verify Q'*Q = I using rocBLAS
  if AStatusSolver = rocblas_status_success then
  begin
    AStatusBlas := rocblas_ssyrk(FHandle, rocblas_fill_upper, rocblas_operation_transpose, N, N, @alpha, d_A, LDA, @beta, d_I, N);
    CheckEquals(rocblas_status_success, AStatusBlas, 'Verification ssyrk failed');
    hipMemcpy(@h_I_result[0], d_I, ASizeI, hipMemcpyDeviceToHost);
    for j := 0 to N - 1 do for i := 0 to j do
      if i = j then CheckEquals(1.0, h_I_result[i + j * N], 1e-5)
      else CheckEquals(0.0, h_I_result[i + j * N], 1e-5);
  end;

  // 5. Cleanup
  hipFree(d_A); hipFree(d_tau); hipFree(d_I); hipFree(d_D); hipFree(d_E);
end;


procedure TTestRocSolver_Auxiliary.Test_rocsolver_slaswp;
const
  M = 4;
  N = 4;
  LDA = M;
  K1 = 1;
  K2 = 2;
  INCX = 1;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_A, h_A_gold, h_result: array[0..M * N - 1] of Single;
  h_ipiv: array[0..K2 - 1] of rocblas_int;
  d_A, d_ipiv: Pointer;
  AsizeA, ASizeIpiv: size_t;
  i, j: Integer;
  temp: Single;
begin
  // 1. Initialize host data
  AsizeA := M * N * SizeOf(Single);
  ASizeIpiv := K2 * SizeOf(rocblas_int);

  // Initialize matrix A (column-major)
  for j := 0 to N - 1 do
    for i := 0 to M - 1 do
      h_A[i + j * LDA] := i + 1 + j * M;

  // Initialize pivot array (1-based indices)
  h_ipiv[0] := 3; // Swap row 1 with 3
  h_ipiv[1] := 4; // Swap row 2 with 4

  // Create the golden result by performing swaps manually
  Move(h_A, h_A_gold, ASizeA);
  // Swap row 1 (index 0) with row 3 (index 2)
  for j := 0 to N - 1 do
  begin
    temp := h_A_gold[0 + j * LDA];
    h_A_gold[0 + j * LDA] := h_A_gold[2 + j * LDA];
    h_A_gold[2 + j * LDA] := temp;
  end;
  // Swap row 2 (index 1) with row 4 (index 3)
  for j := 0 to N - 1 do
  begin
    temp := h_A_gold[1 + j * LDA];
    h_A_gold[1 + j * LDA] := h_A_gold[3 + j * LDA];
    h_A_gold[3 + j * LDA] := temp;
  end;

  // 2. Allocate device memory
  d_A := nil;
  d_ipiv := nil;
  AStatusHip := hipMalloc(d_A, ASizeA);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc for d_A failed');
  if AStatusHip <> HIP_SUCCESS then Exit;
  AStatusHip := hipMalloc(d_ipiv, ASizeIpiv);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc for d_ipiv failed');
  if AStatusHip <> HIP_SUCCESS then begin hipFree(d_A); Exit; end;

  // 3. Copy data from host to device
  AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
  AStatusHip := hipMemcpy(d_ipiv, @h_ipiv[0], ASizeIpiv, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_ipiv failed');

  // 4. Call rocsolver function
  AStatusSolver := rocsolver_slaswp(FHandle, N, d_A, LDA, K1, K2, d_ipiv, INCX);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_slaswp failed');

  // 5. Copy result from device to host
  AStatusHip := hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_A failed');

  // 6. Verify results
  if AStatusSolver = rocblas_status_success then
  begin
    for i := 0 to M * N - 1 do
      CheckEquals(h_A_gold[i], h_result[i], 1e-6, 'Mismatch at index ' + IntToStr(i));
  end;

  // 7. Cleanup
  if Assigned(d_A) then hipFree(d_A);
  if Assigned(d_ipiv) then hipFree(d_ipiv);
end;


  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // --- Golden Run ---
  hipStatus := hipMemcpy(d_A, @h_A_initial[0,0], N * LDA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy failed');
  AStatus := rocsolver_strtri(FHandle, uplo, diag, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Golden Run: rocsolver_strtri failed');
  hipStatus := hipMemcpy(@h_A_golden[0,0], d_A, N * LDA * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy back to h_A_golden failed');
  hipStatus := hipMemcpy(@h_info_golden, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy back to h_info_golden failed');

  // --- Test Run ---
  hipStatus := hipMemcpy(d_A, @h_A_initial[0,0], N * LDA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy failed');
  AStatus := rocsolver_strtri(FHandle, uplo, diag, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Test Run: rocsolver_strtri failed');
  hipStatus := hipMemcpy(@h_A_result[0,0], d_A, N * LDA * SizeOf(Single), hipMemcpyDeviceToHost);

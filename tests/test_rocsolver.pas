procedure TTestRocSolver_Solvers.Test_rocsolver_spotrs;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
var
  h_A_orig, h_A, h_B, h_X: array of Single;
  h_info: rocblas_int;
  d_A, d_B, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  uplo: rocblas_fill;
  i, j, k: Integer;
  residual, normA, normX, error: Double;
  temp: Single;
begin
  uplo := rocblas_fill_upper;

  // 1. Initialize host matrices
  SetLength(h_A, LDA * N);
  SetLength(h_A_orig, LDA * N);
  SetLength(h_B, LDB * NRHS);
  SetLength(h_X, LDB * NRHS);

  // Symmetric Positive Definite Matrix A
  // A = [ 4,  2,  2]
  //     [ 2, 10,  7]
  //     [ 2,  7, 21]
  h_A[0] := 4;  h_A[1] := 2;  h_A[2] := 2;
  h_A[3] := 2;  h_A[4] := 10; h_A[5] := 7;
  h_A[6] := 2;  h_A[7] := 7;  h_A[8] := 21;
  Move(h_A[0], h_A_orig[0], LDA * N * SizeOf(Single));

  // B = [18]
  //     [45]
  //     [97]
  // Solution X should be [2, 1, 3]
  h_B[0] := 18; h_B[1] := 45; h_B[2] := 97;

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, LDA * N * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_B, LDB * NRHS * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_B failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 3. Copy inputs to device
  hipStatus := hipMemcpy(d_A, Pointer(h_A), LDA * N * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');
  hipStatus := hipMemcpy(d_B, Pointer(h_B), LDB * NRHS * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_B to d_B failed');

  // 4. Perform Cholesky factorization on GPU
  AStatus := rocsolver_spotrf(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrf failed');
  hipStatus := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus);
  CheckEquals(0, h_info, 'spotrf factorization failed, matrix is not positive definite');

  // 5. Call the solver
  AStatus := rocsolver_spotrs(FHandle, uplo, N, NRHS, d_A, LDA, d_B, LDB);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrs failed');

  // 6. Copy result back to host
  hipStatus := hipMemcpy(Pointer(h_X), d_B, LDB * NRHS * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_B to h_X failed');

  // 7. Verify the solution by calculating residual ||A*X - B|| / (||A||*||X||)
  normA := 0;
  for i := 0 to (LDA * N) - 1 do
    normA := normA + Sqr(h_A_orig[i]);
  normA := Sqrt(normA);

  normX := 0;
  for i := 0 to (LDB * NRHS) - 1 do
    normX := normX + Sqr(h_X[i]);
  normX := Sqrt(normX);

  residual := 0;
  for i := 0 to N - 1 do
  begin
    for j := 0 to NRHS - 1 do
    begin
      temp := 0;
      for k := 0 to N - 1 do
        temp := temp + h_A_orig[i + k * LDA] * h_X[k + j * LDB];
      residual := residual + Sqr(temp - h_B[i + j * LDB]);
    end;
  end;
  residual := Sqrt(residual);

  if ((normA > 0) and (normX > 0)) then
    error := residual / (normA * normX)
  else
    error := residual;

  CheckEquals(0.0, error, 1e-6, 'Solution residual is too high.');

  // 8. Clean up
  hipStatus := hipFree(d_A); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_B); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);
end;


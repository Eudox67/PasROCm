procedure TTestRocSolver_Auxiliary.Test_rocsolver_clarfg;
const
  N = 2;
  incx = 1;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_alpha, h_alpha_gold, h_alpha_result: rocblas_float_complex;
  h_tau, h_tau_gold, h_tau_result: rocblas_float_complex;
  h_x, h_x_gold, h_x_result: array[0..N - 2] of rocblas_float_complex;
  d_alpha, d_x, d_tau: Pointer;
  ASizeX, ASizeTau: size_t;
  beta, scale: rocblas_float_complex;
  norm, abs_alpha: Double;
begin
  // 1. Initialize Host Data
  ASizeX := (N - 1) * SizeOf(rocblas_float_complex);
  ASizeTau := SizeOf(rocblas_float_complex);

  h_alpha.x := 3.0;
  h_alpha.y := 0.0;
  h_x[0].x := 4.0;
  h_x[0].y := 0.0;

  // 2. Calculate Golden Values on CPU
  norm := Sqrt(Sqr(h_alpha.x) + Sqr(h_alpha.y) + Sqr(h_x[0].x) + Sqr(h_x[0].y));
  abs_alpha := Sqrt(Sqr(h_alpha.x) + Sqr(h_alpha.y));

  beta.x := -norm * (h_alpha.x / abs_alpha);
  beta.y := -norm * (h_alpha.y / abs_alpha);

  h_alpha_gold.x := beta.x;
  h_alpha_gold.y := beta.y;

  ComplexSub(beta, h_alpha); // beta := beta - h_alpha (result in beta)
  h_tau := beta; // h_tau := beta - h_alpha
  ComplexDiv(h_tau, h_alpha_gold); // h_tau := (beta - h_alpha) / beta_new
  h_tau_gold := h_tau;

  scale.x := h_alpha.x - h_alpha_gold.x;
  scale.y := h_alpha.y - h_alpha_gold.y;

  h_x_gold[0] := h_x[0];
  ComplexDiv(h_x_gold[0], scale);

  // 3. Allocate Device Memory
  d_alpha := nil; d_x := nil; d_tau := nil;
  AStatusHip := hipMalloc(d_alpha, SizeOf(rocblas_float_complex));
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc for d_alpha failed');
  AStatusHip := hipMalloc(d_x, ASizeX);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc for d_x failed');
  AStatusHip := hipMalloc(d_tau, ASizeTau);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc for d_tau failed');

  // 4. Copy data to device
  AStatusHip := hipMemcpy(d_alpha, @h_alpha, SizeOf(rocblas_float_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_alpha failed');
  AStatusHip := hipMemcpy(d_x, @h_x[0], ASizeX, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_x failed');

  // 5. Call function
  AStatusSolver := rocsolver_clarfg(FHandle, N, d_alpha, d_x, incx, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_clarfg failed');

  // 6. Copy results back
  AStatusHip := hipMemcpy(@h_alpha_result, d_alpha, SizeOf(rocblas_float_complex), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_alpha failed');
  AStatusHip := hipMemcpy(@h_tau_result, d_tau, ASizeTau, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_tau failed');
  AStatusHip := hipMemcpy(@h_x_result[0], d_x, ASizeX, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_x failed');

  // 7. Verify
  if AStatusSolver = rocblas_status_success then
  begin
    CheckEquals(h_alpha_gold.x, h_alpha_result.x, 1e-6, 'alpha.x mismatch');
    CheckEquals(h_alpha_gold.y, h_alpha_result.y, 1e-6, 'alpha.y mismatch');
    CheckEquals(h_tau_gold.x, h_tau_result.x, 1e-6, 'tau.x mismatch');
    CheckEquals(h_tau_gold.y, h_tau_result.y, 1e-6, 'tau.y mismatch');
    CheckEquals(h_x_gold[0].x, h_x_result[0].x, 1e-6, 'x[0].x mismatch');
    CheckEquals(h_x_gold[0].y, h_x_result[0].y, 1e-6, 'x[0].y mismatch');
  end;

  // 8. Cleanup
  if Assigned(d_alpha) then hipFree(d_alpha);
  if Assigned(d_x) then hipFree(d_x);
  if Assigned(d_tau) then hipFree(d_tau);
end;


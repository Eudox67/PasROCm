  total_size_ipiv := strideP * batch_count * sizeof(rocblas_int);
  total_size_info := batch_count * sizeof(rocblas_int);

  SetLength(h_A, strideA * batch_count);
  SetLength(h_A_result, strideA * batch_count);
  SetLength(h_A_golden, strideA * batch_count);
  SetLength(h_ipiv, strideP * batch_count);
  SetLength(h_ipiv_result, strideP * batch_count);
  SetLength(h_ipiv_golden, strideP * batch_count);
  SetLength(h_info, batch_count);
  SetLength(h_info_result, batch_count);
  SetLength(h_info_golden, batch_count);

  uplo_values[0] := rocblas_fill_upper;
  uplo_values[1] := rocblas_fill_lower;

  for uplo in uplo_values do
  begin
    // Initialize input matrices
    for k := 0 to batch_count - 1 do
    begin
      for j := 0 to n - 1 do
        for i := 0 to n - 1 do
        begin
          if i >= j then
          begin
            h_A[k * strideA + j * lda + i].x := i + j + 2 + (k*10);
            h_A[k * strideA + j * lda + i].y := 0;
          end else
          begin
            h_A[k * strideA + j * lda + i].x := j + i + 2 + (k*10);
            h_A[k * strideA + j * lda + i].y := 0;
          end;
        end;
      for i := 0 to n - 1 do
        h_A[k * strideA + i * lda + i].x := h_A[k * strideA + i * lda + i].x + n * 2;

  case AKind of
    rkSingle:
      case AOp of
        rgoSygv:
          Result := rocsolver_ssygv(FHandle, AForm, AEvect, AUplo, N, A, N, B, N,
            AD, AE, AInfo);
        rgoSygvd:
          Result := rocsolver_ssygvd(FHandle, AForm, AEvect, AUplo, N, A, N, B, N,

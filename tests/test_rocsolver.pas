unit Test_rocSolver;

{$mode objfpc}{$H+}

interface

uses
  SysUtils, Math, fpcunit, testregistry, rocblas, rocsolver, hip_error, hip_types, hip_runtime, ROCm_test_utils;

type

  { Storage kind of a rocSOLVER eigenproblem element. Used by the shared
    helpers that implement the eigensolver tests for all four precisions. }
  TRoCElemKind = (rkSingle, rkDouble, rkComplexSingle, rkComplexDouble);
  { Which routine of a tridiagonal eigensolver family to exercise. }
  TRoCTriOp = (rtoSteqr, rtoStedc);
  { Which driver of the standard symmetric/Hermitian eigensolver family to
    exercise: QR iteration (syev/heev) or divide and conquer (syevd/heevd). }
  TRoCSyevOp = (rsoSyev, rsoSyevd);
  { Which member of the expert ("x") eigensolver family to exercise: the one
    with an abstol/ifail interface (syevx/heevx) or the fast variant
    (syevdx/heevdx). }
  TRoCSyevxOp = (rsxSyevx, rsxSyevdx);
  { Which driver of the generalized symmetric/Hermitian eigensolver family
    to exercise. }
  TRoCSygvOp = (rgoSygv, rgoSygvd, rgoSygvj, rgoSygvdj);



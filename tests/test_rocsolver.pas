procedure TTestRocSolver_EigenSVD.RunSyevx(AKind: TRoCElemKind; AOp: TRoCSyevxOp);
const
  N = RO_EIG_N;
  { The value range used by the erange=value sub-test. }
  AVl = 0.5;
  AVu = 3.0;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_A, h_Z: array[0..(N * N * 16) - 1] of Byte;
  h_W, h_W2: array[0..(N * 16) - 1] of Byte;
  h_nev: rocblas_int;
  h_ifail: array[0..N - 1] of rocblas_int;
  h_info: rocblas_int;
  d_A, d_W, d_Z, d_nev, d_ifail, d_info: Pointer;
  ASizeA, ASizeW, ASizeZ: size_t;
  ATolEig, ATolRes, ATolOrth: Double;
  I, ACount: Integer;
  AName: string;
begin
  if AOp = rsxSyevx then
    AName := 'syevx'
  else
    AName := 'syevdx';

  d_A := nil;
  d_W := nil;
  d_Z := nil;
  d_nev := nil;
  d_ifail := nil;
  d_info := nil;
  ASizeA := N * N * RoCElemSize(AKind);
  ASizeW := N * RoCRealSize(AKind);
  ASizeZ := N * N * RoCElemSize(AKind);
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  FillChar(h_A, SizeOf(h_A), 0);
  RoCFillSymMatrix(@h_A[0], AKind, 1.0);
  FillChar(h_nev, SizeOf(h_nev), 0);
  FillChar(h_ifail, SizeOf(h_ifail), 0);

  try
    AStatusHip := hipMalloc(d_A, ASizeA);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_W, ASizeW);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_W failed');
    AStatusHip := hipMalloc(d_Z, ASizeZ);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_Z failed');
    AStatusHip := hipMalloc(d_nev, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_nev failed');
    AStatusHip := hipMalloc(d_ifail, N * SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_ifail failed');
    AStatusHip := hipMalloc(d_info, SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    { 1. erange = all: every eigenvalue and eigenvector is requested. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallSyevx(AKind, AOp, rocblas_evect_original, rocblas_erange_all,
      rocblas_fill_lower, d_A, 0.0, 0.0, 0, 0, d_nev, d_W, d_Z, N, d_ifail, d_info);
    if AStatus = rocblas_status_not_implemented then
      Ignore(AName + ' is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, AName + ' with erange=all failed');

    AStatusHip := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, AName + ' reported a convergence failure');
    AStatusHip := hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_nev failed');
    CheckEquals(N, h_nev, AName + ': erange=all did not return every eigenvalue');

    AStatusHip := hipMemcpy(@h_W[0], d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_W failed');
    AStatusHip := hipMemcpy(@h_Z[0], d_Z, ASizeZ, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_Z failed');
    CheckEigDecomposition(AKind, PByte(@h_A[0]), PByte(@h_W[0]), PByte(@h_Z[0]),
      1.0, AName);

    { 2. erange = index: eigenvalues 2 and 3 (1-based) are requested. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallSyevx(AKind, AOp, rocblas_evect_original, rocblas_erange_index,
      rocblas_fill_lower, d_A, 0.0, 0.0, 2, 3, d_nev, d_W, d_Z, N, d_ifail, d_info);
    CheckEquals(rocblas_status_success, AStatus, AName + ' with erange=index failed');
    AStatusHip := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, AName + ' reported a convergence failure');
    AStatusHip := hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_nev failed');
    CheckEquals(2, h_nev, AName + ': erange=index returned the wrong nev');

    AStatusHip := hipMemcpy(@h_W2[0], d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_W failed');
    AStatusHip := hipMemcpy(@h_Z[0], d_Z, ASizeZ, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_Z failed');
    for I := 0 to 1 do
      CheckEquals(RoCGetReal(@h_W[0], I + 1, AKind),
        RoCGetReal(@h_W2[0], I, AKind), ATolEig,
        AName + ': erange=index returned the wrong eigenvalue ' + IntToStr(I));
    for I := 0 to 1 do
      CheckEigenVector(AKind, PByte(@h_A[0]), PByte(@h_Z[0]), I, N,
        RoCGetReal(@h_W2[0], I, AKind),
        AName + ': erange=index vector ' + IntToStr(I));

    if AOp = rsxSyevx then
    begin
      AStatusHip := hipMemcpy(@h_ifail[0], d_ifail, N * SizeOf(rocblas_int),
        hipMemcpyDeviceToHost);
      CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_ifail failed');
      for I := 0 to N - 1 do
        CheckEquals(0, h_ifail[I],
          AName + ': ifail[' + IntToStr(I) + '] reports a failed eigenvector');
    end;

    { 3. erange = value: only the eigenvalues inside [AVl, AVu] are requested. }
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatus := CallSyevx(AKind, AOp, rocblas_evect_original, rocblas_erange_value,
      rocblas_fill_lower, d_A, AVl, AVu, 0, 0, d_nev, d_W, d_Z, N, d_ifail, d_info);
    CheckEquals(rocblas_status_success, AStatus, AName + ' with erange=value failed');
    AStatusHip := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, AName + ' reported a convergence failure');
    AStatusHip := hipMemcpy(@h_nev, d_nev, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_nev failed');
    AStatusHip := hipMemcpy(@h_W2[0], d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_W failed');

    ACount := 0;
    for I := 0 to N - 1 do
      if (RoCGetReal(@h_W[0], I, AKind) >= AVl)
        and (RoCGetReal(@h_W[0], I, AKind) <= AVu) then
      begin
        CheckEquals(RoCGetReal(@h_W[0], I, AKind),
          RoCGetReal(@h_W2[0], ACount, AKind), ATolEig,
          AName + ': erange=value returned the wrong eigenvalue ' + IntToStr(ACount));
        Inc(ACount);
      end;
    CheckEquals(ACount, h_nev, AName + ': erange=value returned the wrong nev');

  finally
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_W) then hipFree(d_W);
    if Assigned(d_Z) then hipFree(d_Z);
    if Assigned(d_nev) then hipFree(d_nev);
    if Assigned(d_ifail) then hipFree(d_ifail);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


procedure TTestRocSolver_EigenSVD.RunSyevxBatched(AKind: TRoCElemKind;
  AOp: TRoCSyevxOp; AStridedBatch: Boolean);
const
  N = RO_EIG_N;
  BATCH = 2;
var
  AStatus: rocsolver_status;
  AStatusHip: hipError_t;
  h_A, h_Z: array[0..(BATCH * N * N * 16) - 1] of Byte;
  h_W: array[0..(BATCH * N * 16) - 1] of Byte;
  h_nev: array[0..BATCH - 1] of rocblas_int;
  h_ifail: array[0..(BATCH * N) - 1] of rocblas_int;
  h_info: array[0..BATCH - 1] of rocblas_int;
  h_APtrs, h_ZPtrs: array[0..BATCH - 1] of Pointer;
  d_A, d_APtrs, d_W, d_Z, d_ZPtrs, d_nev, d_ifail, d_info: Pointer;
  ASizeA, ASizeW, ASizeZ, ASizeF, ASizePtrs: size_t;
  AStrideA, AStrideW, AStrideZ, AStrideF: rocblas_stride;
  AByteA, AByteW, AByteZ, AByteF: PtrInt;
  ATolEig, ATolRes, ATolOrth: Double;
  B, I: Integer;
  AName: string;
  AScale: Double;
begin
  if AOp = rsxSyevx then
    AName := 'syevx'
  else
    AName := 'syevdx';
  if AStridedBatch then
    AName := AName + '_strided_batched'
  else
    AName := AName + '_batched';

  d_A := nil;
  d_APtrs := nil;
  d_W := nil;
  d_Z := nil;
  d_ZPtrs := nil;
  d_nev := nil;
  d_ifail := nil;
  d_info := nil;
  AStrideA := N * N;
  AStrideW := N;
  AStrideZ := N * N;
  AStrideF := N;
  AByteA := PtrInt(AStrideA) * RoCElemSize(AKind);
  AByteW := PtrInt(AStrideW) * RoCRealSize(AKind);
  AByteZ := PtrInt(AStrideZ) * RoCElemSize(AKind);
  AByteF := PtrInt(AStrideF) * SizeOf(rocblas_int);
  ASizeA := BATCH * AByteA;
  ASizeW := BATCH * AByteW;
  ASizeZ := BATCH * AByteZ;
  ASizeF := BATCH * AByteF;
  ASizePtrs := BATCH * SizeOf(Pointer);
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  FillChar(h_A, SizeOf(h_A), 0);
  RoCFillSymMatrix(PByte(@h_A[0]), AKind, 1.0);
  RoCFillSymMatrix(PByte(@h_A[0]) + AByteA, AKind, RO_BATCH_SCALE);

  try
    AStatusHip := hipMalloc(d_A, ASizeA);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_APtrs, ASizePtrs);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_APtrs failed');
    AStatusHip := hipMalloc(d_W, ASizeW);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_W failed');
    AStatusHip := hipMalloc(d_Z, ASizeZ);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_Z failed');
    AStatusHip := hipMalloc(d_ZPtrs, ASizePtrs);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_ZPtrs failed');
    AStatusHip := hipMalloc(d_nev, BATCH * SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_nev failed');
    AStatusHip := hipMalloc(d_ifail, ASizeF);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_ifail failed');
    AStatusHip := hipMalloc(d_info, BATCH * SizeOf(rocblas_int));
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    for B := 0 to BATCH - 1 do
    begin
      h_APtrs[B] := PByte(d_A) + PtrInt(B) * AByteA;
      h_ZPtrs[B] := PByte(d_Z) + PtrInt(B) * AByteZ;
    end;

    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');
    AStatusHip := hipMemcpy(d_APtrs, @h_APtrs[0], ASizePtrs, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_APtrs failed');
    AStatusHip := hipMemcpy(d_ZPtrs, @h_ZPtrs[0], ASizePtrs, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_ZPtrs failed');

    if AStridedBatch then
      AStatus := CallSyevxStrided(AKind, AOp, rocblas_evect_original,
        rocblas_erange_all, rocblas_fill_lower, d_A, N, AStrideA, 0.0, 0.0, 0, 0,
        d_nev, d_W, AStrideW, d_Z, N, AStrideZ, d_ifail, AStrideF, d_info, BATCH)
    else
      AStatus := CallSyevxBatched(AKind, AOp, rocblas_evect_original,
        rocblas_erange_all, rocblas_fill_lower, PhipDeviceptr_t(d_APtrs), N,
        0.0, 0.0, 0, 0, d_nev, d_W, AStrideW, PhipDeviceptr_t(d_ZPtrs), N,
        d_ifail, AStrideF, d_info, BATCH);

    if AStatus = rocblas_status_not_implemented then
      Ignore(AName + ' is not implemented in this rocSOLVER build.');
    CheckEquals(rocblas_status_success, AStatus, AName + ' failed');

    AStatusHip := hipMemcpy(@h_info[0], d_info, BATCH * SizeOf(rocblas_int),
      hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    AStatusHip := hipMemcpy(@h_nev[0], d_nev, BATCH * SizeOf(rocblas_int),
      hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_nev failed');
    AStatusHip := hipMemcpy(@h_W[0], d_W, ASizeW, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_W failed');
    AStatusHip := hipMemcpy(@h_Z[0], d_Z, ASizeZ, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_Z failed');

    for B := 0 to BATCH - 1 do
    begin
      CheckEquals(0, h_info[B],
        AName + ': convergence failure in matrix ' + IntToStr(B));
      CheckEquals(N, h_nev[B],
        AName + ': wrong nev for matrix ' + IntToStr(B));
      if B = 0 then
        AScale := 1.0
      else
        AScale := RO_BATCH_SCALE;
      CheckEigDecomposition(AKind,
        PByte(@h_A[0]) + PtrInt(B) * AByteA,
        PByte(@h_W[0]) + PtrInt(B) * AByteW,
        PByte(@h_Z[0]) + PtrInt(B) * AByteZ,
        AScale, AName + ' matrix ' + IntToStr(B));
    end;

    if AOp = rsxSyevx then
    begin
      AStatusHip := hipMemcpy(@h_ifail[0], d_ifail, ASizeF, hipMemcpyDeviceToHost);
      CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_ifail failed');
      for I := 0 to BATCH * N - 1 do
        CheckEquals(0, h_ifail[I],
          AName + ': ifail[' + IntToStr(I) + '] reports a failed eigenvector');
    end;

  finally
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_APtrs) then hipFree(d_APtrs);
    if Assigned(d_W) then hipFree(d_W);
    if Assigned(d_Z) then hipFree(d_Z);
    if Assigned(d_ZPtrs) then hipFree(d_ZPtrs);
    if Assigned(d_nev) then hipFree(d_nev);
    if Assigned(d_ifail) then hipFree(d_ifail);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


{ Fills a diagonal matrix AScale*I of size RO_EIG_N. }
procedure RoCFillScaledIdentity(AData: PByte; AKind: TRoCElemKind; const AScale: Double);
const
  N = RO_EIG_N;
var
  I, J: Integer;
begin
  for J := 0 to N - 1 do
    for I := 0 to N - 1 do
      if I = J then
        RoCSetElem(AData, J * N + I, AKind, AScale, 0.0)
      else
        RoCSetElem(AData, J * N + I, AKind, 0.0, 0.0);
end;

{ Returns the real part of the ARow-th component of M*v, and the imaginary part
  in AIm. The matrix must be real (its imaginary parts are ignored) and is
  stored column-major with leading dimension ALdv. }
function RoCMatVecComp(AKind: TRoCElemKind; const AMat, AV: PByte;
  const ARow, AVec, ALdv: Integer; out AIm: Double): Double;
const
  N = RO_EIG_N;
var
  K: Integer;
  ARe2, AIm2, AMik: Double;
begin
  Result := 0.0;
  AIm := 0.0;
  for K := 0 to N - 1 do
  begin
    RoCGetElem(AMat, K * ALdv + ARow, AKind, AMik, AIm2);
    RoCGetElem(AV, AVec * ALdv + K, AKind, ARe2, AIm2);
    Result := Result + AMik * ARe2;
    AIm := AIm + AMik * AIm2;
  end;
end;


procedure TTestRocSolver_EigenSVD.CheckGeneralizedEig(AKind: TRoCElemKind;
  AForm: rocblas_eform; const AOriginalA, AOriginalB, AD, AV: PByte;
  const ACase: string);
const
  N = RO_EIG_N;
var
  I, J: Integer;
  ATolEig, ATolRes, ATolOrth: Double;
  AEigen, ABNorm, ARe, AIm, ARe2, AIm2: Double;
  AResRe, AResIm: Double;
  h_Tmp: array[0..(N * 16) - 1] of Byte;
begin
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  { The eigenvalues must be returned in increasing order. }
  for I := 1 to N - 1 do
    CheckTrue(RoCGetReal(AD, I, AKind) >= RoCGetReal(AD, I - 1, AKind) - ATolEig,
      ACase + ': eigenvalues are not returned in increasing order');

  for J := 0 to N - 1 do
  begin
    AEigen := RoCGetReal(AD, J, AKind);

    { t = B*v for the first and second form, t = A*v for the third form. }
    for I := 0 to N - 1 do
    begin
      if AForm = rocblas_eform_bax then
        ARe := RoCMatVecComp(AKind, AOriginalA, AV, I, J, N, AIm)
      else
        ARe := RoCMatVecComp(AKind, AOriginalB, AV, I, J, N, AIm);
      RoCSetElem(@h_Tmp[0], I, AKind, ARe, AIm);
    end;

    { rocSOLVER normalizes the eigenvectors so that v^H*B*v = 1 for the first
      and second forms. }
    if AForm <> rocblas_eform_bax then
    begin
      ABNorm := 0.0;
      for I := 0 to N - 1 do
      begin
        RoCGetElem(AV, J * N + I, AKind, ARe, AIm);
        RoCGetElem(@h_Tmp[0], I, AKind, ARe2, AIm2);
        ABNorm := ABNorm + ARe * ARe2 + AIm * AIm2;
      end;
      CheckEquals(1.0, ABNorm, ATolOrth * 10.0,
        ACase + ': eigenvector ' + IntToStr(J) + ' is not B-normalized');
    end;

    { Residual of the requested form of the eigenproblem. }
    for I := 0 to N - 1 do
    begin
      if AForm = rocblas_eform_ax then
      begin
        AResRe := RoCMatVecComp(AKind, AOriginalA, AV, I, J, N, AResIm);
        RoCGetElem(@h_Tmp[0], I, AKind, ARe2, AIm2);
        AResRe := AResRe - AEigen * ARe2;
        AResIm := AResIm - AEigen * AIm2;
      end
      else if AForm = rocblas_eform_abx then
      begin
        AResRe := RoCMatVecComp(AKind, AOriginalA, @h_Tmp[0], I, 0, N, AResIm);
        RoCGetElem(AV, J * N + I, AKind, ARe2, AIm2);
        AResRe := AResRe - AEigen * ARe2;
        AResIm := AResIm - AEigen * AIm2;
      end
      else
      begin
        AResRe := RoCMatVecComp(AKind, AOriginalB, @h_Tmp[0], I, 0, N, AResIm);
        RoCGetElem(AV, J * N + I, AKind, ARe2, AIm2);
        AResRe := AResRe - AEigen * ARe2;
        AResIm := AResIm - AEigen * AIm2;
      end;
      CheckEquals(0.0, Sqr(AResRe) + Sqr(AResIm), ATolRes,
        ACase + ': residual of eigenvector ' + IntToStr(J)
        + ' at row ' + IntToStr(I));
    end;
  end;
end;


function TTestRocSolver_EigenSVD.CallSygv(AKind: TRoCElemKind;

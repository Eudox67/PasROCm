procedure TTestRocSolver_Auxiliary.Test_rocsolver_clarf_64;
const
  M_const = 4; N_const = 3; incx_const = 1;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_C, h_C_gold, h_C_result: array[0..M_const * N_const - 1] of rocblas_float_complex;
  h_x: array[0..M_const - 1] of rocblas_float_complex;
  h_alpha, h_tau: rocblas_float_complex;
  d_C, d_x, d_tau: Pointer;
  ASizeC, ASizeX, ASizeTau: size_t;
  i, j: Integer;
  AM, AN, ALDA, Aincx: rocblas_int64;
  work: array[0..N_const-1] of rocblas_float_complex;
  v_conj, temp: rocblas_float_complex;
begin
  // 1. Init
  AM := M_const; AN := N_const; ALDA := M_const; Aincx := incx_const;
  ASizeC := ALDA * AN * SizeOf(rocblas_float_complex); ASizeX := AM * SizeOf(rocblas_float_complex); ASizeTau := SizeOf(rocblas_float_complex);
  for j := 0 to AN-1 do for i := 0 to AM-1 do begin h_C[i+j*ALDA].x:=i+j*AM+1; h_C[i+j*ALDA].y:=i+j*AM+2; end;
  Move(h_C, h_C_gold, ASizeC);
  for i := 0 to AM-1 do begin h_x[i].x:=i+1; h_x[i].y:=i+2; end;

  // 2. Malloc
  d_C := nil; d_x := nil; d_tau := nil;
  hipMalloc(d_C, ASizeC); hipMalloc(d_x, ASizeX); hipMalloc(d_tau, ASizeTau);

  // 3. Gen reflector with clarfg_64
  h_alpha := h_x[0];
  hipMemcpy(d_x, @h_x[1], (AM-1) * SizeOf(rocblas_float_complex), hipMemcpyHostToDevice);
  hipMemcpy(d_tau, @h_alpha, SizeOf(rocblas_float_complex), hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_clarfg_64(FHandle, AM, d_tau, d_x, Aincx, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite clarfg_64 failed');
  hipMemcpy(@h_x[1], d_x, (AM-1) * SizeOf(rocblas_float_complex), hipMemcpyDeviceToHost);
  hipMemcpy(@h_tau, d_tau, SizeOf(rocblas_float_complex), hipMemcpyDeviceToHost);
  h_x[0].x := 1.0; h_x[0].y := 0.0;

  // 4. CPU golden calculation
  for j := 0 to AN-1 do begin work[j].x:=0; work[j].y:=0; end;
  for j := 0 to AN-1 do for i := 0 to AM-1 do begin v_conj.x := h_x[i].x; v_conj.y := -h_x[i].y; ComplexMul(v_conj, h_C_gold[i+j*ALDA]); ComplexAdd(work[j], v_conj); end;
  for j := 0 to AN-1 do for i := 0 to AM-1 do begin temp := h_tau; ComplexMul(temp, h_x[i]); ComplexMul(temp, work[j]); ComplexSub(h_C_gold[i+j*ALDA], temp); end;

  // 5. Copy data for clarf_64
  hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice);
  hipMemcpy(d_x, @h_x[0], ASizeX, hipMemcpyHostToDevice);
  hipMemcpy(d_tau, @h_tau, ASizeTau, hipMemcpyHostToDevice);

  // 6. Call clarf_64
  AStatusSolver := rocsolver_clarf_64(FHandle, rocblas_side_left, AM, AN, d_x, Aincx, d_tau, d_C, ALDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_clarf_64 failed');

  // 7. Copy result
  hipMemcpy(@h_C_result[0], d_C, ASizeC, hipMemcpyDeviceToHost);

  // 8. Verify
  if AStatusSolver=rocblas_status_success then for i:=0 to ALDA*AN-1 do begin CheckEquals(h_C_gold[i].x, h_C_result[i].x, 2e-5); CheckEquals(h_C_gold[i].y, h_C_result[i].y, 2e-5); end;

  // 9. Cleanup
  if Assigned(d_C) then hipFree(d_C); if Assigned(d_x) then hipFree(d_x); if Assigned(d_tau) then hipFree(d_tau);
end;


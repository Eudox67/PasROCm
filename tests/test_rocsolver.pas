  h_A, h_A_res, h_B: array of rocblas_double_complex;
  h_info: rocblas_int;
  d_A, d_info: hipDeviceptr_t;
  sizeA, sizeInfo: size_t;
  i, j, l: Integer;
  sum: rocblas_double_complex;
begin
  // 1. Setup
  sizeA := n * n * SizeOf(rocblas_double_complex);
  sizeInfo := SizeOf(rocblas_int);

  SetLength(h_A, n * n);
  SetLength(h_A_res, n * n);
  SetLength(h_B, n * n);
  h_info := -1;

  for j := 0 to n - 1 do
    for i := 0 to n - 1 do
    begin
      if i = j then h_B[i + j * lda].x := 2.0 else h_B[i + j * lda].x := 0.5;
      h_B[i + j * lda].y := 0.1;
    end;

  for j := 0 to n - 1 do
    for i := 0 to n - 1 do
    begin
      sum.x := 0;
      sum.y := 0;
      for l := 0 to n - 1 do

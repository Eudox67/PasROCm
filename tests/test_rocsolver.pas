procedure TTestRocSolver_Factorizations.Test_rocsolver_sgeqrf_batched;
const
  m = 10;
  n = 8;
  lda = m;
  batch_count = 3;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  k: rocblas_int;
  h_A_data: array of Single;
  h_tau_res: array of Single;
  h_A_ptrs: array of hipDeviceptr_t;
  d_A_data, d_A_ptrs, d_tau: hipDeviceptr_t;
  strideP: rocblas_stride;
  size_matrix_bytes, size_tau_bytes, size_A_data_bytes, size_A_ptrs_bytes, size_tau_data_bytes: size_t;
  size_matrix_elements, size_tau_elements: Integer;
  i, j, b: Integer;
begin
  // 1. Setup
  k := min(m, n);
  size_matrix_elements := m * n;
  size_tau_elements := k;
  strideP := size_tau_elements;

  size_matrix_bytes := size_matrix_elements * SizeOf(Single);
  size_tau_bytes := size_tau_elements * SizeOf(Single);
  size_A_data_bytes := batch_count * size_matrix_bytes;
  size_A_ptrs_bytes := batch_count * SizeOf(hipDeviceptr_t);
  size_tau_data_bytes := batch_count * size_tau_bytes;

  SetLength(h_A_data, batch_count * size_matrix_elements);
  SetLength(h_tau_res, batch_count * size_tau_elements);
  SetLength(h_A_ptrs, batch_count);

  for b := 0 to batch_count - 1 do
  begin
    for j := 0 to n - 1 do
    begin
      for i := 0 to m - 1 do
      begin
        h_A_data[b * size_matrix_elements + i + j * lda] := i + j * m + 1 + b;
      end;
    end;
  end;

  d_A_data := nil;
  d_A_ptrs := nil;
  d_tau := nil;

    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_A failed');
    AhipStatus := hipMemcpy(@h_ipiv_golden[0], d_ipiv_golden, total_size_ipiv, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_ipiv failed');
    AhipStatus := hipMemcpy(@h_info_golden[0], d_info_golden, total_size_info, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_info failed');

    AhipStatus := hipFree(d_A_golden);
    AhipStatus := hipFree(d_ipiv_golden);
    AhipStatus := hipFree(d_info_golden);
    // --- End of Golden Value Generation ---

    // --- Actual Test Run ---

procedure TTestRocSolver_Solvers.Test_rocsolver_spotrs_batched;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
  BATCH_COUNT = 2;
var
  h_A_orig, h_A, h_B, h_X: array of Single;
  h_info: array of rocblas_int;
  h_d_A_array, h_d_B_array: array of hipDeviceptr_t;
  d_A_array, d_B_array, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  uplo: rocblas_fill;
  i, j, k, b: Integer;
  matrix_size, b_size: Integer;
  residual, normA, normX, error: Double;
  temp: Single;
begin
  uplo := rocblas_fill_upper;
  matrix_size := LDA * N;
  b_size := LDB * NRHS;

  // 1. Initialize host data structures
  SetLength(h_A, BATCH_COUNT * matrix_size);
  SetLength(h_A_orig, BATCH_COUNT * matrix_size);
  SetLength(h_B, BATCH_COUNT * b_size);
  SetLength(h_X, BATCH_COUNT * b_size);
  SetLength(h_info, BATCH_COUNT);
  SetLength(h_d_A_array, BATCH_COUNT);
  SetLength(h_d_B_array, BATCH_COUNT);

  // 2. Populate host matrices and allocate individual device matrices for the batch
  for b := 0 to BATCH_COUNT - 1 do
  begin
    // Symmetric Positive Definite Matrix A
    h_A[b*matrix_size + 0] := 4;  h_A[b*matrix_size + 1] := 2;  h_A[b*matrix_size + 2] := 2;
    h_A[b*matrix_size + 3] := 2;  h_A[b*matrix_size + 4] := 10; h_A[b*matrix_size + 5] := 7;
    h_A[b*matrix_size + 6] := 2;  h_A[b*matrix_size + 7] := 7;  h_A[b*matrix_size + 8] := 21;

    // B = [18], [45], [97] (adjusted for batch index)
    h_B[b*b_size + 0] := 18 + b;
    h_B[b*b_size + 1] := 45 + b;
    h_B[b*b_size + 2] := 97 + b;

    hipStatus := hipMalloc(h_d_A_array[b], matrix_size * SizeOf(Single));
    CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_A['+IntToStr(b)+'] failed');
    hipStatus := hipMalloc(h_d_B_array[b], b_size * SizeOf(Single));
    CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_B['+IntToStr(b)+'] failed');

    hipStatus := hipMemcpy(h_d_A_array[b], @h_A[b*matrix_size], matrix_size * SizeOf(Single), hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy for h_A['+IntToStr(b)+'] failed');
    hipStatus := hipMemcpy(h_d_B_array[b], @h_B[b*b_size], b_size * SizeOf(Single), hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy for h_B['+IntToStr(b)+'] failed');
  end;
  Move(h_A[0], h_A_orig[0], BATCH_COUNT * matrix_size * SizeOf(Single));

  // 3. Allocate and set up device arrays of pointers
  hipStatus := hipMalloc(d_A_array, BATCH_COUNT * SizeOf(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_A_array failed');
  hipStatus := hipMalloc(d_B_array, BATCH_COUNT * SizeOf(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_B_array failed');

  hipStatus := hipMemcpy(d_A_array, Pointer(h_d_A_array), BATCH_COUNT * SizeOf(hipDeviceptr_t), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy for pointer array A failed');
  hipStatus := hipMemcpy(d_B_array, Pointer(h_d_B_array), BATCH_COUNT * SizeOf(hipDeviceptr_t), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy for pointer array B failed');

  // 4. Allocate other device buffers
  hipStatus := hipMalloc(d_info, BATCH_COUNT * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_info failed');

  // 5. Perform Cholesky factorization
  AStatus := rocsolver_spotrf_batched(FHandle, uplo, N, d_A_array, LDA, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrf_batched failed');
  hipStatus := hipMemcpy(Pointer(h_info), d_info, BATCH_COUNT * SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus);
  for b := 0 to BATCH_COUNT - 1 do
    CheckEquals(0, h_info[b], 'spotrf_batched factorization failed for batch item ' + IntToStr(b));

  // 6. Call the solver
  AStatus := rocsolver_spotrs_batched(FHandle, uplo, N, NRHS, d_A_array, LDA, d_B_array, LDB, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrs_batched failed');

  // 7. Copy results back and verify each batch item
  for b := 0 to BATCH_COUNT - 1 do
  begin
    hipStatus := hipMemcpy(@h_X[b * b_size], h_d_B_array[b], b_size * SizeOf(Single), hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy result for batch ' + IntToStr(b) + ' failed');

    normA := 0;
    for i := 0 to matrix_size - 1 do
      normA := normA + Sqr(h_A_orig[b * matrix_size + i]);
    normA := Sqrt(normA);

    normX := 0;
    for i := 0 to b_size - 1 do
      normX := normX + Sqr(h_X[b * b_size + i]);
    normX := Sqrt(normX);

    residual := 0;
    for i := 0 to N - 1 do
    begin
      for j := 0 to NRHS - 1 do
      begin
        temp := 0;
        for k := 0 to N - 1 do
          temp := temp + h_A_orig[b * matrix_size + i + k * LDA] * h_X[b * b_size + k + j * LDB];
        residual := residual + Sqr(temp - h_B[b * b_size + i + j * LDB]);
      end;
    end;
    residual := Sqrt(residual);

    if ((normA > 0) and (normX > 0)) then
      error := residual / (normA * normX)
    else
      error := residual;
    CheckEquals(0.0, error, 1e-6, 'Solution residual is too high for batch item ' + IntToStr(b));
  end;

  // 8. Clean up
  for b := 0 to BATCH_COUNT - 1 do
  begin
    hipFree(h_d_A_array[b]);
    hipFree(h_d_B_array[b]);
  end;
  hipFree(d_A_array);
  hipFree(d_B_array);
  hipFree(d_info);
end;


procedure TTestRocSolver_Factorizations.Test_rocsolver_sgetrf;
const
  m = 10;
  n = 8;
  lda = m;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  k: rocblas_int;
  h_A, h_A_res: array of Single;
  h_ipiv, h_ipiv_res: array of rocblas_int;
  h_info: rocblas_int;
  d_A, d_ipiv, d_info: hipDeviceptr_t;
  sizeA, sizePiv, sizeInfo: size_t;
  i, j: Integer;
begin
  // 1. Setup
  k := min(m, n);
  sizeA := m * n * SizeOf(Single);
  sizePiv := k * SizeOf(rocblas_int);
  sizeInfo := SizeOf(rocblas_int);

  SetLength(h_A, m * n);
  SetLength(h_A_res, m * n);
  SetLength(h_ipiv, k);
  SetLength(h_ipiv_res, k);
  h_info := -1;

  // Initialize a non-singular matrix that requires pivoting (permuted identity)
  for j := 0 to n - 1 do
  begin
    for i := 0 to m - 1 do
    begin
      h_A[i + j * lda] := 0.0;
    end;
  end;
  for i := 0 to k - 1 do
  begin
     h_A[(k-1-i) + i * lda] := 1.0;
  end;

  d_A := nil;
  d_ipiv := nil;
  d_info := nil;
  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_ipiv, sizePiv);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_ipiv');
  AhipStatus := hipMalloc(d_info, sizeInfo);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_info');

  try
    // 2. Transfer data
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A');

    // 3. Execute
    AStatus := rocsolver_sgetrf(FHandle, m, n, d_A, lda, d_ipiv, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetrf');

    // 4. Transfer results
    AhipStatus := hipMemcpy(@h_info, d_info, sizeInfo, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H info');
    AhipStatus := hipMemcpy(@h_ipiv_res[0], d_ipiv, sizePiv, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H ipiv');

    // 5. Verification
    CheckEquals(0, h_info, 'info should be 0 for a successful factorization');
    Check(h_ipiv_res[0] <> 1, 'pivots[0] should indicate a swap');

  finally
    // 6. Cleanup
    if d_A <> nil then hipFree(d_A);
    if d_ipiv <> nil then hipFree(d_ipiv);
    if d_info <> nil then hipFree(d_info);
  end;
end;


  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_B to h_X failed');

  // 7. Verify the solution
  normA := 0;
  for i := 0 to (LDA * N) - 1 do
    normA := normA + Sqr(h_A_orig[i].x) + Sqr(h_A_orig[i].y);
  normA := Sqrt(normA);

  normX := 0;
  for i := 0 to (LDB * NRHS) - 1 do
    normX := normX + Sqr(h_X[i].x) + Sqr(h_X[i].y);
  normX := Sqrt(normX);

  residual := 0;

procedure TTestRocSolver_OrthogonalGen.Test_rocsolver_sorgbr;
const
  M_orig = 5;
  N_orig = 4;
var
  AStatusSolver: rocsolver_status;
  AStatusBlas: rocblas_status;
  h_A_orig, h_I_result: array of Single;
  d_A, d_tauq, d_taup, d_I, d_D, d_E: Pointer;
  ASizeA, ASizeTauQ, ASizeTauP, ASizeI, ASizeDE: size_t;
  i, j, k_reflectors: Integer;
  alpha, beta: Single;
begin
  // 1. Initialize
  k_reflectors := Min(M_orig, N_orig);
  ASizeA := M_orig * N_orig * SizeOf(Single);
  ASizeTauQ := k_reflectors * SizeOf(Single);
  ASizeTauP := k_reflectors * SizeOf(Single);
  ASizeDE := k_reflectors * SizeOf(Single);
  SetLength(h_A_orig, M_orig * N_orig);
  for j := 0 to N_orig - 1 do for i := 0 to M_orig - 1 do h_A_orig[i + j * M_orig] := 1.0 + i + j * M_orig;
  alpha := 1.0; beta := 0.0;
  d_A := nil; d_tauq := nil; d_taup := nil; d_I := nil; d_D := nil; d_E := nil;
  hipMalloc(d_A, ASizeA); hipMalloc(d_tauq, ASizeTauQ); hipMalloc(d_taup, ASizeTauP);
  hipMalloc(d_D, ASizeDE); hipMalloc(d_E, ASizeDE);

  // --- CASE 1: Generate Q (storev = 'Q' or column_wise) ---
  // The resulting Q will be M_orig x k_reflectors
  ASizeI := k_reflectors * k_reflectors * SizeOf(Single);
  hipMalloc(d_I, ASizeI);
  hipMemcpy(d_A, @h_A_orig[0], ASizeA, hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_sgebrd(FHandle, M_orig, N_orig, d_A, M_orig, d_D, d_E, d_tauq, d_taup);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite sgebrd for Q failed');

  if AStatusSolver = rocblas_status_success then
  begin
    // Call is sorgbr('Q', M, N_Q, K_A, ...), where N_Q is num_cols of Q, K_A is num reflectors from A
    // Here we generate a M_orig x k_reflectors matrix Q.
    AStatusSolver := rocsolver_sorgbr(FHandle, rocblas_storev_column_wise, M_orig, k_reflectors, N_orig, d_A, M_orig, d_tauq);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_sorgbr for Q failed');
  end;

  if AStatusSolver = rocblas_status_success then
  begin
    // Verify Q'*Q = I. Q is M_orig x k_reflectors. Result is k_reflectors x k_reflectors.
    AStatusBlas := rocblas_ssyrk(FHandle, rocblas_fill_upper, rocblas_operation_transpose, k_reflectors, M_orig, @alpha, d_A, M_orig, @beta, d_I, k_reflectors);
    CheckEquals(rocblas_status_success, AStatusBlas, 'Verification ssyrk for Q failed');
    SetLength(h_I_result, k_reflectors * k_reflectors);
    hipMemcpy(@h_I_result[0], d_I, ASizeI, hipMemcpyDeviceToHost);
    for j := 0 to k_reflectors - 1 do for i := 0 to j do
      if i = j then CheckEquals(1.0, h_I_result[i + j * k_reflectors], 2e-5) else CheckEquals(0.0, h_I_result[i + j * k_reflectors], 2e-5);
  end;
  hipFree(d_I);

  // --- CASE 2: Generate P' (storev = 'P' or row_wise) ---
  // The resulting P' will be k_reflectors x N_orig
  ASizeI := k_reflectors * k_reflectors * SizeOf(Single);
  hipMalloc(d_I, ASizeI);
  hipMemcpy(d_A, @h_A_orig[0], ASizeA, hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_sgebrd(FHandle, M_orig, N_orig, d_A, M_orig, d_D, d_E, d_tauq, d_taup);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite sgebrd for P failed');

  if AStatusSolver = rocblas_status_success then
  begin
    // Call is sorgbr('P', M_P, N, K_A, ...), where M_P is num_rows of P'.
    // Here we generate a k_reflectors x N_orig matrix P'.
    AStatusSolver := rocsolver_sorgbr(FHandle, rocblas_storev_row_wise, k_reflectors, N_orig, M_orig, d_A, M_orig, d_taup);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_sorgbr for P failed');
  end;

  if AStatusSolver = rocblas_status_success then
  begin
    // Verify P' * (P')' = P' * P = I. P' is k_reflectors x N_orig. Result is k_reflectors x k_reflectors.
    AStatusBlas := rocblas_ssyrk(FHandle, rocblas_fill_upper, rocblas_operation_none, k_reflectors, N_orig, @alpha, d_A, M_orig, @beta, d_I, k_reflectors);
    CheckEquals(rocblas_status_success, AStatusBlas, 'Verification ssyrk for P failed');
    SetLength(h_I_result, k_reflectors * k_reflectors);
    hipMemcpy(@h_I_result[0], d_I, ASizeI, hipMemcpyDeviceToHost);
    for j := 0 to k_reflectors - 1 do for i := 0 to j do
      if i = j then CheckEquals(1.0, h_I_result[i + j * k_reflectors], 2e-5) else CheckEquals(0.0, h_I_result[i + j * k_reflectors], 2e-5);
  end;

  // 8. Cleanup
  hipFree(d_A); hipFree(d_tauq); hipFree(d_taup); hipFree(d_I); hipFree(d_D); hipFree(d_E);
end;

procedure TTestRocSolver_OrthogonalGen.Test_rocsolver_dorgbr;
// This test follows the same structure as sorgbr, just with Double precision
const
  M = 5; N = 4; K = 3; LDA = M;
var
  AStatusSolver: rocblas_status; AStatusBlas: rocblas_status;
  h_A_orig, h_I_result: array of Double;
  d_A, d_tauq, d_taup, d_I, d_D, d_E: Pointer;
  alpha, beta: Double; i, j: Integer;
begin
  SetLength(h_A_orig, LDA * N); SetLength(h_I_result, M*M);
  for j:=0 to N-1 do for i:=0 to M-1 do h_A_orig[i+j*LDA]:=1.0+i+j*M;
  alpha:=1.0; beta:=0.0;
  hipMalloc(d_A, LDA*N*SizeOf(Double)); hipMalloc(d_tauq, K*SizeOf(Double));
  hipMalloc(d_taup, K*SizeOf(Double)); hipMalloc(d_I, M*M*SizeOf(Double));
  hipMalloc(d_D, K*SizeOf(Double)); hipMalloc(d_E, K*SizeOf(Double));

  // Case Q

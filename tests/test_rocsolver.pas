  AStatusBlas: rocblas_status;
  AStatusHip: hipError_t;
  h_A, h_B, h_C, h_X: array of rocblas_float_complex;
  h_info: array of rocblas_int;
  d_A, d_B, d_C, d_X, d_info, d_workspace: Pointer;
  ASizeA, ASizeB, ASizeC, ASizeX, ASizeInfo, AWorkspaceSize: size_t;
  inca, incb, incc, incx, lda_inter, ldb_inter, ldc_inter, ldx_inter: rocblas_int;
  strideA, strideB, strideC, strideX: rocblas_stride;
  i, j, b, k, offset: Integer;
begin
  // 1. Initialize
  d_A := nil; d_B := nil; d_C := nil; d_X := nil; d_info := nil; d_workspace := nil;
  inca := BATCH_COUNT; incb := BATCH_COUNT; incc := BATCH_COUNT; incx := BATCH_COUNT;
  lda_inter := inca * NB; ldb_inter := incb * NB; ldc_inter := incc * NB; ldx_inter := incx * (NB * NBLOCKS);
  strideA := 1; strideB := 1; strideC := 1; strideX := 1;

  ASizeA := (NBLOCKS - 1) * lda_inter * NB * SizeOf(rocblas_float_complex);
  ASizeB := NBLOCKS * ldb_inter * NB * SizeOf(rocblas_float_complex);
  ASizeC := (NBLOCKS - 1) * ldc_inter * NB * SizeOf(rocblas_float_complex);
  ASizeX := NRHS * ldx_inter * SizeOf(rocblas_float_complex);
  ASizeInfo := BATCH_COUNT * SizeOf(rocblas_int);

  if ASizeA > 0 then SetLength(h_A, ASizeA div SizeOf(rocblas_float_complex));
  SetLength(h_B, ASizeB div SizeOf(rocblas_float_complex));
  if ASizeC > 0 then SetLength(h_C, ASizeC div SizeOf(rocblas_float_complex));
  SetLength(h_X, ASizeX div SizeOf(rocblas_float_complex));
  SetLength(h_info, BATCH_COUNT);

  for b := 0 to BATCH_COUNT - 1 do
  begin
    for k := 0 to NBLOCKS - 2 do for j := 0 to NB-1 do for i := 0 to NB-1 do
    begin
      h_A[k*NB*lda_inter+j*lda_inter+i*inca+b].x := 1; h_A[k*NB*lda_inter+j*lda_inter+i*inca+b].y := 0;
      h_C[k*NB*ldc_inter+j*ldc_inter+i*incc+b].x := 1; h_C[k*NB*ldc_inter+j*ldc_inter+i*incc+b].y := 0;
    end;
    for k := 0 to NBLOCKS - 1 do for j := 0 to NB-1 do for i := 0 to NB-1 do
    begin
      offset := k*NB*ldb_inter+j*ldb_inter+i*incb+b;
      if i = j then begin h_B[offset].x := 4*NB; h_B[offset].y := 0; end
      else begin h_B[offset].x := 1; h_B[offset].y := 0; end;
    end;
    for j := 0 to NRHS - 1 do for i := 0 to (NB*NBLOCKS) - 1 do
    begin
      h_X[j*ldx_inter+i*incx+b].x := 1; h_X[j*ldx_inter+i*incx+b].y := 0;
    end;
  end;

  try
    // 2. Allocate device memory
    if ASizeA > 0 then AStatusHip := hipMalloc(d_A, ASizeA); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_B, ASizeB); CheckEquals(HIP_SUCCESS, AStatusHip);
    if ASizeC > 0 then AStatusHip := hipMalloc(d_C, ASizeC); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_X, ASizeX); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMalloc(d_info, ASizeInfo); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 3. Copy inputs
    if Assigned(d_A) then AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_B, @h_B[0], ASizeB, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    if Assigned(d_C) then AStatusHip := hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_X, @h_X[0], ASizeX, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 4. Factorize
    AStatusBlas := rocblas_start_device_memory_size_query(FHandle); CheckEquals(rocblas_status_success, AStatusBlas);
    rocsolver_cgeblttrf_npvt_interleaved_batched(FHandle, NB, NBLOCKS, nil, inca, lda_inter, strideA, nil, incb, ldb_inter, strideB, nil, incc, ldc_inter, strideC, nil, BATCH_COUNT);
    AStatusBlas := rocblas_stop_device_memory_size_query(FHandle, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas);
    if AWorkspaceSize > 0 then
    begin
      AStatusHip := hipMalloc(d_workspace, AWorkspaceSize); CheckEquals(HIP_SUCCESS, AStatusHip);
      AStatusBlas := rocblas_set_workspace(FHandle, d_workspace, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas);
    end;
    AStatusSolver := rocsolver_cgeblttrf_npvt_interleaved_batched(FHandle, NB, NBLOCKS, d_A, inca, lda_inter, strideA, d_B, incb, ldb_inter, strideB, d_C, incc, ldc_inter, strideC, d_info, BATCH_COUNT);
    if AStatusSolver <> rocblas_status_success then Fail('Prerequisite rocsolver_cgeblttrf_npvt_interleaved_batched call failed');

    // 5. Call solver
    AStatusSolver := rocsolver_cgeblttrs_npvt_interleaved_batched(FHandle, NB, NBLOCKS, NRHS, d_A, inca, lda_inter, strideA, d_B, incb, ldb_inter, strideB, d_C, incc, ldc_inter, strideC, d_X, incx, LDX, strideX, BATCH_COUNT);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_cgeblttrs_npvt_interleaved_batched failed');

  finally
    // 6. Cleanup
    if Assigned(d_workspace) then begin rocblas_set_workspace(FHandle, nil, 0); hipFree(d_workspace); end;
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_B) then hipFree(d_B);
    if Assigned(d_C) then hipFree(d_C);
    if Assigned(d_X) then hipFree(d_X);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


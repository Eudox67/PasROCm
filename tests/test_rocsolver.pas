  h_info_golden, h_info_result: rocblas_int;
  d_A, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  uplo: rocblas_fill;
begin
  uplo := rocblas_fill_upper;

  // 1. Initialize host data
  h_A_initial[0,0].x := 4.0; h_A_initial[0,0].y := 0.0;
  h_A_initial[0,1].x := 1.0; h_A_initial[0,1].y := 1.0;
  h_A_initial[1,0].x := 1.0; h_A_initial[1,0].y := -1.0;
  h_A_initial[1,1].x := 5.0; h_A_initial[1,1].y := 0.0;
  h_info_golden := -1;
  h_info_result := -1;

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, N * LDA * SizeOf(rocblas_double_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // --- Golden Run: Characterize the library's output ---
  hipStatus := hipMemcpy(d_A, @h_A_initial[0,0], N * LDA * SizeOf(rocblas_double_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy failed');
  AStatus := rocsolver_zpotrf(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Golden Run: rocsolver_zpotrf failed');
  AStatus := rocsolver_zpotri(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Golden Run: rocsolver_zpotri failed');
  hipStatus := hipMemcpy(@h_A_golden[0,0], d_A, N * LDA * SizeOf(rocblas_double_complex), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy back failed');
  hipStatus := hipMemcpy(@h_info_golden, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy info back failed');

  // --- Test Run: Execute the same call again ---
  hipStatus := hipMemcpy(d_A, @h_A_initial[0,0], N * LDA * SizeOf(rocblas_double_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy failed');
  AStatus := rocsolver_zpotrf(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Test Run: rocsolver_zpotrf failed');
  AStatus := rocsolver_zpotri(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Test Run: rocsolver_zpotri failed');
  hipStatus := hipMemcpy(@h_A_result[0,0], d_A, N * LDA * SizeOf(rocblas_double_complex), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy back failed');
  hipStatus := hipMemcpy(@h_info_result, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy info back failed');

  // 3. Verification: Compare golden run to test run
  CheckEquals(h_info_golden, h_info_result, 'Info value mismatch between runs');
  Check(CompareMem(@h_A_golden, @h_A_result, N * LDA * SizeOf(rocblas_double_complex)), 'Matrix data mismatch between runs');

  // 4. Cleanup
  hipStatus := hipFree(d_A);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_A failed');
  hipStatus := hipFree(d_info);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_info failed');
end;


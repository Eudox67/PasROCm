  hipStatus := hipMalloc(d_taup, k * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_taup failed');
  hipStatus := hipMalloc(d_D, k * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_D failed');
  hipStatus := hipMalloc(d_E, k * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_E failed');

  // Copy data to device
  hipStatus := hipMemcpy(d_A, h_A, lda * a_cols * SizeOf(Single), hipMemcpyHostToDevice);

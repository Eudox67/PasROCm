procedure TTestRocSolver_Factorizations.Test_rocsolver_spotrf_batched;
const
  n = 10;
  lda = n;
  batch_count = 3;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A_data: array of Single;
  h_info: array of rocblas_int;
  h_A_ptrs: array of hipDeviceptr_t;
  d_A_data, d_A_ptrs, d_info: hipDeviceptr_t;
  size_matrix_bytes, size_A_data_bytes, size_A_ptrs_bytes, size_info_bytes: size_t;
  size_matrix_elements: Integer;
  i, j, b, l: Integer;
  h_B: array of Single;
begin
  // 1. Setup
  size_matrix_elements := n * n;
  size_matrix_bytes := size_matrix_elements * SizeOf(Single);
  size_A_data_bytes := batch_count * size_matrix_bytes;
  size_A_ptrs_bytes := batch_count * SizeOf(hipDeviceptr_t);
  size_info_bytes := batch_count * SizeOf(rocblas_int);

  SetLength(h_A_data, batch_count * size_matrix_elements);
  SetLength(h_info, batch_count);
  SetLength(h_A_ptrs, batch_count);
  SetLength(h_B, size_matrix_elements); // Temporary matrix for generation

  for b := 0 to batch_count - 1 do
  begin
    // Create a well-conditioned matrix B
    for j := 0 to n - 1 do
      for i := 0 to n - 1 do
        if i = j then h_B[i + j * lda] := 2.0 + b else h_B[i + j * lda] := 0.5;

    // Compute A = B' * B for this batch
    for j := 0 to n - 1 do
      for i := 0 to n - 1 do
      begin
        h_A_data[b * size_matrix_elements + i + j * lda] := 0;
        for l := 0 to n - 1 do
          h_A_data[b * size_matrix_elements + i + j * lda] :=
            h_A_data[b * size_matrix_elements + i + j * lda] + h_B[l + i * lda] * h_B[l + j * lda];
      end;
  end;

  d_A_data := nil;
  d_A_ptrs := nil;
  d_info := nil;
  AhipStatus := hipMalloc(d_A_data, size_A_data_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A_data');
  AhipStatus := hipMalloc(d_A_ptrs, size_A_ptrs_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A_ptrs');
  AhipStatus := hipMalloc(d_info, size_info_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_info');

  try
    AhipStatus := hipMemcpy(d_A_data, @h_A_data[0], size_A_data_bytes, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A_data');

    for b := 0 to batch_count - 1 do
    begin
      h_A_ptrs[b] := hipDeviceptr_t(PtrUInt(d_A_data) + b * size_matrix_bytes);
    end;

    AhipStatus := hipMemcpy(d_A_ptrs, @h_A_ptrs[0], size_A_ptrs_bytes, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A_ptrs');

    AStatus := rocsolver_spotrf_batched(FHandle, rocblas_fill_upper, n, d_A_ptrs, lda, d_info, batch_count);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_spotrf_batched');

    AhipStatus := hipMemcpy(@h_info[0], d_info, size_info_bytes, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H info');

    for b := 0 to batch_count - 1 do
    begin
      CheckEquals(0, h_info[b], 'info[' + IntToStr(b) + '] should be 0');
    end;

  finally
    if d_A_data <> nil then hipFree(d_A_data);
    if d_A_ptrs <> nil then hipFree(d_A_ptrs);
    if d_info <> nil then hipFree(d_info);
  end;
end;


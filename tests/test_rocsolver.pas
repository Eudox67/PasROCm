    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to golden d_A failed');

    AStatus := rocsolver_dsytrf_strided_batched(FHandle, uplo, n, d_A_golden, lda, strideA, d_ipiv_golden, strideP, d_info_golden, batch_count);

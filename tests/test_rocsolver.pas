  // Allocate host memory
  h_A := AllocMem(lda * a_cols * SizeOf(Single));
  h_C := AllocMem(ldc * n * SizeOf(Single));
  h_tauq := AllocMem(k * SizeOf(Single));
  h_taup := AllocMem(k * SizeOf(Single));
  h_D := AllocMem(k * SizeOf(Single));

    AStatusSolver := rocsolver_sgeql2(FHandle, M, N, d_A, LDA, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite sgeql2 failed');
  if AStatusSolver <> rocblas_status_success then Exit;


procedure TTestRocSolver_Solvers.Test_rocsolver_sgetrs;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
var
  h_A_orig, h_A, h_B, h_X: array of Single;
  h_ipiv: array of rocblas_int;
  h_info: rocblas_int;
  d_A, d_B, d_ipiv, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k: Integer;
  residual, normA, normX, error: Double;
  temp: Single;
begin
  // 1. Initialize host matrices
  SetLength(h_A, LDA * N);
  SetLength(h_A_orig, LDA * N);
  SetLength(h_B, LDB * NRHS);
  SetLength(h_X, LDB * NRHS);
  SetLength(h_ipiv, N);

  // A = [ 2, -1,  0]
  //     [-1,  2, -1]
  //     [ 0, -1,  2]
  h_A[0] := 2;  h_A[1] := -1; h_A[2] := 0;
  h_A[3] := -1; h_A[4] := 2;  h_A[5] := -1;
  h_A[6] := 0;  h_A[7] := -1; h_A[8] := 2;
  Move(h_A[0], h_A_orig[0], LDA * N * SizeOf(Single));

  // B = [1]
  //     [2]
  //     [3]
  h_B[0] := 1; h_B[1] := 2; h_B[2] := 3;

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, LDA * N * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_B, LDB * NRHS * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_B failed');
  hipStatus := hipMalloc(d_ipiv, N * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_ipiv failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 3. Copy inputs to device
  hipStatus := hipMemcpy(d_A, Pointer(h_A), LDA * N * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');
  hipStatus := hipMemcpy(d_B, Pointer(h_B), LDB * NRHS * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_B to d_B failed');

  // 4. Perform LU factorization on GPU
  AStatus := rocsolver_sgetrf(FHandle, N, N, d_A, LDA, d_ipiv, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetrf failed');
  hipStatus := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus);
  CheckEquals(0, h_info, 'sgetrf factorization failed, matrix is singular');

  // 5. Call the solver
  AStatus := rocsolver_sgetrs(FHandle, rocblas_operation_none, N, NRHS, d_A, LDA, d_ipiv, d_B, LDB);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetrs failed');

  // 6. Copy result back to host
  hipStatus := hipMemcpy(Pointer(h_X), d_B, LDB * NRHS * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_B to h_X failed');

  // 7. Verify the solution by calculating residual ||A*X - B|| / (||A||*||X||)
  normA := 0;
  for i := 0 to (LDA * N) - 1 do
    normA := normA + Sqr(h_A_orig[i]);
  normA := Sqrt(normA);

  normX := 0;
  for i := 0 to (LDB * NRHS) - 1 do
    normX := normX + Sqr(h_X[i]);
  normX := Sqrt(normX);

  residual := 0;
  for i := 0 to N - 1 do
  begin
    for j := 0 to NRHS - 1 do
    begin
      temp := 0;
      for k := 0 to N - 1 do
        temp := temp + h_A_orig[i + k * LDA] * h_X[k + j * LDB];
      residual := residual + Sqr(temp - h_B[i + j * LDB]);
    end;
  end;
  residual := Sqrt(residual);

  if ((normA > 0) and (normX > 0)) then
    error := residual / (normA * normX)
  else
    error := residual;

  CheckEquals(0.0, error, 1e-6, 'Solution residual is too high.');

  // 8. Clean up
  hipStatus := hipFree(d_A); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_B); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_ipiv); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);
end;

procedure TTestRocSolver_Solvers.Test_rocsolver_dgetrs;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
var
  h_A_orig, h_A, h_B, h_X: array of Double;
  h_ipiv: array of rocblas_int;
  h_info: rocblas_int;
  d_A, d_B, d_ipiv, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k: Integer;
  residual, normA, normX, error: Double;
  temp: Double;
begin
  // 1. Initialize host matrices
  SetLength(h_A, LDA * N);
  SetLength(h_A_orig, LDA * N);
  SetLength(h_B, LDB * NRHS);
  SetLength(h_X, LDB * NRHS);
  SetLength(h_ipiv, N);

  // A = [ 2, -1,  0]
  //     [-1,  2, -1]
  //     [ 0, -1,  2]
  h_A[0] := 2;  h_A[1] := -1; h_A[2] := 0;
  h_A[3] := -1; h_A[4] := 2;  h_A[5] := -1;
  h_A[6] := 0;  h_A[7] := -1; h_A[8] := 2;
  Move(h_A[0], h_A_orig[0], LDA * N * SizeOf(Double));

  // B = [1], [2], [3]
  h_B[0] := 1; h_B[1] := 2; h_B[2] := 3;

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, LDA * N * SizeOf(Double));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_B, LDB * NRHS * SizeOf(Double));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_B failed');
  hipStatus := hipMalloc(d_ipiv, N * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_ipiv failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 3. Copy inputs to device
  hipStatus := hipMemcpy(d_A, Pointer(h_A), LDA * N * SizeOf(Double), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');
  hipStatus := hipMemcpy(d_B, Pointer(h_B), LDB * NRHS * SizeOf(Double), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_B to d_B failed');

  // 4. Perform LU factorization on GPU
  AStatus := rocsolver_dgetrf(FHandle, N, N, d_A, LDA, d_ipiv, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_dgetrf failed');
  hipStatus := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus);
  CheckEquals(0, h_info, 'dgetrf factorization failed, matrix is singular');

  // 5. Call the solver
  AStatus := rocsolver_dgetrs(FHandle, rocblas_operation_none, N, NRHS, d_A, LDA, d_ipiv, d_B, LDB);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_dgetrs failed');

  // 6. Copy result back to host
  hipStatus := hipMemcpy(Pointer(h_X), d_B, LDB * NRHS * SizeOf(Double), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_B to h_X failed');

  // 7. Verify the solution by calculating residual ||A*X - B|| / (||A||*||X||)
  normA := 0;
  for i := 0 to (LDA * N) - 1 do
    normA := normA + Sqr(h_A_orig[i]);
  normA := Sqrt(normA);

  normX := 0;
  for i := 0 to (LDB * NRHS) - 1 do
    normX := normX + Sqr(h_X[i]);
  normX := Sqrt(normX);

  residual := 0;
  for i := 0 to N - 1 do
  begin
    for j := 0 to NRHS - 1 do
    begin
      temp := 0;
      for k := 0 to N - 1 do
        temp := temp + h_A_orig[i + k * LDA] * h_X[k + j * LDB];
      residual := residual + Sqr(temp - h_B[i + j * LDB]);
    end;
  end;
  residual := Sqrt(residual);

  if ((normA > 0) and (normX > 0)) then
    error := residual / (normA * normX)
  else
    error := residual;

  CheckEquals(0.0, error, 1e-12, 'Solution residual is too high.');

  // 8. Clean up
  hipStatus := hipFree(d_A); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_B); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_ipiv); CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);
end;

procedure TTestRocSolver_Solvers.Test_rocsolver_cgetrs;
const
  N = 3;
  NRHS = 1;
  LDA = N;
  LDB = N;
var
  h_A_orig, h_A, h_B, h_X: array of rocblas_float_complex;

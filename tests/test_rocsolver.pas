    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_ipiv failed');
    AhipStatus := hipMemcpy(@h_info_golden[0], d_info_golden, total_size_info, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_info failed');

    AhipStatus := hipFree(d_A_golden);
    AhipStatus := hipFree(d_ipiv_golden);
    AhipStatus := hipFree(d_info_golden);
    // --- End of Golden Value Generation ---

    // --- Actual Test Run ---
    d_A := nil;
    d_ipiv := nil;
    d_info := nil;
    AhipStatus := hipMalloc(d_A, total_size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A failed');
    AhipStatus := hipMalloc(d_ipiv, total_size_ipiv);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_ipiv failed');
    AhipStatus := hipMalloc(d_info, total_size_info);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_info failed');
    AhipStatus := hipMemcpy(d_A, @h_A[0], total_size_A, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A failed');

    // Execute

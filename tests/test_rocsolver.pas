  h_C := AllocMem(ldc * n * SizeOf(rocblas_double_complex));
  h_tauq := AllocMem(k * SizeOf(rocblas_double_complex));
  h_taup := AllocMem(k * SizeOf(rocblas_double_complex));
  h_D := AllocMem(k * SizeOf(Double));
  h_E := AllocMem(k * SizeOf(Double));

  // Initialize host data
  for i := 0 to (lda * a_cols) - 1 do
  begin
    h_A[i].x := i + 1;
    h_A[i].y := -(i + 1);
  end;
  for i := 0 to (ldc * n) - 1 do
  begin
    h_C[i].x := i + 1;
    h_C[i].y := -(i + 1);
  end;

  // Allocate device memory
  hipStatus := hipMalloc(d_A, lda * a_cols * SizeOf(rocblas_double_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_A failed');
  hipStatus := hipMalloc(d_C, ldc * n * SizeOf(rocblas_double_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_C failed');
  hipStatus := hipMalloc(d_tauq, k * SizeOf(rocblas_double_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_tauq failed');
  hipStatus := hipMalloc(d_taup, k * SizeOf(rocblas_double_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_taup failed');
  hipStatus := hipMalloc(d_D, k * SizeOf(Double));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_D failed');
  hipStatus := hipMalloc(d_E, k * SizeOf(Double));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_E failed');

  // Copy data to device
  hipStatus := hipMemcpy(d_A, h_A, lda * a_cols * SizeOf(rocblas_double_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy to d_A failed');
  hipStatus := hipMemcpy(d_C, h_C, ldc * n * SizeOf(rocblas_double_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy to d_C failed');

  // Prerequisite: Bidiagonalize matrix A
  AStatus := rocsolver_zgebrd(FHandle, a_rows, a_cols, d_A, lda, d_D, d_E, d_tauq, d_taup);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_zgebrd failed as prerequisite');

  // Apply the unitary matrix Q
  AStatus := rocsolver_zunmbr(FHandle, rocblas_storev_column_wise, rocblas_side_left,
                              rocblas_operation_none, m, n, k, d_A, lda, d_tauq, d_C, ldc);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_zunmbr call failed');

  // Synchronize device

procedure TTestRocSolver_Factorizations.Test_rocsolver_sgelqf_batched;
const
  m = 16;
  n = 50;
  lda = 16;
  batch_count = 3;
var
  AStatus: rocblas_status;
  AhipStatus: hipError_t;
  h_A, h_A_result, h_A_golden: array of Single;
  h_tau, h_tau_result, h_tau_golden: array of Single;
  d_A_array, d_A_array_golden: array of hipDeviceptr_t;
  d_tau, d_tau_golden: hipDeviceptr_t;
  d_A_ptrs, d_A_ptrs_golden: hipDeviceptr_t;
  i, j, k: Integer;
  strideP: rocblas_stride;
  size_A, size_tau_per_batch, total_size_tau: size_t;
begin
  // Setup
  strideP := min(m, n);
  size_A := lda * n * sizeof(Single);
  size_tau_per_batch := strideP * sizeof(Single);
  total_size_tau := size_tau_per_batch * batch_count;

  SetLength(h_A, lda * n * batch_count);
  SetLength(h_A_result, lda * n * batch_count);
  SetLength(h_A_golden, lda * n * batch_count);
  SetLength(h_tau, strideP * batch_count);
  SetLength(h_tau_result, strideP * batch_count);
  SetLength(h_tau_golden, strideP * batch_count);

  SetLength(d_A_array, batch_count);
  SetLength(d_A_array_golden, batch_count);

  for k := 0 to batch_count - 1 do
  begin
    AhipStatus := hipMalloc(d_A_array[k], size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, Format('hipMalloc for d_A_array[%d] failed', [k]));
    AhipStatus := hipMalloc(d_A_array_golden[k], size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, Format('hipMalloc for d_A_array_golden[%d] failed', [k]));
  end;

  AhipStatus := hipMalloc(d_A_ptrs, batch_count * sizeof(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A_ptrs failed');
  AhipStatus := hipMalloc(d_A_ptrs_golden, batch_count * sizeof(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A_ptrs_golden failed');
  AhipStatus := hipMalloc(d_tau, total_size_tau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_tau failed');
  AhipStatus := hipMalloc(d_tau_golden, total_size_tau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_tau_golden failed');

  // Initialize input matrices
  for k := 0 to batch_count - 1 do
    for j := 0 to n - 1 do
      for i := 0 to m - 1 do
        h_A[k * lda * n + j * lda + i] := i + j * m + (k * 1000);

  // --- Characterization Run: Generate Golden Values ---
  for k := 0 to batch_count - 1 do
  begin
    AhipStatus := hipMemcpy(d_A_array_golden[k], @h_A[k * lda * n], size_A, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_array_golden failed');
  end;
  AhipStatus := hipMemcpy(d_A_ptrs_golden, @d_A_array_golden[0], batch_count * sizeof(hipDeviceptr_t), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_ptrs_golden failed');

  AStatus := rocsolver_sgelqf_batched(FHandle, m, n, d_A_ptrs_golden, lda, d_tau_golden, strideP, batch_count);
  CheckEquals(rocblas_status_success, AStatus, 'Golden value generation failed');

  for k := 0 to batch_count - 1 do
  begin
    AhipStatus := hipMemcpy(@h_A_golden[k * lda * n], d_A_array_golden[k], size_A, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_A_array_golden failed');
  end;
  AhipStatus := hipMemcpy(@h_tau_golden[0], d_tau_golden, total_size_tau, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_tau_golden failed');
  // --- End of Golden Value Generation ---

  // --- Actual Test Run ---
  for k := 0 to batch_count - 1 do
  begin
    AhipStatus := hipMemcpy(d_A_array[k], @h_A[k * lda * n], size_A, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_array failed');
  end;
  AhipStatus := hipMemcpy(d_A_ptrs, @d_A_array[0], batch_count * sizeof(hipDeviceptr_t), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A_ptrs failed');

  // Execute

procedure TTestRocSolver_OrthogonalApp.Test_rocsolver_cunmtr;
const
  m = 5;
  n = 4;
  lda = m;
  ldc = m;
var
  h_A: Procfloat_complex;
  h_C: Procfloat_complex;
  h_tau: Procfloat_complex;
  h_D: PSingle;
  h_E: PSingle;
  d_A, d_C, d_tau, d_D, d_E: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j: Integer;
begin
  // Allocate host memory
  h_A := AllocMem(lda * m * SizeOf(rocblas_float_complex));
  h_C := AllocMem(ldc * n * SizeOf(rocblas_float_complex));
  h_tau := AllocMem((m - 1) * SizeOf(rocblas_float_complex));
  h_D := AllocMem(m * SizeOf(Single));
  h_E := AllocMem((m - 1) * SizeOf(Single));

  // Initialize host data. A must be Hermitian.
  for i := 0 to m - 1 do
  begin
    for j := i to m - 1 do
    begin
      if i = j then
      begin
        h_A[i + j * lda].x := i + j + 2; // Real diagonal
        h_A[i + j * lda].y := 0;
      end
      else
      begin
        h_A[i + j * lda].x := i + j + 2;
        h_A[i + j * lda].y := i - j;
        h_A[j + i * lda].x := i + j + 2; // A(j,i) = conj(A(i,j))
        h_A[j + i * lda].y := -(i - j);
      end;
    end;
  end;
  for i := 0 to (ldc * n) - 1 do
  begin
    h_C[i].x := i + 1.0;
    h_C[i].y := -(i + 1.0);

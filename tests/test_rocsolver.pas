  Check(CompareMem(@h_info_golden[0], @h_info_result[0], BATCH_COUNT * SizeOf(rocblas_int)), 'Info arrays mismatch');
  Check(CompareMem(@h_A_golden[0], @h_A_result[0], batch_size_bytes), 'Matrix data mismatch');

  // 4. Cleanup
  hipStatus := hipFree(d_A);    CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info); CheckEquals(HIP_SUCCESS, hipStatus);
end;


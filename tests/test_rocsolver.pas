procedure TTestRocSolver_BaseAPI.Test_rocsolver_get_version_string;
const
  BUF_SIZE = 128;
var
  AStatus: rocsolver_status;
  ABuffer: array[0..BUF_SIZE - 1] of Char;
  AVersionString: AnsiString;
begin
  // Call the function
  AStatus := rocsolver_get_version_string(ABuffer, BUF_SIZE);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_get_version_string should return success');

  // Verify the result
  AVersionString := PChar(ABuffer);
  CheckTrue(Length(AVersionString) > 0, 'Version string should not be empty');
end;

procedure TTestRocSolver_BaseAPI.Test_rocsolver_get_version_string_size;
var
  AStatus: rocsolver_status;
  ASize: size_t;
begin
  // Initialize size to a known invalid value
  ASize := 0;

  // Call the function
  AStatus := rocsolver_get_version_string_size(@ASize);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_get_version_string_size should return success');

  // Verify the result
  CheckTrue(ASize > 0, 'Version string size must be greater than 0');
end;

procedure TTestRocSolver_BaseAPI.Test_rocsolver_log_begin;
var
  AStatus: rocsolver_status;
begin
  AStatus := rocsolver_log_begin;
  if AStatus = rocblas_status_not_implemented then
    Ignore('rocsolver_log_begin is not implemented in this rocSOLVER build.')
  else
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_log_begin should return success');

  // Ensure logging is turned off to not interfere with other tests
  if AStatus = rocblas_status_success then
  begin
     rocsolver_log_end;
  end;
end;

procedure TTestRocSolver_BaseAPI.Test_rocsolver_log_end;
var
  AStatus: rocsolver_status;
begin
  // First, see if logging can be started.
  AStatus := rocsolver_log_begin;
  if AStatus = rocblas_status_not_implemented then
    Ignore('Cannot test log_end because log_begin is not implemented.');

  if AStatus = rocblas_status_success then
  begin
    // If begin succeeded, test end
    AStatus := rocsolver_log_end;
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_log_end should succeed after log_begin');
  end
  else
  begin
    // If begin failed for another reason, we still check log_end for proper behavior.
    AStatus := rocsolver_log_end;
    if AStatus = rocblas_status_not_implemented then
      Ignore('rocsolver_log_end is not implemented in this rocSOLVER build.')
    else
      // A success code is the most likely outcome if logging wasn't active.
      CheckEquals(rocblas_status_success, AStatus, 'rocsolver_log_end without active logging should still succeed');
  end;
end;

procedure TTestRocSolver_BaseAPI.Test_rocsolver_log_set_layer_mode;

procedure TTestRocSolver_Auxiliary.Test_rocsolver_clarfg_64;
const
  N_const = 2;
  incx_const = 1;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_alpha, h_alpha_gold, h_alpha_result: rocblas_float_complex;
  h_tau, h_tau_gold, h_tau_result: rocblas_float_complex;
  h_x, h_x_gold, h_x_result: array[0..N_const - 2] of rocblas_float_complex;
  d_alpha, d_x, d_tau: Pointer;
  ASizeX, ASizeTau: size_t;
  AN, Aincx: rocblas_int64;
  beta, scale: rocblas_float_complex;
  norm, abs_alpha: Double;
begin
  // 1. Initialize Host Data
  AN := N_const;
  Aincx := incx_const;
  ASizeX := (AN - 1) * SizeOf(rocblas_float_complex);
  ASizeTau := SizeOf(rocblas_float_complex);

  h_alpha.x := 3.0;
  h_alpha.y := 0.0;
  h_x[0].x := 4.0;
  h_x[0].y := 0.0;

  // 2. Calculate Golden Values on CPU
  norm := Sqrt(Sqr(h_alpha.x) + Sqr(h_alpha.y) + Sqr(h_x[0].x) + Sqr(h_x[0].y));
  abs_alpha := Sqrt(Sqr(h_alpha.x) + Sqr(h_alpha.y));

  beta.x := -norm * (h_alpha.x / abs_alpha);
  beta.y := -norm * (h_alpha.y / abs_alpha);

  h_alpha_gold.x := beta.x;
  h_alpha_gold.y := beta.y;

  ComplexSub(beta, h_alpha);
  h_tau := beta;
  ComplexDiv(h_tau, h_alpha_gold);
  h_tau_gold := h_tau;

  scale.x := h_alpha.x - h_alpha_gold.x;
  scale.y := h_alpha.y - h_alpha_gold.y;


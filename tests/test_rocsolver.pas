procedure TTestRocSolver_Factorizations.Test_rocsolver_sgetf2_npvt_batched;
const
  m = 5;
  n = 4;
  lda = m;
  batch_count = 3;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A: array of Single;
  h_info: array of rocblas_int;
  d_A_array, d_info: hipDeviceptr_t;
  d_A_ptrs: array of hipDeviceptr_t;
  d_A_array_gpu: hipDeviceptr_t;
  matrix_bytes: size_t;
  info_bytes: size_t;
  i, j, b: Integer;
begin
  matrix_bytes := lda * n * SizeOf(Single);
  info_bytes := batch_count * SizeOf(rocblas_int);

  SetLength(h_A, batch_count * lda * n);
  SetLength(h_info, batch_count);
  SetLength(d_A_ptrs, batch_count);

  // Initialize host matrix batch
  for b := 0 to batch_count - 1 do
  begin
    for j := 0 to n - 1 do
      for i := 0 to m - 1 do
        if i = j then
          h_A[b * lda * n + j * lda + i] := 10.0 + b
        else
          h_A[b * lda * n + j * lda + i] := 1.0;
  end;

  // Allocate device memory for each matrix
  for b := 0 to batch_count - 1 do
  begin
    AhipStatus := hipMalloc(d_A_ptrs[b], matrix_bytes);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc matrix');
    AhipStatus := hipMemcpy(d_A_ptrs[b], @h_A[b * lda * n], matrix_bytes, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy matrix');
  end;

  // Copy array of device pointers to GPU
  AhipStatus := hipMalloc(d_A_array_gpu, batch_count * SizeOf(hipDeviceptr_t));
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc A array');
  AhipStatus := hipMemcpy(d_A_array_gpu, @d_A_ptrs[0], batch_count * SizeOf(hipDeviceptr_t), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy A array');

  // Allocate and zero device info
  AhipStatus := hipMalloc(d_info, info_bytes);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc info');

  try
    AStatus := rocsolver_sgetf2_npvt_batched(FHandle, m, n, d_A_array_gpu, lda, d_info, batch_count);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetf2_npvt_batched');

    AhipStatus := hipMemcpy(@h_info[0], d_info, info_bytes, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H info');

    for b := 0 to batch_count - 1 do
      CheckEquals(0, h_info[b], 'info[' + IntToStr(b) + '] should be 0');

  finally
    for b := 0 to batch_count - 1 do
      if d_A_ptrs[b] <> nil then hipFree(d_A_ptrs[b]);
    if d_info <> nil then hipFree(d_info);
    if d_A_array_gpu <> nil then hipFree(d_A_array_gpu);
  end;
end;


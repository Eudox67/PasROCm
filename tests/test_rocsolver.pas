procedure TTestRocSolver_Auxiliary.Test_rocsolver_slatrd;
const
  N = 5;
  K = 3; // k < n
  LDA = N;
  LDW = N;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_A: array of Single;
  h_E_result: array of Single;
  d_A, d_E, d_tau, d_W: Pointer;
  ASizeA, ASizeE, ASizeTau, ASizeW: size_t;
  i, j: Integer;
begin
  // 1. Initialize sizes and host data
  ASizeA := LDA * N * SizeOf(Single);
  ASizeE := (N - 1) * SizeOf(Single);
  ASizeTau := (N - 1) * SizeOf(Single);
  ASizeW := LDW * K * SizeOf(Single);
  SetLength(h_A, LDA * N);
  SetLength(h_E_result, N - 1);

  // Create a symmetric matrix
  for j := 0 to N - 1 do
    for i := 0 to N - 1 do
      h_A[i + j * LDA] := 1.0 + Max(i, j);

  // 2. Allocate all device memory
  d_A := nil; d_E := nil; d_tau := nil; d_W := nil;
  hipMalloc(d_A, ASizeA); hipMalloc(d_E, ASizeE);
  hipMalloc(d_tau, ASizeTau); hipMalloc(d_W, ASizeW);

  // 3. Copy input matrix A to device
  AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_A failed');

  // 4. Call rocsolver_slatrd with retry logic
  AStatusSolver := rocsolver_slatrd(FHandle, rocblas_fill_upper, N, K, d_A, LDA, d_E, d_tau, d_W, LDW);
  if AStatusSolver = rocblas_status_size_increased then
    AStatusSolver := rocsolver_slatrd(FHandle, rocblas_fill_upper, N, K, d_A, LDA, d_E, d_tau, d_W, LDW);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_slatrd failed');

  // 5. Copy a result back for a basic sanity check
  AStatusHip := hipMemcpy(@h_E_result[0], d_E, ASizeE, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_E failed');

  // 6. Verify (smoke test)
  if AStatusSolver = rocblas_status_success then
  begin
    for i := 0 to N - 2 do
      CheckFalse(IsNan(h_E_result[i]), 'Result E should not be NaN at index ' + IntToStr(i));
  end;

  // 7. Cleanup
  if Assigned(d_A) then hipFree(d_A); if Assigned(d_E) then hipFree(d_E);
  if Assigned(d_tau) then hipFree(d_tau); if Assigned(d_W) then hipFree(d_W);
end;


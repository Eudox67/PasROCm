procedure TTestRocSolver_Auxiliary.Test_rocsolver_clauum;
const
  N = 3; LDA = N;
var
  AStatusSolver: rocsolver_status;
  h_A, h_A_gold, h_result: array of rocblas_float_complex;
  d_A: Pointer; ASizeA: size_t; i, j, k: Integer;
  sum, term, conj_term: rocblas_float_complex;
begin
  ASizeA := LDA * N * SizeOf(rocblas_float_complex);
  SetLength(h_A, LDA*N); SetLength(h_A_gold, LDA*N); SetLength(h_result, LDA*N);
  d_A := nil; hipMalloc(d_A, ASizeA);

  // --- CASE 1: UPLO = 'U' (A = U * U_H) ---
  for j:=0 to N-1 do for i:=0 to j do begin h_A[i+j*LDA].x:=i+j+2; h_A[i+j*LDA].y:=i-j; end;
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  for j:=0 to N-1 do for i:=0 to j do begin
    sum.x:=0; sum.y:=0;
    for k:=j to N-1 do begin
      term := h_A[i+k*LDA];
      conj_term.x := h_A[j+k*LDA].x; conj_term.y := -h_A[j+k*LDA].y;
      ComplexMul(term, conj_term); ComplexAdd(sum, term);
    end; h_A_gold[i+j*LDA]:=sum; end;
  AStatusSolver := rocsolver_clauum(FHandle, rocblas_fill_upper, N, d_A, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'uplo=U failed');
  hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  if AStatusSolver=rocblas_status_success then for j:=0 to N-1 do for i:=0 to j do begin CheckEquals(h_A_gold[i+j*LDA].x, h_result[i+j*LDA].x, 1e-5); CheckEquals(h_A_gold[i+j*LDA].y, h_result[i+j*LDA].y, 1e-5); end;

  // --- CASE 2: UPLO = 'L' (A = L_H * L) ---
  for j:=0 to N-1 do for i:=j to N-1 do begin h_A[i+j*LDA].x:=i+j+2; h_A[i+j*LDA].y:=i-j; end;
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  for j:=0 to N-1 do for i:=j to N-1 do begin
    sum.x:=0; sum.y:=0;
    for k:=i to N-1 do begin
      term := h_A[k+j*LDA];
      conj_term.x := h_A[k+i*LDA].x; conj_term.y := -h_A[k+i*LDA].y;
      ComplexMul(conj_term, term); ComplexAdd(sum, conj_term);
    end; h_A_gold[i+j*LDA]:=sum; end;
  AStatusSolver := rocsolver_clauum(FHandle, rocblas_fill_lower, N, d_A, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'uplo=L failed');
  hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  if AStatusSolver=rocblas_status_success then for j:=0 to N-1 do for i:=j to N-1 do begin CheckEquals(h_A_gold[i+j*LDA].x, h_result[i+j*LDA].x, 1e-5); CheckEquals(h_A_gold[i+j*LDA].y, h_result[i+j*LDA].y, 1e-5); end;

  if Assigned(d_A) then hipFree(d_A);
end;

procedure TTestRocSolver_Auxiliary.Test_rocsolver_zlauum;
const
  N = 3; LDA = N;
var
  AStatusSolver: rocsolver_status;
  h_A, h_A_gold, h_result: array of rocblas_double_complex;
  d_A: Pointer; ASizeA: size_t; i, j, k: Integer;
  sum, term: rocblas_double_complex;
begin
  ASizeA := LDA * N * SizeOf(rocblas_double_complex);
  SetLength(h_A, LDA*N); SetLength(h_A_gold, LDA*N); SetLength(h_result, LDA*N);
  d_A := nil; hipMalloc(d_A, ASizeA);

  // --- CASE 1: UPLO = 'U', compute A = U * U_H ---
  FillChar(h_A[0], ASizeA, 0);
  for j:=0 to N-1 do for i:=0 to j do begin h_A[i+j*LDA].x:=i+j+2; h_A[i+j*LDA].y:=i-j; end;
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);

  // Correct CPU Golden Calculation for U*U_H
  for j:=0 to N-1 do for i:=0 to j do begin
    sum.x:=0; sum.y:=0;
    for k:=j to N-1 do
    begin
      // term = U(i,k) * conj(U(j,k))
      term.x := h_A[i+k*LDA].x * h_A[j+k*LDA].x + h_A[i+k*LDA].y * h_A[j+k*LDA].y;
      term.y := h_A[i+k*LDA].y * h_A[j+k*LDA].x - h_A[i+k*LDA].x * h_A[j+k*LDA].y;
      ComplexAdd(sum, term);
    end;
    h_A_gold[i+j*LDA]:=sum;
  end;

  AStatusSolver := rocsolver_zlauum(FHandle, rocblas_fill_upper, N, d_A, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'uplo=U failed');
  hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  if AStatusSolver=rocblas_status_success then for j:=0 to N-1 do for i:=0 to j do begin CheckEquals(h_A_gold[i+j*LDA].x, h_result[i+j*LDA].x, 1e-12); CheckEquals(h_A_gold[i+j*LDA].y, h_result[i+j*LDA].y, 1e-12); end;

  // --- CASE 2: UPLO = 'L', compute A = L_H * L ---
  FillChar(h_A[0], ASizeA, 0);
  for j:=0 to N-1 do for i:=j to N-1 do begin h_A[i+j*LDA].x:=i+j+2; h_A[i+j*LDA].y:=i-j; end;
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);

  // Correct CPU Golden Calculation for L_H*L
  for j:=0 to N-1 do for i:=j to N-1 do begin
    sum.x:=0; sum.y:=0;
    for k:=i to N-1 do begin
      // term = conj(L(k,i)) * L(k,j)
      term.x := h_A[k+i*LDA].x * h_A[k+j*LDA].x + h_A[k+i*LDA].y * h_A[k+j*LDA].y;
      term.y := h_A[k+i*LDA].x * h_A[k+j*LDA].y - h_A[k+i*LDA].y * h_A[k+j*LDA].x;
      ComplexAdd(sum, term);
    end;
    h_A_gold[i+j*LDA]:=sum;
  end;

  AStatusSolver := rocsolver_zlauum(FHandle, rocblas_fill_lower, N, d_A, LDA);
  CheckEquals(rocblas_status_success, AStatusSolver, 'uplo=L failed');
  hipMemcpy(@h_result[0], d_A, ASizeA, hipMemcpyDeviceToHost);
  if AStatusSolver=rocblas_status_success then for j:=0 to N-1 do for i:=j to N-1 do begin CheckEquals(h_A_gold[i+j*LDA].x, h_result[i+j*LDA].x, 1e-12); CheckEquals(h_A_gold[i+j*LDA].y, h_result[i+j*LDA].y, 1e-12); end;

  if Assigned(d_A) then hipFree(d_A);
end;


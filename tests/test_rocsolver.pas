  uplo := rocblas_fill_upper;
  diag := rocblas_diagonal_non_unit;

  // 1. Initialize host data (upper triangular matrix)
  h_A_initial[0,0] := 1.0; h_A_initial[0,1] := 2.0; h_A_initial[0,2] := 3.0;
  h_A_initial[1,0] := 0.0; h_A_initial[1,1] := 4.0; h_A_initial[1,2] := 5.0;

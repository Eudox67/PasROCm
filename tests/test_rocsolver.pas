procedure TTestRocSolver_Inversion.Test_rocsolver_sgetri_batched;
const
  N = 3;
  LDA = N;
  BATCH_COUNT = 2;
var
  h_A, h_A_orig, h_C: array[0..BATCH_COUNT-1, 0..N-1, 0..N-1] of Single;
  h_ipiv: array[0..BATCH_COUNT-1, 0..N-1] of rocblas_int;
  h_info: array[0..BATCH_COUNT-1] of rocblas_int;
  h_A_ptrs: array[0..BATCH_COUNT-1] of Pointer;
  d_A_batch, d_ipiv, d_info, d_A_ptrs: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k, b: Integer;
  sum: Single;
  strideP: rocblas_stride;
begin
  // 1. Initialize test data on the host
  strideP := N;
  for b := 0 to BATCH_COUNT - 1 do
  begin
    // Make matrices slightly different
    h_A[b,0,0] := 4.0 + b; h_A[b,0,1] := 1.0;     h_A[b,0,2] := 2.0;
    h_A[b,1,0] := 1.0;     h_A[b,1,1] := 2.0 + b; h_A[b,1,2] := 1.0;
    h_A[b,2,0] := 1.0;     h_A[b,2,1] := 3.0;     h_A[b,2,2] := 5.0 + b;
    h_A_orig[b] := h_A[b];
  end;

  // 2. Allocate memory on the device
  hipStatus := hipMalloc(d_A_batch, BATCH_COUNT * N * LDA * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A_batch failed');
  hipStatus := hipMalloc(d_ipiv, BATCH_COUNT * N * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_ipiv failed');
  hipStatus := hipMalloc(d_info, BATCH_COUNT * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');
  hipStatus := hipMalloc(d_A_ptrs, BATCH_COUNT * SizeOf(Pointer));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A_ptrs failed');

  // 3. Setup device pointers and copy data
  for b := 0 to BATCH_COUNT - 1 do
  begin
    h_A_ptrs[b] := Pointer(IntPtr(d_A_batch) + b * N * LDA * SizeOf(Single));
  end;
  hipStatus := hipMemcpy(d_A_batch, @h_A, BATCH_COUNT * N * LDA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A_batch failed');
  hipStatus := hipMemcpy(d_A_ptrs, @h_A_ptrs, BATCH_COUNT * SizeOf(Pointer), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A_ptrs to d_A_ptrs failed');

  // 4. Perform LU factorization
  AStatus := rocsolver_sgetrf_batched(FHandle, N, N, d_A_ptrs, LDA, d_ipiv, strideP, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetrf_batched failed');

  // 5. Call the target function
  AStatus := rocsolver_sgetri_batched(FHandle, N, d_A_ptrs, LDA, d_ipiv, strideP, d_info, BATCH_COUNT);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgetri_batched failed');

  // 6. Verify results
  hipStatus := hipMemcpy(@h_A, d_A_batch, BATCH_COUNT * N * LDA * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_A_batch to h_A failed');
  hipStatus := hipMemcpy(@h_info, d_info, BATCH_COUNT * SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_info to h_info failed');

  for b := 0 to BATCH_COUNT - 1 do
  begin
    CheckEquals(0, h_info[b], 'sgetri_batched info[' + IntToStr(b) + '] should be 0');
    for i := 0 to N-1 do
    begin
      for j := 0 to N-1 do
      begin
        sum := 0.0;
        for k := 0 to N-1 do
        begin
          sum := sum + h_A_orig[b,i,k] * h_A[b,k,j];
        end;
        h_C[b,i,j] := sum;
      end;
    end;

    for i := 0 to N-1 do
    begin
      for j := 0 to N-1 do
      begin
        if i = j then
          CheckEquals(1.0, h_C[b,i,j], 1e-6, 'Batch ' + IntToStr(b) + ', C['+IntToStr(i)+','+IntToStr(j)+']')
        else
          CheckEquals(0.0, h_C[b,i,j], 1e-6, 'Batch ' + IntToStr(b) + ', C['+IntToStr(i)+','+IntToStr(j)+']');
      end;
    end;
  end;

  // 7. Cleanup
  hipStatus := hipFree(d_A_batch);  CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_ipiv);     CheckEquals(HIP_SUCCESS, hipStatus);
  hipStatus := hipFree(d_info);     CheckEquals(HIP_SUCCESS, hipStatus);

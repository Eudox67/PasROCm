procedure TTestRocSolver_Factorizations.Test_rocsolver_cpotrf;
const
  n = 10;
  lda = n;
var
  AStatus: rocsolver_status;
  AhipStatus: hipError_t;
  h_A, h_A_res, h_B: array of rocblas_float_complex;
  h_info: rocblas_int;
  d_A, d_info: hipDeviceptr_t;
  sizeA, sizeInfo: size_t;
  i, j, l: Integer;
  sum: rocblas_float_complex;
begin
  // 1. Setup
  sizeA := n * n * SizeOf(rocblas_float_complex);
  sizeInfo := SizeOf(rocblas_int);

  SetLength(h_A, n * n);
  SetLength(h_A_res, n * n);
  SetLength(h_B, n * n);
  h_info := -1;

  for j := 0 to n - 1 do
    for i := 0 to n - 1 do
    begin
      if i = j then h_B[i + j * lda].x := 2.0 else h_B[i + j * lda].x := 0.5;
      h_B[i + j * lda].y := 0.1; // Add imaginary part
    end;

  // Compute A = B' * B to create a Hermitian positive-definite matrix
  for j := 0 to n - 1 do
    for i := 0 to n - 1 do
    begin
      sum.x := 0;
      sum.y := 0;
      for l := 0 to n - 1 do
      begin
        // B_conj(l,i) * B(l,j)
        sum.x := sum.x + (h_B[l + i * lda].x * h_B[l + j * lda].x + h_B[l + i * lda].y * h_B[l + j * lda].y);
        sum.y := sum.y + (h_B[l + i * lda].x * h_B[l + j * lda].y - h_B[l + i * lda].y * h_B[l + j * lda].x);
      end;
      h_A[i + j * lda] := sum;
    end;

  d_A := nil;
  d_info := nil;
  AhipStatus := hipMalloc(d_A, sizeA);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_A');
  AhipStatus := hipMalloc(d_info, sizeInfo);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc d_info');

  try
    AhipStatus := hipMemcpy(d_A, @h_A[0], sizeA, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy H2D A');

    AStatus := rocsolver_cpotrf(FHandle, rocblas_fill_upper, n, d_A, lda, d_info);

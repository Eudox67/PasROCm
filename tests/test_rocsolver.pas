  hipStatus := hipMemcpy(@h_A_golden[0], d_A_batch, batch_size_bytes, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy back to h_A_golden failed');
  hipStatus := hipMemcpy(@h_info_golden[0], d_info, BATCH_COUNT * SizeOf(rocblas_int), hipMemcpyDeviceToHost);

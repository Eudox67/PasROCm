            AD, AE, AInfo);
        rgoSygvj:
          Result := rocsolver_zhegvj(FHandle, AForm, AEvect, AUplo, N, A, N, B, N,
            0.0, AResidual, AMaxSweeps, ANSweeps, AD, AInfo);
        else
          Result := rocsolver_zhegvdj(FHandle, AForm, AEvect, AUplo, N, A, N, B, N,
            AD, AInfo);
      end;
    else
      Result := rocblas_status_invalid_value;
  end;

procedure TTestRocSolver_OrthogonalGen.Test_rocsolver_sorglq;
const
  M = 4; // m <= n
  N = 5;
  K = 3; // k <= m
  LDA = M;
var
  AStatusSolver: rocsolver_status;
  AStatusBlas: rocblas_status;
  AStatusHip: hipError_t;
  h_A: array of Single;
  h_I_result: array of Single;
  d_A, d_tau, d_I: Pointer;
  ASizeA, ASizeTau, ASizeI: size_t;
  i, j: Integer;
  alpha, beta: Single;
begin
  // 1. Initialize
  ASizeA := LDA * N * SizeOf(Single);
  ASizeTau := K * SizeOf(Single);
  ASizeI := M * M * SizeOf(Single);
  SetLength(h_A, LDA * N);
  SetLength(h_I_result, M * M);
  for j := 0 to N - 1 do for i := 0 to M - 1 do h_A[i + j * LDA] := 1.0 + i + j * M;
  alpha := 1.0;
  beta := 0.0;

  // 2. Malloc
  d_A := nil; d_tau := nil; d_I := nil;
  hipMalloc(d_A, ASizeA); hipMalloc(d_tau, ASizeTau); hipMalloc(d_I, ASizeI);

  // 3. Generate reflectors using sgelqf (prerequisite)
  hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice);
  AStatusSolver := rocsolver_sgelqf(FHandle, M, N, d_A, LDA, d_tau);
  if AStatusSolver = rocblas_status_size_increased then
    AStatusSolver := rocsolver_sgelqf(FHandle, M, N, d_A, LDA, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'prerequisite sgelqf failed');
  if AStatusSolver <> rocblas_status_success then Exit;

  // 4. Call the function under test
  AStatusSolver := rocsolver_sorglq(FHandle, M, N, K, d_A, LDA, d_tau);
  if AStatusSolver = rocblas_status_size_increased then
      AStatusSolver := rocsolver_sorglq(FHandle, M, N, K, d_A, LDA, d_tau);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_sorglq failed');

  // 5. Verify Q*Q' = I using rocBLAS
  if AStatusSolver = rocblas_status_success then
  begin
    AStatusBlas := rocblas_sgemm(FHandle, rocblas_operation_none, rocblas_operation_transpose,
      M, M, N, @alpha, d_A, LDA, d_A, LDA, @beta, d_I, M);
    CheckEquals(rocblas_status_success, AStatusBlas, 'Verification sgemm failed');
    hipMemcpy(@h_I_result[0], d_I, ASizeI, hipMemcpyDeviceToHost);
    for j := 0 to M - 1 do for i := 0 to M - 1 do
      if i = j then CheckEquals(1.0, h_I_result[i + j * M], 1e-5)
      else CheckEquals(0.0, h_I_result[i + j * M], 1e-5);
  end;

  // 6. Cleanup
  if Assigned(d_A) then hipFree(d_A);
  if Assigned(d_tau) then hipFree(d_tau);
  if Assigned(d_I) then hipFree(d_I);
end;


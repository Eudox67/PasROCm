  h_E: array[0..N-2] of Double;
  h_info: rocblas_int;
  d_D, d_E, d_info: Pointer;
  ASizeD, ASizeE, ASizeInfo: size_t;
  i: Integer;
begin
  // 1. Initialize host data
  d_D := nil;
  d_E := nil;
  d_info := nil;
  ASizeD := N * SizeOf(Double);
  ASizeE := (N - 1) * SizeOf(Double);
  ASizeInfo := SizeOf(rocblas_int);

  for i := 0 to N - 1 do
  begin
    h_D[i] := i + 2.0;
    if i < N - 1 then
      h_E[i] := i + 1.0;
  end;

  try
    // 2. Allocate device memory and copy data
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_info, ASizeInfo);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    AStatusHip := hipMemcpy(d_D, @h_D[0], ASizeD, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_D failed');
    AStatusHip := hipMemcpy(d_E, @h_E[0], ASizeE, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_E failed');

    // 3. Call the rocsolver function
    AStatusSolver := rocsolver_dsterf(FHandle, N, d_D, d_E, d_info);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_dsterf failed');

    // 4. Verify results
    AStatusHip := hipMemcpy(@h_info, d_info, ASizeInfo, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    if AStatusSolver = rocblas_status_success then
      CheckEquals(0, h_info, 'rocsolver_dsterf indicated failure via info parameter');

  finally
    // 5. Cleanup
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;

procedure TTestRocSolver_EigenSVD.Test_rocsolver_ssteqr;
const
  N = 4;
  LDC = N;
  ADiag = 2.0;
  AOffDiag = 1.0;
  // Eigenvalues of the symmetric tridiagonal matrix with diagonal 2 and
  // off-diagonal 1:  2 + 2*cos(k*pi/(N+1)), k = 1..N, ascending.
  AExpected: array[0..N-1] of Single =
    (0.38196601, 1.38196601, 2.61803399, 3.61803399);
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_D: array[0..N-1] of Single;
  h_E: array[0..N-2] of Single;
  h_C: array[0..(N*LDC)-1] of Single;
  h_info: rocblas_int;
  d_D, d_E, d_C, d_info: Pointer;
  ASizeD, ASizeE, ASizeC, ASizeInfo: size_t;
  i, j: Integer;
  AResidual, ANorm, AComponent: Single;
begin
  d_D := nil;
  d_E := nil;
  d_C := nil;
  d_info := nil;
  ASizeD := N * SizeOf(Single);
  ASizeE := (N - 1) * SizeOf(Single);
  ASizeC := N * LDC * SizeOf(Single);
  ASizeInfo := SizeOf(rocblas_int);

  for i := 0 to N - 1 do
  begin
    h_D[i] := ADiag;
    if i < N - 1 then
      h_E[i] := AOffDiag;
  end;
  for i := 0 to (N * LDC) - 1 do
    h_C[i] := 0.0;
  // steqr's C is in-out: on entry it must hold the orthonormal matrix Q of the
  // reduction to tridiagonal form (Q = I when the input already is tridiagonal).
  for i := 0 to N - 1 do
    h_C[i * LDC + i] := 1.0;

  try
    AStatusHip := hipMalloc(d_D, ASizeD);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_D failed');
    AStatusHip := hipMalloc(d_E, ASizeE);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_E failed');
    AStatusHip := hipMalloc(d_C, ASizeC);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_C failed');
    AStatusHip := hipMalloc(d_info, ASizeInfo);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');

    AStatusHip := hipMemcpy(d_D, @h_D[0], ASizeD, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_D failed');
    AStatusHip := hipMemcpy(d_E, @h_E[0], ASizeE, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_E failed');
    AStatusHip := hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_C failed');

    // A value outside the rocblas_evect_* range must be rejected. This is the
    // exact failure mode of the old Pascal constants (1061/1062/1063): the
    // library saw an alien integer and returned invalid_value (11).
    AStatusSolver := rocsolver_ssteqr(FHandle, 999, N, d_D, d_E, d_C, LDC, d_info);
    CheckEquals(rocblas_status_invalid_value, AStatusSolver,
      'rocsolver_ssteqr must reject an evect value outside rocblas_evect_*');

    AStatusSolver := rocsolver_ssteqr(FHandle, rocblas_evect_original, N,
      d_D, d_E, d_C, LDC, d_info);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_ssteqr failed');

    AStatusHip := hipMemcpy(@h_info, d_info, ASizeInfo, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    CheckEquals(0, h_info, 'rocsolver_ssteqr reported a convergence failure');

    AStatusHip := hipMemcpy(@h_D[0], d_D, ASizeD, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_D failed');
    AStatusHip := hipMemcpy(@h_C[0], d_C, ASizeC, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_C failed');

    // 4. Verify eigenvalues (returned in ascending order).
    for i := 0 to N - 1 do
      CheckEquals(AExpected[i], h_D[i], 1.0e-4,
        'eigenvalue ' + IntToStr(i) + ' is incorrect');

    // 5. Verify that each column of C is a unit-norm eigenvector.
    for j := 0 to N - 1 do
    begin
      ANorm := 0.0;
      for i := 0 to N - 1 do
        ANorm := ANorm + Sqr(h_C[j * LDC + i]);
      CheckEquals(1.0, ANorm, 1.0e-4,
        'eigenvector ' + IntToStr(j) + ' is not normalized');

      for i := 0 to N - 1 do
      begin
        // (A*v)[i] for a symmetric tridiagonal matrix.
        AResidual := ADiag * h_C[j * LDC + i];
        if i > 0 then
          AResidual := AResidual + AOffDiag * h_C[j * LDC + i - 1];
        if i < N - 1 then
          AResidual := AResidual + AOffDiag * h_C[j * LDC + i + 1];
        AResidual := AResidual - h_D[j] * h_C[j * LDC + i];
        AComponent := AResidual * AResidual;
        CheckEquals(0.0, AComponent, 1.0e-6,
          'eigenvector ' + IntToStr(j) + ' residual at row ' + IntToStr(i));
      end;
    end;

  finally
    if Assigned(d_D) then hipFree(d_D);
    if Assigned(d_E) then hipFree(d_E);
    if Assigned(d_C) then hipFree(d_C);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


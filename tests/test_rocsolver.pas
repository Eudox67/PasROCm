  h_info, h_info_result, h_info_golden: rocblas_int;
  d_A, d_A_golden: hipDeviceptr_t;
  d_ipiv, d_ipiv_golden: hipDeviceptr_t;
  d_info, d_info_golden: hipDeviceptr_t;
  i, j: Integer;
  size_A, size_ipiv, size_info: size_t;
  uplo_values: array[0..1] of rocblas_fill;
  uplo: rocblas_fill;
begin
  size_A := lda * n * sizeof(rocblas_double_complex);
  size_ipiv := n * sizeof(rocblas_int);
  size_info := sizeof(rocblas_int);

  SetLength(h_A, lda * n);
  SetLength(h_A_result, lda * n);
  SetLength(h_A_golden, lda * n);
  SetLength(h_ipiv, n);
  SetLength(h_ipiv_result, n);
  SetLength(h_ipiv_golden, n);

  uplo_values[0] := rocblas_fill_upper;
  uplo_values[1] := rocblas_fill_lower;

  for uplo in uplo_values do
  begin
    // Initialize a complex symmetric, diagonally dominant matrix
    for j := 0 to n - 1 do
      for i := 0 to n - 1 do
      begin
        if i >= j then
        begin
          h_A[j * lda + i].x := i + j + 2;
          h_A[j * lda + i].y := i - j; // Non-Hermitian part
        end else
        begin
          h_A[j * lda + i].x := j + i + 2;
          h_A[j * lda + i].y := j - i; // Non-Hermitian part
        end;
      end;
    for i := 0 to n - 1 do
      h_A[i * lda + i].x := h_A[i * lda + i].x + n * 4; // Ensure diagonal dominance

    // --- Characterization Run: Generate the Golden Values ---
    d_A_golden := nil;
    d_ipiv_golden := nil;
    d_info_golden := nil;
    AhipStatus := hipMalloc(d_A_golden, size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for golden d_A failed');
    AhipStatus := hipMalloc(d_ipiv_golden, size_ipiv);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for golden d_ipiv failed');
    AhipStatus := hipMalloc(d_info_golden, size_info);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for golden d_info failed');
    AhipStatus := hipMemcpy(d_A_golden, @h_A[0], size_A, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to golden d_A failed');

    AStatus := rocsolver_zsytrf(FHandle, uplo, n, d_A_golden, lda, d_ipiv_golden, d_info_golden);
    CheckEquals(rocblas_status_success, AStatus, 'Golden value generation failed');

    AhipStatus := hipMemcpy(@h_A_golden[0], d_A_golden, size_A, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_A failed');
    AhipStatus := hipMemcpy(@h_ipiv_golden[0], d_ipiv_golden, size_ipiv, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_ipiv failed');
    AhipStatus := hipMemcpy(@h_info_golden, d_info_golden, size_info, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_info failed');

    AhipStatus := hipFree(d_A_golden);
    AhipStatus := hipFree(d_ipiv_golden);
    AhipStatus := hipFree(d_info_golden);
    // --- End of Golden Value Generation ---

    // --- Actual Test Run ---
    d_A := nil;
    d_ipiv := nil;
    d_info := nil;
    AhipStatus := hipMalloc(d_A, size_A);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A failed');
    AhipStatus := hipMalloc(d_ipiv, size_ipiv);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_ipiv failed');
    AhipStatus := hipMalloc(d_info, size_info);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_info failed');
    AhipStatus := hipMemcpy(d_A, @h_A[0], size_A, hipMemcpyHostToDevice);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A failed');

    // Execute
    AStatus := rocsolver_zsytrf(FHandle, uplo, n, d_A, lda, d_ipiv, d_info);
    CheckEquals(rocblas_status_success, AStatus, 'rocsolver_zsytrf failed');

    // Retrieve
    AhipStatus := hipMemcpy(@h_A_result[0], d_A, size_A, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_A failed');
    AhipStatus := hipMemcpy(@h_ipiv_result[0], d_ipiv, size_ipiv, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_ipiv failed');
    AhipStatus := hipMemcpy(@h_info_result, d_info, size_info, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_info failed');

    // Verify
    CheckEquals(h_info_golden, h_info_result, Format('Mismatch in info for uplo=%d', [uplo]));
    if h_info_golden = 0 then
    begin
      for i := 0 to (lda * n) - 1 do
      begin
        CheckEquals(h_A_golden[i].x, h_A_result[i].x, 1e-12, Format('Mismatch in A.x at index %d for uplo=%d', [i, uplo]));
        CheckEquals(h_A_golden[i].y, h_A_result[i].y, 1e-12, Format('Mismatch in A.y at index %d for uplo=%d', [i, uplo]));
      end;
      for i := 0 to n - 1 do
        CheckEquals(h_ipiv_golden[i], h_ipiv_result[i], Format('Mismatch in ipiv at index %d for uplo=%d', [i, uplo]));
    end;

    // Cleanup
    AhipStatus := hipFree(d_A);
    AhipStatus := hipFree(d_ipiv);
    AhipStatus := hipFree(d_info);
  end;
end;


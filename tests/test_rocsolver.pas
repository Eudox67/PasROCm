{ TRocSolverTest }

procedure TRocSolverTest.SetUp;
var
  AStatus: rocblas_status;
begin
  inherited SetUp;
  FHandle := nil;
  AStatus := rocblas_create_handle(FHandle);
  AssertEquals('rocblas_create_handle should succeed in SetUp', rocblas_status_success, AStatus);
  AssertNotNull('rocBLAS handle should not be nil after creation', FHandle);
end;

procedure TRocSolverTest.TearDown;
var
  AStatus: rocblas_status;
begin
  if Assigned(FHandle) then
  begin
    AStatus := rocblas_destroy_handle(FHandle);
    AssertEquals('rocblas_destroy_handle should succeed in TearDown', rocblas_status_success, AStatus);
  end;
  inherited TearDown;
end;

{ Shared element accessors for the eigenproblem test helpers }

function RoCElemSize(AKind: TRoCElemKind): Integer;
begin
  case AKind of
    rkSingle: Result := SizeOf(Single);
    rkDouble: Result := SizeOf(Double);
    rkComplexSingle: Result := 2 * SizeOf(Single);
    rkComplexDouble: Result := 2 * SizeOf(Double);
    else Result := 0;
  end;
end;

function RoCRealSize(AKind: TRoCElemKind): Integer;
begin
  if AKind in [rkDouble, rkComplexDouble] then
    Result := SizeOf(Double)
  else
    Result := SizeOf(Single);
end;

procedure RoCSetElem(AData: PByte; AIndex: Integer; AKind: TRoCElemKind;
  const ARe, AIm: Double);
var
  AOffset: PtrInt;
begin
  AOffset := PtrInt(AIndex) * RoCElemSize(AKind);
  case AKind of
    rkSingle:
      PSingle(AData + AOffset)^ := ARe;
    rkDouble:
      PDouble(AData + AOffset)^ := ARe;
    rkComplexSingle:
      begin
        PSingle(AData + AOffset)^ := ARe;
        PSingle(AData + AOffset + SizeOf(Single))^ := AIm;
      end;
    rkComplexDouble:
      begin
        PDouble(AData + AOffset)^ := ARe;
        PDouble(AData + AOffset + SizeOf(Double))^ := AIm;
      end;
  end;
end;

procedure RoCGetElem(AData: PByte; AIndex: Integer; AKind: TRoCElemKind;
  out ARe, AIm: Double);
var
  AOffset: PtrInt;
begin
  AOffset := PtrInt(AIndex) * RoCElemSize(AKind);
  AIm := 0.0;
  case AKind of
    rkSingle:
      ARe := PSingle(AData + AOffset)^;
    rkDouble:
      ARe := PDouble(AData + AOffset)^;
    rkComplexSingle:
      begin
        ARe := PSingle(AData + AOffset)^;
        AIm := PSingle(AData + AOffset + SizeOf(Single))^;
      end;
    rkComplexDouble:
      begin
        ARe := PDouble(AData + AOffset)^;
        AIm := PDouble(AData + AOffset + SizeOf(Double))^;
      end;
  end;
end;


{ Dimension of the dense matrices used by the eigensolver helpers. }
const
  RO_EIG_N = 4;

  { Scale factor applied to the second matrix of a batch: its eigenvalues must
    be exactly this many times those of the first matrix. }
  RO_BATCH_SCALE = 2.0;

function RoCGetReal(AData: PByte; AIndex: Integer; AKind: TRoCElemKind): Double;
begin
  if RoCRealSize(AKind) = SizeOf(Double) then
    Result := PDouble(AData + PtrInt(AIndex) * SizeOf(Double))^
  else
    Result := PSingle(AData + PtrInt(AIndex) * SizeOf(Single))^;
end;

{ Fills a dense, symmetric 4x4 matrix (both triangles) with a non-trivial
  pattern. Every entry is multiplied by AScale, which lets the same matrix be
  reused for batches whose eigenvalues are known to be scaled. }
procedure RoCFillSymMatrix(AData: PByte; AKind: TRoCElemKind; const AScale: Double);
const
  N = RO_EIG_N;
  AValues: array[0..N - 1, 0..N - 1] of Double =
    ((4.0, 1.0, 2.0, 0.5),
     (1.0, 3.0, -1.0, 2.0),
     (2.0, -1.0, 5.0, 1.0),
     (0.5, 2.0, 1.0, 6.0));
var
  I, J: Integer;
begin
  for J := 0 to N - 1 do
    for I := 0 to N - 1 do
      RoCSetElem(AData, J * N + I, AKind, AScale * AValues[I, J], 0.0);
end;

{ Fills a symmetric positive definite 4x4 matrix, used as the B matrix of the
  generalized eigenproblem helpers. The matrix is strictly diagonally dominant
  and therefore positive definite. }
procedure RoCFillSpdMatrix(AData: PByte; AKind: TRoCElemKind; const AScale: Double);
const
  N = RO_EIG_N;
  AValues: array[0..N - 1, 0..N - 1] of Double =
    ((6.0, 1.0, 0.0, 0.0),
     (1.0, 5.0, 1.0, 0.0),
     (0.0, 1.0, 4.0, 1.0),
     (0.0, 0.0, 1.0, 3.0));
var
  I, J: Integer;
begin
  for J := 0 to N - 1 do
    for I := 0 to N - 1 do
      RoCSetElem(AData, J * N + I, AKind, AScale * AValues[I, J], 0.0);
end;

{ Tolerances used when comparing eigen-decompositions. }
procedure RoCEigTol(AKind: TRoCElemKind;
  out ATolEig, ATolRes, ATolOrth: Double);
begin
  if AKind in [rkDouble, rkComplexDouble] then
  begin
    ATolEig := 1.0e-10;
    ATolRes := 1.0e-10;
    ATolOrth := 1.0e-12;
  end
  else
  begin
    ATolEig := 1.0e-4;
    ATolRes := 1.0e-4;
    ATolOrth := 1.0e-5;
  end;
end;


procedure TTestRocSolver_EigenSVD.CheckEigenVector(AKind: TRoCElemKind;
  const AOriginal, AV: PByte; const AVec, ALdz: Integer; const AEigen: Double;
  const ACase: string);
const
  N = RO_EIG_N;
var
  I, K: Integer;
  ATolEig, ATolRes, ATolOrth: Double;
  ANorm, AResRe, AResIm, ARe, AIm, AAik, ARe2, AIm2: Double;
begin
  RoCEigTol(AKind, ATolEig, ATolRes, ATolOrth);

  ANorm := 0.0;
  for I := 0 to N - 1 do
  begin
    RoCGetElem(AV, AVec * ALdz + I, AKind, ARe, AIm);
    ANorm := ANorm + Sqr(ARe) + Sqr(AIm);
  end;
  CheckEquals(1.0, ANorm, ATolOrth,
    ACase + ': eigenvector ' + IntToStr(AVec) + ' is not normalized');

  for I := 0 to N - 1 do
  begin
    AResRe := 0.0;
    AResIm := 0.0;
    for K := 0 to N - 1 do
    begin
      RoCGetElem(AOriginal, K * N + I, AKind, AAik, AIm2);
      RoCGetElem(AV, AVec * ALdz + K, AKind, ARe2, AIm2);
      AResRe := AResRe + AAik * ARe2;
      AResIm := AResIm + AAik * AIm2;
    end;
    RoCGetElem(AV, AVec * ALdz + I, AKind, ARe, AIm);
    AResRe := AResRe - AEigen * ARe;
    AResIm := AResIm - AEigen * AIm;
    CheckEquals(0.0, Sqr(AResRe) + Sqr(AResIm), ATolRes,
      ACase + ': residual of eigenvector ' + IntToStr(AVec)
      + ' at row ' + IntToStr(I));
  end;
end;


function TTestRocSolver_EigenSVD.CallSyevx(AKind: TRoCElemKind;
  AOp: TRoCSyevxOp; AEvect: rocblas_evect; AErange: rocblas_erange;

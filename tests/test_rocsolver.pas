procedure TTestRocSolver_BlockTridiagonal.Test_rocsolver_sgeblttrf_npvt;
const
  NB = 4;
  NBLOCKS = 3;
  LDA = NB;
  LDB = NB;
  LDC = NB;
var
  AStatusSolver: rocsolver_status;
  AStatusBlas: rocblas_status;
  AStatusHip: hipError_t;
  h_A, h_B, h_C: array of Single;
  h_info: rocblas_int;
  d_A, d_B, d_C, d_info, d_workspace: Pointer;
  ASizeA, ASizeB, ASizeC, ASizeInfo, AWorkspaceSize: size_t;
  i, j, b: Integer;
begin
  // 1. Initialize
  d_A := nil; d_B := nil; d_C := nil; d_info := nil; d_workspace := nil;
  ASizeA := (NBLOCKS - 1) * LDA * NB * SizeOf(Single);
  ASizeB := NBLOCKS * LDB * NB * SizeOf(Single);
  ASizeC := (NBLOCKS - 1) * LDC * NB * SizeOf(Single);
  ASizeInfo := SizeOf(rocblas_int);
  SetLength(h_A, (NBLOCKS - 1) * LDA * NB);
  SetLength(h_B, NBLOCKS * LDB * NB);
  SetLength(h_C, (NBLOCKS - 1) * LDC * NB);

  for b := 0 to NBLOCKS - 2 do
    for j := 0 to NB - 1 do
      for i := 0 to NB - 1 do
      begin
        h_A[b*LDA*NB + i + j*LDA] := 1.0;
        h_C[b*LDC*NB + i + j*LDC] := 1.0;
      end;
  for b := 0 to NBLOCKS - 1 do
    for j := 0 to NB - 1 do
      for i := 0 to NB - 1 do
        if i = j then
          h_B[b*LDB*NB + i + j*LDB] := 4.0 * NB
        else
          h_B[b*LDB*NB + i + j*LDB] := 1.0;

  try
    // 2. Query for workspace size
    AStatusBlas := rocblas_start_device_memory_size_query(FHandle);
    CheckEquals(rocblas_status_success, AStatusBlas, 'rocblas_start_device_memory_size_query failed');
    AStatusSolver := rocsolver_sgeblttrf_npvt(FHandle, NB, NBLOCKS, nil, LDA, nil, LDB, nil, LDC, nil);
    Check((AStatusSolver = rocblas_status_success) or (AStatusSolver = rocblas_status_size_increased),
          'rocsolver_sgeblttrf_npvt for workspace query failed with unexpected status ' + IntToStr(AStatusSolver));
    AStatusBlas := rocblas_stop_device_memory_size_query(FHandle, AWorkspaceSize);
    CheckEquals(rocblas_status_success, AStatusBlas, 'rocblas_stop_device_memory_size_query failed');

    // 3. Allocate all device memory
    AStatusHip := hipMalloc(d_A, ASizeA); CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_A failed');
    AStatusHip := hipMalloc(d_B, ASizeB); CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_B failed');
    AStatusHip := hipMalloc(d_C, ASizeC); CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_C failed');
    AStatusHip := hipMalloc(d_info, ASizeInfo); CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_info failed');
    if AWorkspaceSize > 0 then
    begin
      AStatusHip := hipMalloc(d_workspace, AWorkspaceSize); CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc d_workspace failed');
      AStatusBlas := rocblas_set_workspace(FHandle, d_workspace, AWorkspaceSize); CheckEquals(rocblas_status_success, AStatusBlas, 'rocblas_set_workspace failed');
    end;

    // 4. Copy inputs to device
    AStatusHip := hipMemcpy(d_A, @h_A[0], ASizeA, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_B, @h_B[0], ASizeB, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);
    AStatusHip := hipMemcpy(d_C, @h_C[0], ASizeC, hipMemcpyHostToDevice); CheckEquals(HIP_SUCCESS, AStatusHip);

    // 5. Call rocsolver function for execution
    AStatusSolver := rocsolver_sgeblttrf_npvt(FHandle, NB, NBLOCKS, d_A, LDA, d_B, LDB, d_C, LDC, d_info);
    CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_sgeblttrf_npvt failed');

    // 6. Verify results
    AStatusHip := hipMemcpy(@h_info, d_info, ASizeInfo, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_info failed');
    if AStatusSolver = rocblas_status_success then
      CheckEquals(0, h_info, 'rocsolver_sgeblttrf_npvt indicated failure via info parameter');

  finally
    // 7. Cleanup
    if Assigned(d_workspace) then
    begin
      rocblas_set_workspace(FHandle, nil, 0);
      hipFree(d_workspace);
    end;
    if Assigned(d_A) then hipFree(d_A);
    if Assigned(d_B) then hipFree(d_B);
    if Assigned(d_C) then hipFree(d_C);
    if Assigned(d_info) then hipFree(d_info);
  end;
end;


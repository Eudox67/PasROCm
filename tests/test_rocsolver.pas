procedure TTestRocSolver_Inversion.Test_rocsolver_spotri;
const
  N = 3;
  LDA = N;
var
  h_A_initial: array[0..N-1, 0..N-1] of Single;
  h_A_golden, h_A_result: array[0..N-1, 0..N-1] of Single;
  h_info_golden, h_info_result: rocblas_int;
  d_A, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  uplo: rocblas_fill;
begin
  uplo := rocblas_fill_upper;

  // 1. Initialize host data
  h_A_initial[0,0] := 4.0; h_A_initial[0,1] := 1.0; h_A_initial[0,2] := 1.0;
  h_A_initial[1,0] := 1.0; h_A_initial[1,1] := 5.0; h_A_initial[1,2] := 2.0;
  h_A_initial[2,0] := 1.0; h_A_initial[2,1] := 2.0; h_A_initial[2,2] := 6.0;
  h_info_golden := -1; // Sentinel value
  h_info_result := -1; // Sentinel value

  // 2. Allocate device memory
  hipStatus := hipMalloc(d_A, N * LDA * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // --- Golden Run: Characterize the library's output ---
  hipStatus := hipMemcpy(d_A, @h_A_initial[0,0], N * LDA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy h_A_initial to d_A failed');
  AStatus := rocsolver_spotrf(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Golden Run: rocsolver_spotrf failed');
  AStatus := rocsolver_spotri(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Golden Run: rocsolver_spotri failed');
  hipStatus := hipMemcpy(@h_A_golden[0,0], d_A, N * LDA * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy d_A to h_A_golden failed');
  hipStatus := hipMemcpy(@h_info_golden, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Golden Run: hipMemcpy d_info to h_info_golden failed');

  // --- Test Run: Execute the same call again ---
  hipStatus := hipMemcpy(d_A, @h_A_initial[0,0], N * LDA * SizeOf(Single), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy h_A_initial to d_A failed');
  AStatus := rocsolver_spotrf(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Test Run: rocsolver_spotrf failed');
  AStatus := rocsolver_spotri(FHandle, uplo, N, d_A, LDA, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'Test Run: rocsolver_spotri failed');
  hipStatus := hipMemcpy(@h_A_result[0,0], d_A, N * LDA * SizeOf(Single), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy d_A to h_A_result failed');
  hipStatus := hipMemcpy(@h_info_result, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy d_info to h_info_result failed');

  // 3. Verification: Compare golden run to test run
  CheckEquals(h_info_golden, h_info_result, 'Info value mismatch between runs');
  Check(CompareMem(@h_A_golden, @h_A_result, N * LDA * SizeOf(Single)), 'Matrix data mismatch between runs');

  // 4. Cleanup
  hipStatus := hipFree(d_A);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_A failed');
  hipStatus := hipFree(d_info);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_info failed');
end;


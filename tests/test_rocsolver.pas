        temp.y := temp.y + (h_A_orig[i + k * LDA].x * h_X[k + j * LDB].y + h_A_orig[i + k * LDA].y * h_X[k + j * LDB].x);
      end;
      residual := residual + Sqr(temp.x - h_B[i + j * LDB].x) + Sqr(temp.y - h_B[i + j * LDB].y);
    end;
  end;
  residual := Sqrt(residual);

  if ((normA > 0) and (normX > 0)) then
    error := residual / (normA * normX)
  else
    error := residual;

  CheckEquals(0.0, error, 1e-6, 'Solution residual is too high.');


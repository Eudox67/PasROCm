  hipStatus := hipMemcpy(@h_info_result, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'Test Run: hipMemcpy back to h_info_result failed');

  // 3. Verification
  CheckEquals(h_info_golden, h_info_result, 'Info value mismatch');
  Check(CompareMem(@h_A_golden, @h_A_result, N * LDA * SizeOf(Single)), 'Matrix data mismatch');

  // 4. Cleanup
  hipStatus := hipFree(d_A);    CheckEquals(HIP_SUCCESS, hipStatus);

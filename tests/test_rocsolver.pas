procedure TTestRocSolver_Factorizations.Test_rocsolver_sgeqrf_strided_batched;
const
  m = 50;
  n = 16;
  lda = 50;
  batch_count = 1; // Simplified to 1 for stable characterization
var
  AStatus: rocblas_status;
  AhipStatus: hipError_t;
  h_A, h_A_result, h_A_golden: array of Single;
  h_tau, h_tau_result, h_tau_golden: array of Single;
  d_A, d_tau: hipDeviceptr_t;
  i, j: Integer;
  strideA, strideP: rocblas_stride;
  size_A, size_tau: size_t;
begin
  // Setup
  strideA := lda * n;
  strideP := min(m, n);
  size_A := strideA * sizeof(Single);
  size_tau := strideP * sizeof(Single);

  SetLength(h_A, strideA);
  SetLength(h_A_result, strideA);
  SetLength(h_A_golden, strideA);
  SetLength(h_tau, strideP);
  SetLength(h_tau_result, strideP);
  SetLength(h_tau_golden, strideP);

  // Initialize input matrix
  for j := 0 to n - 1 do
    for i := 0 to m - 1 do
      h_A[j * lda + i] := i + j * m;

  // --- Characterization Run: Generate the Golden Values ---
  d_A := nil;
  d_tau := nil;
  AhipStatus := hipMalloc(d_A, size_A);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for golden d_A failed');
  AhipStatus := hipMalloc(d_tau, size_tau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for golden d_tau failed');
  AhipStatus := hipMemcpy(d_A, @h_A[0], size_A, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to golden d_A failed');

  AStatus := rocsolver_sgeqrf_strided_batched(FHandle, m, n, d_A, lda, strideA, d_tau, strideP, batch_count);
  CheckEquals(rocblas_status_success, AStatus, 'Golden value generation failed');

  AhipStatus := hipMemcpy(@h_A_golden[0], d_A, size_A, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_A failed');
  AhipStatus := hipMemcpy(@h_tau_golden[0], d_tau, size_tau, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from golden d_tau failed');

  AhipStatus := hipFree(d_A);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipFree for golden d_A failed');
  AhipStatus := hipFree(d_tau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipFree for golden d_tau failed');
  // --- End of Golden Value Generation ---

  // --- Actual Test Run ---
  AhipStatus := hipMalloc(d_A, size_A);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_A failed');
  AhipStatus := hipMalloc(d_tau, size_tau);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMalloc for d_tau failed');
  AhipStatus := hipMemcpy(d_A, @h_A[0], size_A, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy to d_A failed');

  // Execute
  AStatus := rocsolver_sgeqrf_strided_batched(FHandle, m, n, d_A, lda, strideA, d_tau, strideP, batch_count);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_sgeqrf_strided_batched failed');

  // Retrieve
  AhipStatus := hipMemcpy(@h_A_result[0], d_A, size_A, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_A failed');
  AhipStatus := hipMemcpy(@h_tau_result[0], d_tau, size_tau, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy from d_tau failed');

  // Verify
  for j := 0 to n - 1 do
    for i := 0 to m - 1 do

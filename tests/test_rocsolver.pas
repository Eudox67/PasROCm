    AhipStatus := hipMemcpy(@h_tau_res[0], d_tau, size_tau_data_bytes, hipMemcpyDeviceToHost);
    CheckEquals(HIP_SUCCESS, AhipStatus, 'hipMemcpy D2H tau');

    for b := 0 to batch_count - 1 do
    begin
      Check(h_tau_res[b * strideP] <> 0, 'tau[' + IntToStr(b) + ',0] should be non-zero');
    end;

  finally
    if d_A_data <> nil then hipFree(d_A_data);
    if d_A_ptrs <> nil then hipFree(d_A_ptrs);
    if d_tau <> nil then hipFree(d_tau);
  end;
end;


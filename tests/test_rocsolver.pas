procedure TTestRocSolver_OrthogonalApp.Test_rocsolver_sormqr;
const
  m = 5;
  n = 4;
  k = 3;
  lda = m;
  ldc = m;
var
  h_A: PSingle;
  h_C: PSingle;
  h_tau: PSingle;
  d_A: hipDeviceptr_t;
  d_C: hipDeviceptr_t;
  d_tau: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i: Integer;
begin
  // Allocate host memory
  h_A := AllocMem(lda * k * SizeOf(Single));
  h_C := AllocMem(ldc * n * SizeOf(Single));
  h_tau := AllocMem(k * SizeOf(Single));

  // Initialize host data (example values)
  for i := 0 to (lda * k) - 1 do
    h_A[i] := i + 1;
  for i := 0 to (ldc * n) - 1 do
    h_C[i] := i + 1;

  // Allocate device memory
  hipStatus := hipMalloc(d_A, lda * k * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_A failed');
  hipStatus := hipMalloc(d_C, ldc * n * SizeOf(Single));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc for d_C failed');

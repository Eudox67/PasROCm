procedure TTestRocSolver_Auxiliary.Test_rocsolver_clacgv;
const
  N = 5;
  incx = 1;
var
  AStatusSolver: rocsolver_status;
  AStatusHip: hipError_t;
  h_x: array[0..N - 1] of rocblas_float_complex;
  h_x_gold: array[0..N - 1] of rocblas_float_complex;
  h_result: array[0..N - 1] of rocblas_float_complex;
  d_x: Pointer;
  ASize: size_t;
  i: Integer;
begin
  // 1. Initialize host data
  ASize := N * SizeOf(rocblas_float_complex);
  for i := 0 to N - 1 do
  begin
    h_x[i].x := 1.0 + i;
    h_x[i].y := -2.0 - i;
    h_x_gold[i].x := 1.0 + i;
    h_x_gold[i].y := 2.0 + i; // Conjugated imaginary part
  end;

  // 2. Allocate device memory
  d_x := nil;
  AStatusHip := hipMalloc(d_x, ASize);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMalloc for d_x failed');
  if AStatusHip <> HIP_SUCCESS then Exit;

  // 3. Copy data from host to device
  AStatusHip := hipMemcpy(d_x, @h_x[0], ASize, hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy to d_x failed');

  // 4. Call rocsolver function
  AStatusSolver := rocsolver_clacgv(FHandle, N, d_x, incx);
  CheckEquals(rocblas_status_success, AStatusSolver, 'rocsolver_clacgv failed');

  // 5. Copy result from device to host
  AStatusHip := hipMemcpy(@h_result[0], d_x, ASize, hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, AStatusHip, 'hipMemcpy from d_x failed');

  // 6. Verify results
  if AStatusSolver = rocblas_status_success then
  begin
    for i := 0 to N - 1 do
    begin
      CheckEquals(h_x_gold[i].x, h_result[i].x, 1e-6, 'Real part mismatch at index ' + IntToStr(i));
      CheckEquals(h_x_gold[i].y, h_result[i].y, 1e-6, 'Imaginary part mismatch at index ' + IntToStr(i));
    end;
  end;

  // 7. Cleanup
  if Assigned(d_x) then
  begin
    AStatusHip := hipFree(d_x);
    CheckEquals(HIP_SUCCESS, AStatusHip, 'hipFree for d_x failed');
  end;
end;


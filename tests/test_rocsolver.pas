    // Initialize input matrices
    for k := 0 to batch_count - 1 do
    begin
      for j := 0 to n - 1 do
        for i := 0 to n - 1 do
        begin
          if i >= j then
            h_A[k * strideA + j * lda + i] := i + j + 2 + (k*100)
          else
            h_A[k * strideA + j * lda + i] := j + i + 2 + (k*100);
        end;
      for i := 0 to n - 1 do
        h_A[k * strideA + i * lda + i] := h_A[k * strideA + i * lda + i] + n * 2;

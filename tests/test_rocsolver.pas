procedure TTestRocSolver_Inversion.Test_rocsolver_cgetri;
const
  N = 2;
  LDA = N;
var
  h_A, h_A_orig, h_C: array[0..N-1, 0..N-1] of rocblas_float_complex;
  h_ipiv: array[0..N-1] of rocblas_int;
  h_info: rocblas_int;
  d_A, d_ipiv, d_info: hipDeviceptr_t;
  AStatus: rocsolver_status;
  hipStatus: hipError_t;
  i, j, k: Integer;
  sum: rocblas_float_complex;
  temp: rocblas_float_complex;
begin
  // 1. Initialize test data on the host (Corrected initialization)
  h_A[0,0].x := 2.0; h_A[0,0].y := 0.0;
  h_A[0,1].x := 1.0; h_A[0,1].y := 1.0;
  h_A[1,0].x := 1.0; h_A[1,0].y := -1.0;
  h_A[1,1].x := 3.0; h_A[1,1].y := 0.0;
  h_A_orig := h_A; // Keep a copy for verification
  h_info := 0;

  // 2. Allocate memory on the device
  hipStatus := hipMalloc(d_A, N * LDA * SizeOf(rocblas_float_complex));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_A failed');
  hipStatus := hipMalloc(d_ipiv, N * SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_ipiv failed');
  hipStatus := hipMalloc(d_info, SizeOf(rocblas_int));
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMalloc d_info failed');

  // 3. Copy data from host to device
  hipStatus := hipMemcpy(d_A, @h_A[0,0], N * LDA * SizeOf(rocblas_float_complex), hipMemcpyHostToDevice);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy h_A to d_A failed');

  // 4. Perform LU factorization
  AStatus := rocsolver_cgetrf(FHandle, N, N, d_A, LDA, d_ipiv, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_cgetrf failed');

  // 5. Call the target function to compute the inverse
  AStatus := rocsolver_cgetri(FHandle, N, d_A, LDA, d_ipiv, d_info);
  CheckEquals(rocblas_status_success, AStatus, 'rocsolver_cgetri failed');

  // 6. Verify results
  hipStatus := hipMemcpy(@h_A[0,0], d_A, N * LDA * SizeOf(rocblas_float_complex), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_A to h_A failed');
  hipStatus := hipMemcpy(@h_info, d_info, SizeOf(rocblas_int), hipMemcpyDeviceToHost);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipMemcpy d_info to h_info failed');

  CheckEquals(0, h_info, 'cgetri info should be 0 on success');

  // Verification: C = A_orig * A_inv
  for i := 0 to N-1 do
  begin
    for j := 0 to N-1 do
    begin
      sum.x := 0.0; // Corrected initialization
      sum.y := 0.0; // Corrected initialization
      for k := 0 to N-1 do
      begin
        temp.x := h_A_orig[i,k].x * h_A[k,j].x - h_A_orig[i,k].y * h_A[k,j].y;
        temp.y := h_A_orig[i,k].x * h_A[k,j].y + h_A_orig[i,k].y * h_A[k,j].x;
        sum.x := sum.x + temp.x;
        sum.y := sum.y + temp.y;
      end;
      h_C[i,j] := sum;
    end;
  end;

  for i := 0 to N-1 do
  begin
    for j := 0 to N-1 do
    begin
      if i = j then
      begin
        CheckEquals(1.0, h_C[i,j].x, 1e-6, 'Identity matrix real part C['+IntToStr(i)+','+IntToStr(j)+']');
        CheckEquals(0.0, h_C[i,j].y, 1e-6, 'Identity matrix imag part C['+IntToStr(i)+','+IntToStr(j)+']');
      end
      else
      begin
        CheckEquals(0.0, h_C[i,j].x, 1e-6, 'Identity matrix real part C['+IntToStr(i)+','+IntToStr(j)+']');
        CheckEquals(0.0, h_C[i,j].y, 1e-6, 'Identity matrix imag part C['+IntToStr(i)+','+IntToStr(j)+']');
      end;
    end;
  end;

  // 7. Cleanup
  hipStatus := hipFree(d_A);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_A failed');
  hipStatus := hipFree(d_ipiv);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_ipiv failed');
  hipStatus := hipFree(d_info);
  CheckEquals(HIP_SUCCESS, hipStatus, 'hipFree d_info failed');
end;


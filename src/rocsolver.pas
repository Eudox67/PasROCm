unit rocsolver;

{$mode objfpc}{$H+}
{$linklib rocsolver}

interface

uses
  hip_runtime, hip_types, rocblas;

// rocsolver uses the same handle and status types as rocblas
type
  rocsolver_handle = rocblas_handle;
  rocsolver_status = rocblas_status;
  
  rocsolver_rfinfo = Pointer;
  rocsolver_rfinfo_mode = Int32;
  
const
  { Values from rocsolver-extra-types.h (rocsolver_rfinfo_mode_). }
  rocsolver_rfinfo_mode_lu   : rocsolver_rfinfo_mode = 271; // LU factorization
  rocsolver_rfinfo_mode_chol : rocsolver_rfinfo_mode = 272; // Cholesky factorization

{ ---------- Build information ---------- }
function rocsolver_get_version_string(buf: PChar; const len: size_t): rocsolver_status; cdecl; external;
function rocsolver_get_version_string_size(len: PSize_t): rocsolver_status; cdecl; external;

{ ---------- Logging ---------- }
function rocsolver_log_begin: rocsolver_status; cdecl; external;
function rocsolver_log_end: rocsolver_status; cdecl; external;
function rocsolver_log_set_layer_mode(const layer_mode: rocblas_layer_mode_flags): rocsolver_status; cdecl; external;
function rocsolver_log_set_max_levels(const max_levels: rocblas_int): rocsolver_status; cdecl; external;
function rocsolver_log_restore_defaults: rocsolver_status; cdecl; external;

